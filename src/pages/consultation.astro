---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import LineCta from '../components/LineCta.astro';
import ShareButtons from '../components/ShareButtons.astro';

import FooterSites from '../components/FooterSites.astro';
import { FAQS, faqSchema } from '../lib/faq';
/* ---------------------------------------------------------------
   キャリア相談フォーム（自作・4ステップ）
   ---------------------------------------------------------------
   以前は Airtable のフォームを iframe で埋めていたが、
   ・送信が iframe の中で完結するので離脱も送信も測れない
   ・高さ固定でモバイルの体験が重い
   という理由で、求人サイト（jobs.agent-best.net/apply.html）と同じ型の
   自作フォームに置き換えた。

     フォーム → Supabase public.consultations に INSERT（匿名キー・INSERTのみ許可）
            → Database Webhook → Apps Script → Gmail通知＋Airtable「求職者（HP）」に登録

   受け皿の作り方（SQL・Webhook・Apps Script）は CONSULT_FORM_SETUP.md にある。
   ⚠ 送信に失敗したときは、Airtable のフォームへのリンクを出して取りこぼさないようにしている。
--------------------------------------------------------------- */
const SUPABASE_URL = 'https://jvdnabtpxcyfnogdulea.supabase.co';
const SUPABASE_ANON_KEY = 'sb_publishable_kVUJIz-lImX0AD5eALVVaA_YiDqi7GQ';
const CONSULT_TABLE = 'consultations';

/* 送信に失敗したときの逃げ道（Airtableの相談フォーム） */
const FORM_DIRECT_URL = 'https://airtable.com/appYkc36EvioYoL1A/pagFw3nywLJ4AJF3n/form';

const CALENDLY_URL = 'https://calendly.com/r_matsuoka';

// よくある質問。文面は src/lib/faq.ts が原本（トップと共有）
const faqStructuredData = faqSchema('https://www.agent-best.net/consultation/');

const stages = [
  {
    title: '転職するか、まだ決めていない',
    body: '「動くべきか」を決めるところからご一緒します。結論として現職に残る、という判断も歓迎です。',
  },
  {
    title: '興味はあるが、求人を見ていない',
    body: 'ご経歴と志向をうかがったうえで、市場の相場観と具体的な選択肢をお渡しします。',
  },
  {
    title: '自分の市場価値を知りたいだけ',
    body: '同じ経歴の方がどの水準で決まっているか、実際の決定事例ベースでお伝えします。',
  },
];

const steps = [
  { no: '01', title: 'フォーム送信', body: '4ステップ・3分ほどで送信できます。履歴書はお手元になくて構いません。' },
  { no: '02', title: '担当より連絡', body: '原則2営業日以内に、ご記入のメールまたはお電話でご連絡します。' },
  { no: '03', title: '面談（30〜60分）', body: 'オンラインで。現職中の方が大半です。夜間・土日も調整可能です。' },
];
---

<Layout
  title="キャリア相談｜株式会社エージェントベスト"
  description="求人が決まっていない段階でのご相談を受け付けています。転職するか迷っている、市場価値を知りたい、情報収集から始めたい——20代・30代のハイクラス層向けに、領域のプロがキャリアの選択肢を整理します。"
  image="/ogp/consultation.png"
>
  <Header />

  <main>
    <!-- ============ HERO ============ -->
    <section class="lead-sec">
      <div class="wrap lead-grid">
        <div>
          <span class="eyebrow">Career Consultation</span>
          <h1 class="lead-title">まだ何も<br />決まっていなくて、いい。</h1>
          <p class="lead-body">
            応募したい求人が決まっている必要はありません。<br />
            「転職するかどうか」から迷っている段階のご相談を、いちばん歓迎しています。<br />
            扱う領域を絞っているぶん、一般論ではなく、あなたの経歴に対する具体的な話ができます。
          </p>
          <a href="#form" class="btn lead-cta">
            相談フォームへ <span class="arrow" aria-hidden="true">↓</span>
          </a>
        </div>
        <aside class="lead-note">
          <p class="lead-note-title">ご相談は無料です</p>
          <p>
            費用はいただきません。無理に求人をお勧めすることも、
            ご本人の同意なく経歴を企業へ共有することもありません。
          </p>
        </aside>
      </div>
    </section>

    <!-- ============ こんな段階でも ============ -->
    <section class="section stages spine">
      <div class="wrap">
        <header class="sec-head">
          <span class="eyebrow">Who</span>
          <h2>こんな段階のご相談を、よくいただきます</h2>
        </header>
        <ul class="stage-list">
          {stages.map((s) => (
            <li class="stage-card">
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ============ 流れ ============ -->
    <section class="section flow">
      <div class="wrap">
        <header class="sec-head">
          <span class="eyebrow">Flow</span>
          <h2>ご相談の流れ</h2>
        </header>
        <ol class="step-list">
          {steps.map((s) => (
            <li class="step">
              <span class="step-no">{s.no}</span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ============ フォーム ============ -->
    <section id="form" class="form-sec">
      <div class="wrap">
        <header class="sec-head form-head">
          <span class="eyebrow">Contact</span>
          <h2>相談フォーム</h2>
          <p class="form-lead">
            分かる範囲でご記入ください。空欄のままでも、面談のなかで一緒に整理していきます。
          </p>
        </header>

        <div class="form-frame">
          <form id="consultForm" novalidate>
            <ol class="fsteps" aria-hidden="true">
              <li class="fstep is-on" data-step="1"><span>1</span>連絡先</li>
              <li class="fstep" data-step="2"><span>2</span>いまの状況</li>
              <li class="fstep" data-step="3"><span>3</span>ご希望</li>
              <li class="fstep" data-step="4"><span>4</span>ご相談内容</li>
            </ol>

            <!-- ステップ1：連絡先 -->
            <fieldset class="fpane" data-pane="1">
              <legend class="fpane-title">ご連絡先</legend>
              <div class="frow">
                <label class="flabel" for="cf-name">お名前 <span class="freq">必須</span></label>
                <input class="finput" id="cf-name" name="name" type="text" autocomplete="name" required />
              </div>
              <div class="frow">
                <label class="flabel" for="cf-kana">フリガナ</label>
                <input class="finput" id="cf-kana" name="kana" type="text" placeholder="ヤマダ タロウ" />
              </div>
              <div class="frow">
                <label class="flabel" for="cf-email">メールアドレス <span class="freq">必須</span></label>
                <input class="finput" id="cf-email" name="email" type="email" autocomplete="email" inputmode="email" required />
              </div>
              <div class="frow">
                <label class="flabel" for="cf-phone">電話番号 <span class="freq">必須</span></label>
                <input class="finput" id="cf-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="09012345678" required />
                <p class="fhelp">日中つながる番号をご記入ください。留守番電話にメッセージを残す形でも構いません。</p>
              </div>
            </fieldset>

            <!-- ステップ2：いまの状況 -->
            <fieldset class="fpane" data-pane="2" hidden>
              <legend class="fpane-title">いまの状況</legend>
              <div class="frow">
                <label class="flabel" for="cf-status">現在の状況</label>
                <select class="finput" id="cf-status" name="status">
                  <option value="">選択してください</option>
                  <option>在職中</option>
                  <option>離職中</option>
                  <option>学生</option>
                </select>
              </div>
              <div class="frow">
                <label class="flabel" for="cf-company">現在の所属（企業・部署）</label>
                <input class="finput" id="cf-company" name="company" type="text" placeholder="株式会社◯◯／◯◯部" />
              </div>
              <div class="frow">
                <label class="flabel" for="cf-timing">転職の温度感 <span class="freq">必須</span></label>
                <select class="finput" id="cf-timing" name="timing" required>
                  <option value="">選択してください</option>
                  <option>すぐにでも転職したい（1ヶ月以内）</option>
                  <option>3ヶ月以内には決めたい</option>
                  <option>半年以内をめどに検討中</option>
                  <option>1年以内に良い求人があれば</option>
                  <option>時期は未定（良い求人があれば）</option>
                  <option>まずは情報収集・相談から</option>
                </select>
                <p class="fhelp">「まずは情報収集から」で構いません。急かすご連絡はしません。</p>
              </div>
            </fieldset>

            <!-- ステップ3：ご希望 -->
            <fieldset class="fpane" data-pane="3" hidden>
              <legend class="fpane-title">ご希望</legend>
              <div class="frow">
                <label class="flabel" for="cf-salary">希望年収（万円）</label>
                <input class="finput finput--short" id="cf-salary" name="salary" type="text" inputmode="numeric" placeholder="800" />
                <p class="fhelp">現在の年収ではなく、ご希望の年収を万円単位で。決まっていなければ空欄で構いません。</p>
              </div>
              <div class="frow">
                <label class="flabel" for="cf-wish">希望職種・勤務地</label>
                <textarea class="finput" id="cf-wish" name="wish" rows="3" placeholder="職種・エリア・働き方（リモート希望など）"></textarea>
              </div>
              <div class="frow">
                <label class="flabel" for="cf-applied">すでに応募・選考中の企業</label>
                <textarea class="finput" id="cf-applied" name="applied" rows="2"></textarea>
                <p class="fhelp">他社エージェント経由・直接応募を含め、分かる範囲で。同じ企業へ二重に推薦されるのを防ぐために使います。</p>
              </div>
            </fieldset>

            <!-- ステップ4：ご相談内容と同意 -->
            <fieldset class="fpane" data-pane="4" hidden>
              <legend class="fpane-title">ご相談内容</legend>
              <div class="frow">
                <label class="flabel" for="cf-message">ご希望・ご質問</label>
                <textarea class="finput" id="cf-message" name="message" rows="5" placeholder="いま迷っていること、聞いてみたいことを自由にご記入ください。"></textarea>
              </div>
              <div class="frow">
                <span class="flabel">求人案内・スカウトの受信 <span class="freq">必須</span></span>
                <label class="fradio"><input type="radio" name="scout" value="希望する" required /><span>希望する</span></label>
                <label class="fradio"><input type="radio" name="scout" value="希望しない（このご相談に関する連絡のみ）" /><span>希望しない（このご相談に関する連絡のみ）</span></label>
              </div>
              <div class="frow">
                <label class="fcheck">
                  <input type="checkbox" id="cf-consent" name="consent" required />
                  <span><a href="https://jobs.agent-best.net/privacy.html" target="_blank" rel="noopener">個人情報の取り扱い</a>に同意します <span class="freq">必須</span></span>
                </label>
                <p class="fhelp">ご記入いただいた情報を、ご本人の同意なく企業へ共有することはありません。</p>
              </div>
            </fieldset>

            <!-- 自動入力するbot対策（人には見えない） -->
            <div class="fhoney" aria-hidden="true">
              <label for="cf-site">サイト</label>
              <input id="cf-site" name="site" type="text" tabindex="-1" autocomplete="off" />
            </div>

            <p class="fmsg" id="cf-msg" hidden></p>

            <div class="factions">
              <button type="button" class="btn btn--ghost fback" id="cf-back" hidden>戻る</button>
              <button type="button" class="btn fnext" id="cf-next">次へ <span class="arrow" aria-hidden="true">→</span></button>
            </div>
            <p class="fnote" id="cf-note">入力は3分ほどで終わります。途中の内容はこの端末に一時保存されます。</p>
          </form>
        </div>

        <div class="alt-cta">
          <p class="alt-cta-title">先に話してしまいたい方へ</p>
          <p class="alt-cta-body">
            フォームの記入より、まず話したい——という場合は、日程を直接お選びいただけます。
          </p>
          <a href={CALENDLY_URL} target="_blank" rel="noopener" class="btn btn--ghost" data-consult-cta="calendly">
            面談の日程を調整する <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>

        <div class="alt-cta">
          <p class="alt-cta-title">まずは軽く聞いてみたい方へ</p>
          <p class="alt-cta-body">
            フォームも面談もまだ早い、という段階なら、LINEでの質問だけでも構いません。
            トークでそのままやり取りできます。
          </p>
          <LineCta placement="consultation-alt" variant="button" label="LINEで相談する" />
        </div>

        <p class="alt-note">
          応募したい求人がすでにお決まりの方は、<a href="https://jobs.agent-best.net/" target="_blank" rel="noopener">求人検索</a>から各求人ページの応募フォームをご利用ください。<br />
          採用・サービスに関する企業の方は<a href="/contact/">お問い合わせフォーム</a>から承ります。
        </p>
      </div>
    </section>
    <!-- ============ FAQ ============
         文面は src/lib/faq.ts が原本。トップと共有している。 -->
    <section id="faq" class="section faq-sec">
      <div class="wrap">
        <header class="sec-head">
          <span class="eyebrow">FAQ</span>
          <h2>よくあるご質問</h2>
        </header>
        <ul class="faq-list">
          {FAQS.map((f) => (
            <li class="faq-item">
              <details>
                <summary>
                  <span class="faq-q">{f.q}</span>
                  <span class="faq-mark" aria-hidden="true"></span>
                </summary>
                <p class="faq-a">{f.a}</p>
              </details>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <div class="wrap">
      <ShareButtons title="キャリア相談｜株式会社エージェントベスト" label="このページをシェア" />
    </div>
  </main>

  <footer class="site-footer">
    <div class="wrap footer-inner">
      <div class="footer-brand">
        <img class="footer-logo" src="/logo-white.png" alt="エージェントベスト" width="508" height="120" />
        <p class="footer-tag">ミドル・ハイクラスのための転職エージェント</p>
      </div>
      <p class="footer-meta">
        株式会社エージェントベスト　許可番号 13-ユ-316964<br />
        東京都港区六本木4-8-7　嶋田ビル5階
      </p>
      <FooterSites />
    </div>
    <div class="wrap footer-base">
      <small>© {new Date().getFullYear()} Agent Best Inc.</small>
    </div>
  </footer>

  <style>
    /* ---------- HERO ---------- */
    .lead-sec { padding-block: clamp(56px, 9vw, 110px); }
    .lead-grid { display: grid; gap: clamp(32px, 5vw, 64px); align-items: start; }
    @media (min-width: 900px) { .lead-grid { grid-template-columns: 1.35fr 0.65fr; } }

    .lead-title {
      font-size: clamp(1.9rem, 4.6vw, 2.85rem);
      margin-top: 1.1rem;
      letter-spacing: 0.01em;
      line-height: 1.5;
    }
    .lead-body { color: var(--slate); margin-top: 1.8rem; line-height: 2.15; }
    .lead-cta { margin-top: 2.4rem; }
    .lead-cta .arrow { transition: transform .25s ease; }
    .lead-cta:hover .arrow { transform: translateY(3px); }

    .lead-note {
      background: var(--paper-deep);
      border: 1px solid var(--hairline);
      border-radius: 3px;
      padding: clamp(22px, 3vw, 30px);
    }
    .lead-note-title {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1.02rem;
      margin-bottom: 0.7rem;
    }
    .lead-note p { font-size: 0.86rem; color: var(--slate); line-height: 2; }

    /* ---------- 共通 見出し ---------- */
    .sec-head { margin-bottom: clamp(28px, 4vw, 46px); }
    .sec-head h2 { font-size: clamp(1.4rem, 2.8vw, 2rem); margin-top: 0.9rem; }

    /* ---------- こんな段階でも ---------- */
    .stages { background: var(--paper-deep); }
    .stages .sec-head, .stages .stage-list { padding-left: clamp(20px, 3vw, 40px); }
    .stage-list { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(20px, 3vw, 30px); }
    @media (min-width: 820px) { .stage-list { grid-template-columns: repeat(3, 1fr); } }
    .stage-card {
      background: var(--paper);
      border: 1px solid var(--hairline);
      border-radius: 3px;
      padding: clamp(22px, 3vw, 30px);
    }
    .stage-card h3 { font-size: 1rem; line-height: 1.7; }
    .stage-card p { margin-top: 0.9rem; font-size: 0.86rem; color: var(--slate); line-height: 2; }

    /* ---------- 流れ ---------- */
    .step-list { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(24px, 3.4vw, 40px); }
    @media (min-width: 820px) { .step-list { grid-template-columns: repeat(3, 1fr); } }
    .step { border-top: 1px solid var(--hairline); padding-top: 1.4rem; }
    .step-no {
      font-family: var(--font-display);
      font-size: 0.86rem;
      letter-spacing: 0.18em;
      color: var(--teal);
      font-weight: 700;
    }
    .step h3 { font-size: 1rem; margin-top: 0.6rem; }
    .step p { margin-top: 0.8rem; font-size: 0.86rem; color: var(--slate); line-height: 2; }

    /* ---------- フォーム ---------- */
    .form-sec { padding-block: clamp(64px, 9vw, 120px); background: var(--paper-deep); }
    .form-head { max-width: 34em; }
    .form-lead { margin-top: 1.2rem; color: var(--slate); font-size: 0.92rem; line-height: 2; }

    .form-frame {
      background: var(--paper);
      border: 1px solid var(--hairline);
      border-radius: 3px;
      overflow: hidden;
    }
    /* --- 相談フォーム（自作・4ステップ） --- */
    #consultForm { background: #fff; border: 1px solid var(--hairline); padding: clamp(22px, 4vw, 38px); }
    .fsteps { display: flex; flex-wrap: wrap; gap: 8px 10px; list-style: none; margin: 0 0 clamp(22px, 4vw, 32px); padding: 0; }
    .fstep { display: flex; align-items: center; gap: 7px; font-size: 0.76rem; color: var(--slate-mute); letter-spacing: 0.04em; }
    .fstep span { display: grid; place-items: center; width: 22px; height: 22px; border: 1px solid var(--hairline); border-radius: 50%; font-size: 0.72rem; }
    .fstep.is-on { color: var(--ink); font-weight: 600; }
    .fstep.is-on span { background: var(--teal); border-color: var(--teal); color: #fff; }
    .fstep.is-done span { border-color: var(--teal); color: var(--teal); }
    .fpane { border: 0; margin: 0; padding: 0; min-width: 0; }
    .fpane-title { font-family: var(--font-display); font-size: 1.05rem; font-weight: 600; padding: 0; margin-bottom: 1.4rem; }
    .frow { margin-bottom: 1.5rem; }
    .flabel { display: block; font-size: 0.84rem; font-weight: 600; margin-bottom: 0.5rem; }
    .freq { display: inline-block; margin-left: 0.5em; padding: 0.15em 0.5em; font-size: 0.66rem; font-weight: 600; letter-spacing: 0.06em; color: var(--teal); border: 1px solid var(--teal); }
    .finput {
      display: block; width: 100%; font: inherit; font-size: 16px; color: var(--ink);
      padding: 0.75em 0.85em; border: 1px solid var(--hairline); border-radius: 2px; background: var(--paper);
      transition: border-color .2s ease;
    }
    .finput:focus { outline: none; border-color: var(--teal); box-shadow: 0 0 0 3px color-mix(in srgb, var(--teal) 12%, transparent); }
    .finput--short { max-width: 12rem; }
    textarea.finput { resize: vertical; line-height: 1.9; }
    .finput.is-ng { border-color: #B3453B; background: #FCF5F4; }
    .fhelp { margin-top: 0.5rem; font-size: 0.78rem; color: var(--slate-mute); line-height: 1.9; }
    .fradio, .fcheck { display: flex; align-items: flex-start; gap: 0.6em; margin-top: 0.6rem; font-size: 0.88rem; line-height: 1.7; cursor: pointer; }
    .fradio input, .fcheck input { margin-top: 0.25em; width: 17px; height: 17px; accent-color: var(--teal); flex: none; }
    .fcheck a { text-decoration: underline; text-underline-offset: 3px; }
    .fhoney { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
    .fmsg { margin: 0 0 1rem; padding: 0.9em 1em; font-size: 0.85rem; line-height: 1.9; background: #FCF5F4; border: 1px solid #E4C4BF; color: #8C3229; }
    .fmsg a { text-decoration: underline; text-underline-offset: 3px; }
    .factions { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin-top: 0.5rem; }
    /* .btn の display:inline-flex が hidden 属性に勝ってしまうので明示的に消す */
    .factions [hidden] { display: none !important; }
    .fnext { flex: 1 1 auto; justify-content: center; }
    .fback { flex: 0 0 auto; }
    .fnote { margin-top: 1rem; font-size: 0.76rem; color: var(--slate-mute); line-height: 1.9; }


    .alt-cta {
      margin-top: clamp(40px, 6vw, 70px);
      border-top: 1px solid var(--hairline);
      padding-top: clamp(28px, 4vw, 42px);
    }
    .alt-cta-title { font-family: var(--font-display); font-weight: 700; font-size: 1.05rem; }
    .alt-cta-body { margin-top: 0.7rem; color: var(--slate); font-size: 0.9rem; line-height: 2; }
    .alt-cta .btn { margin-top: 1.4rem; }

    .alt-note {
      margin-top: clamp(28px, 4vw, 42px);
      font-size: 0.8rem;
      color: var(--slate-mute);
      line-height: 2.1;
    }
    .alt-note a { color: var(--teal); text-decoration: underline; text-underline-offset: 3px; }

    /* ---------- FOOTER（index / contact と同一） ---------- */
    .site-footer { background: var(--ink); color: var(--paper); padding-top: clamp(48px, 7vw, 80px); border-top: 1px solid var(--hairline-on-dark); }
    .footer-inner { display: grid; gap: clamp(28px, 5vw, 48px); padding-bottom: clamp(40px, 6vw, 64px); }
    @media (min-width: 720px) { .footer-inner { grid-template-columns: 1fr 1fr; align-items: end; } }
    .footer-brand { display: flex; flex-direction: column; gap: 0.4rem; }
    /* 縦並びのflexなので align-self を指定しないと画像が幅いっぱいに伸びる */
    .footer-logo { display: block; align-self: flex-start; height: 40px; width: auto; max-width: 100%; margin-bottom: 0.2rem; }
    .footer-tag { color: #AEB6C2; font-size: 0.84rem; }
    .footer-meta { color: #AEB6C2; font-size: 0.82rem; line-height: 1.9; }
    @media (min-width: 720px) { .footer-meta { text-align: right; } }
    .footer-base { border-top: 1px solid var(--hairline-on-dark); padding-block: 1.6rem; }
    .footer-base small { color: var(--slate-mute); letter-spacing: 0.06em; }

    /* ---------- FAQ ---------- */
    .faq-sec { padding-top: 0; }
    .faq-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--hairline); max-width: 780px; }
    .faq-item { border-bottom: 1px solid var(--hairline); }
    .faq-item summary {
      list-style: none; cursor: pointer;
      display: flex; align-items: center; justify-content: space-between; gap: 1.5em;
      padding: clamp(16px, 2.2vw, 24px) 0;
    }
    .faq-item summary::-webkit-details-marker { display: none; }
    .faq-q { font-family: var(--font-display); font-weight: 600; font-size: clamp(0.98rem, 2vw, 1.08rem); line-height: 1.7; }
    /* ＋ / − のマーク。開いたら縦線だけ消す */
    .faq-mark { position: relative; flex: 0 0 14px; width: 14px; height: 14px; }
    .faq-mark::before, .faq-mark::after { content: ""; position: absolute; background: var(--teal); transition: opacity .2s; }
    .faq-mark::before { left: 0; top: 6px; width: 14px; height: 2px; }
    .faq-mark::after { left: 6px; top: 0; width: 2px; height: 14px; }
    .faq-item details[open] .faq-mark::after { opacity: 0; }
    .faq-a { margin: 0; padding: 0 0 clamp(18px, 2.4vw, 26px); color: var(--slate); font-size: 0.92rem; line-height: 2; max-width: 44em; }
  </style>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqStructuredData)} />

  <!-- 相談フォームの計測。
       自作フォームなので、表示・ステップ通過・送信・エラーをすべて自前で取れる。
       送信数は /consultation/thanks/ の page_view（＋そこで撃つ consult_submit）で数える。 -->
  <script is:inline define:vars={{ SUPABASE_URL, SUPABASE_ANON_KEY, CONSULT_TABLE, FORM_DIRECT_URL }}>
    (function () {
      var form = document.getElementById('consultForm');
      if (!form) return;

      var DRAFT_KEY = 'consult-draft';
      var TOTAL = 4;
      var step = 1;
      var sending = false;

      var panes = [].slice.call(form.querySelectorAll('.fpane'));
      var chips = [].slice.call(form.querySelectorAll('.fstep'));
      var nextBtn = document.getElementById('cf-next');
      var backBtn = document.getElementById('cf-back');
      var msgEl = document.getElementById('cf-msg');
      var noteEl = document.getElementById('cf-note');

      function track(name, params) {
        try { if (typeof window.gtag === 'function') window.gtag('event', name, params || {}); } catch (e) {}
      }
      function val(id) {
        var el = document.getElementById(id);
        return el ? String(el.value || '').trim() : '';
      }
      function showMsg(html) {
        msgEl.hidden = !html;
        msgEl.innerHTML = html || '';
      }

      /* ---------- 入力チェック ---------- */
      function fieldNg(el, ng) {
        if (!el) return;
        el.classList.toggle('is-ng', !!ng);
        if (ng) el.setAttribute('aria-invalid', 'true');
        else el.removeAttribute('aria-invalid');
      }
      function validate(n) {
        var bad = [];
        if (n === 1) {
          var name = document.getElementById('cf-name');
          var mail = document.getElementById('cf-email');
          var tel = document.getElementById('cf-phone');
          if (!val('cf-name')) bad.push([name, 'お名前']);
          if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val('cf-email'))) bad.push([mail, 'メールアドレス']);
          if (val('cf-phone').replace(/\D/g, '').length < 10) bad.push([tel, '電話番号']);
        }
        if (n === 2) {
          var timing = document.getElementById('cf-timing');
          if (!val('cf-timing')) bad.push([timing, '転職の温度感']);
        }
        if (n === 4) {
          var scout = form.querySelector('input[name="scout"]:checked');
          var consent = document.getElementById('cf-consent');
          if (!scout) bad.push([null, '求人案内・スカウトの受信']);
          if (!consent.checked) bad.push([null, '個人情報の取り扱いへの同意']);
        }
        panes[n - 1].querySelectorAll('.finput').forEach(function (el) { fieldNg(el, false); });
        bad.forEach(function (b) { fieldNg(b[0], true); });
        if (bad.length) {
          showMsg('未入力の項目があります：' + bad.map(function (b) { return b[1]; }).join('、'));
          var first = bad[0][0];
          if (first && first.focus) first.focus();
          return false;
        }
        showMsg('');
        return true;
      }

      /* ---------- 画面の切り替え ---------- */
      function paint() {
        panes.forEach(function (p, i) { p.hidden = i + 1 !== step; });
        chips.forEach(function (c, i) {
          c.classList.toggle('is-on', i + 1 === step);
          c.classList.toggle('is-done', i + 1 < step);
        });
        backBtn.hidden = step === 1;
        nextBtn.innerHTML = step === TOTAL
          ? '相談を送信する <span class="arrow" aria-hidden="true">→</span>'
          : '次へ <span class="arrow" aria-hidden="true">→</span>';
        noteEl.textContent = step === TOTAL
          ? '送信後、担当より原則2営業日以内にご連絡します。'
          : '入力は3分ほどで終わります。途中の内容はこの端末に一時保存されます。';
      }

      /* ---------- 下書き（この端末にだけ残す） ---------- */
      var FIELDS = ['cf-name', 'cf-kana', 'cf-email', 'cf-phone', 'cf-status', 'cf-company',
        'cf-timing', 'cf-salary', 'cf-wish', 'cf-applied', 'cf-message'];
      function saveDraft() {
        try {
          var d = {};
          FIELDS.forEach(function (id) { d[id] = val(id); });
          var scout = form.querySelector('input[name="scout"]:checked');
          if (scout) d.scout = scout.value;
          localStorage.setItem(DRAFT_KEY, JSON.stringify(d));
        } catch (e) {}
      }
      function loadDraft() {
        try {
          var d = JSON.parse(localStorage.getItem(DRAFT_KEY) || '{}');
          FIELDS.forEach(function (id) {
            var el = document.getElementById(id);
            if (el && d[id]) el.value = d[id];
          });
          if (d.scout) {
            var r = form.querySelector('input[name="scout"][value="' + d.scout + '"]');
            if (r) r.checked = true;
          }
        } catch (e) {}
      }
      function clearDraft() { try { localStorage.removeItem(DRAFT_KEY); } catch (e) {} }

      /* ---------- 送信 ---------- */
      function submit() {
        if (sending) return;
        /* ハニーポット。人には見えない欄なので、埋まっていたらbotとして黙って終わる */
        if (val('cf-site')) { location.href = '/consultation/thanks/'; return; }

        sending = true;
        nextBtn.disabled = true;
        nextBtn.textContent = '送信中…';
        showMsg('');

        var scout = form.querySelector('input[name="scout"]:checked');
        var payload = {
          full_name: val('cf-name'),
          kana: val('cf-kana') || null,
          email: val('cf-email'),
          phone: val('cf-phone').replace(/\D/g, ''),
          status: val('cf-status') || null,
          current_company: val('cf-company') || null,
          timing: val('cf-timing'),
          desired_salary: val('cf-salary') || null,
          desired_role: val('cf-wish') || null,
          applied_companies: val('cf-applied') || null,
          message: val('cf-message') || null,
          scout_consent: scout ? scout.value : null,
          consent: true,
          source: 'corporate-consultation',
          page_path: location.pathname
        };

        fetch(SUPABASE_URL + '/rest/v1/' + CONSULT_TABLE, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            apikey: SUPABASE_ANON_KEY,
            Authorization: 'Bearer ' + SUPABASE_ANON_KEY,
            Prefer: 'return=minimal'
          },
          body: JSON.stringify(payload)
        }).then(function (res) {
          if (!res.ok) throw new Error(String(res.status));
          clearDraft();
          track('consult_send', { timing: payload.timing || '' });
          location.href = '/consultation/thanks/';
        }).catch(function (err) {
          sending = false;
          nextBtn.disabled = false;
          nextBtn.innerHTML = '相談を送信する <span class="arrow" aria-hidden="true">→</span>';
          showMsg('送信できませんでした。お手数ですが <a href="' + FORM_DIRECT_URL + '" target="_blank" rel="noopener">こちらのフォーム</a> からご記入いただくか、<a href="mailto:r_matsuoka@agent-best.net">r_matsuoka@agent-best.net</a> あてにご連絡ください。');
          track('consult_error', { detail: String(err && err.message || '') });
        });
      }

      nextBtn.addEventListener('click', function () {
        if (!validate(step)) return;
        saveDraft();
        if (step === TOTAL) { submit(); return; }
        step += 1;
        paint();
        track('consult_step', { step: step });
        form.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
      backBtn.addEventListener('click', function () {
        if (step === 1) return;
        step -= 1;
        showMsg('');
        paint();
        form.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
      form.addEventListener('input', saveDraft);
      form.addEventListener('keydown', function (e) {
        /* テキスト入力でEnterを押したときに、送信ではなく「次へ」に進める */
        if (e.key === 'Enter' && e.target && e.target.tagName === 'INPUT') {
          e.preventDefault();
          nextBtn.click();
        }
      });

      loadDraft();
      paint();

      /* フォームが画面に入ったか */
      if ('IntersectionObserver' in window) {
        var seen = false;
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting && !seen) {
              seen = true;
              io.disconnect();
              track('consult_form_view', { page_path: location.pathname });
            }
          });
        }, { threshold: 0.3 });
        io.observe(form);
      }

      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest && e.target.closest('[data-consult-cta]');
        if (a) track('consult_click', { placement: a.getAttribute('data-consult-cta'), page_path: location.pathname });
      });
    })();
  </script>
</Layout>
