---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ShareButtons from '../components/ShareButtons.astro';

import FooterSites from '../components/FooterSites.astro';
// 構造化データ（E-E-A-T / Person）
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: '松岡 良次',
  jobTitle: '代表取締役',
  worksFor: {
    '@type': 'Organization',
    name: '株式会社エージェントベスト',
    url: 'https://www.agent-best.net',
    address: {
      '@type': 'PostalAddress',
      addressCountry: 'JP',
      addressRegion: '東京都',
      streetAddress: '港区六本木4-8-7 嶋田ビル5階',
    },
  },
  url: 'https://www.agent-best.net/profile',
  sameAs: [
    'https://x.com/r_matsuoka0919',
    'https://www.facebook.com/ryouji.matsuoka919',
    'https://www.linkedin.com/in/%E8%89%AF%E6%AC%A1-%E6%9D%BE%E5%B2%A1-87bb9851/',
    'https://note.com/ryouji_matsuoka',
  ],
  knowsAbout: ['転職支援', 'IT業界', 'スタートアップ', 'コンサルティング業界', 'M&A業界', '採用支援'],
};
---

<Layout
  title="松岡 良次｜株式会社エージェントベスト 代表"
  description="株式会社エージェントベスト代表・松岡良次のプロフィール。大手人材会社およびスタートアップ人材企業での採用支援を経て独立。IT・スタートアップ・コンサル・M&A領域に特化し、20〜30代のキャリア支援を行っています。"
>
  <Header />

  <main>
    <section class="profile">
      <div class="wrap">
        <span class="eyebrow">Profile</span>
        <h1 class="profile-name">
          松岡 良次
          <span class="profile-name-en">Ryoji Matsuoka</span>
        </h1>
        <p class="profile-role">株式会社エージェントベスト 代表</p>

        <div class="profile-grid">
          <div class="profile-body">
            <p class="profile-lead">
              大手人材会社およびスタートアップ人材企業にて、IT・スタートアップ・メガベンチャー企業の
              採用支援に従事。独立後はIT・スタートアップ・コンサル領域に特化し、
              20〜30代のキャリア支援を行っています。
            </p>

            <h2>支援の考え方</h2>
            <p>
              転職は、目の前の一社を決めて終わりではありません。10年先のキャリアから逆算したときに、
              いま選ぶべき一社はどれか。その問いに一緒に向き合うことを大切にしています。
            </p>
            <p>
              領域を絞っているのは、そのためです。IT・スタートアップ・コンサル・M&amp;Aに特化することで、
              企業ごとの選考の実態、入社後に何が起きるか、どういう人が活躍しているかまで踏み込んだ
              情報をお伝えできます。求人紹介の前段階から、キャリアの整理にお付き合いします。
            </p>

            <h2>専門領域</h2>
            <ul class="profile-list">
              <li>IT・SaaS・スタートアップ／メガベンチャー</li>
              <li>コンサルティングファーム（戦略・総合・IT）</li>
              <li>M&amp;A（仲介・FAS・投資銀行・PEファンド）</li>
              <li>事業会社のプロダクトマネジメント／経営企画</li>
            </ul>

            <h2>メディアでの発信</h2>
            <p>
              <a href="/media/">キャリアメディア</a>では、職種・業界・企業ごとの転職情報を
              実務目線で解説しています。全記事の監修を担当しています。
            </p>
            <p>
              個人としては<a href="https://note.com/ryouji_matsuoka" target="_blank" rel="noopener">note</a>でも、
              採用・転職の現場で考えていることを発信しています。
            </p>
          </div>

          <aside class="profile-side">
            <div class="profile-card">
              <p class="card-label">Contact</p>
              <a
                href="https://calendly.com/r_matsuoka?utm_source=profile&utm_medium=page&utm_campaign=profile"
                target="_blank"
                rel="noopener"
                class="btn">無料キャリア面談を予約する</a
              >
              <p class="card-note">
                転職の意思が固まっていない段階でのご相談も歓迎しています。
              </p>
            </div>

            <div class="profile-card">
              <p class="card-label">SNS</p>
              <ul class="sns-list">
                <li>
                  <a href="https://x.com/r_matsuoka0919" target="_blank" rel="noopener">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                    <span>X（Twitter）</span>
                  </a>
                </li>
                <li>
                  <a href="https://www.facebook.com/ryouji.matsuoka919" target="_blank" rel="noopener">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047v-2.66c0-3.025 1.792-4.697 4.533-4.697 1.313 0 2.686.236 2.686.236v2.971H15.83c-1.491 0-1.956.93-1.956 1.886v2.264h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z"/></svg>
                    <span>Facebook</span>
                  </a>
                </li>
                <li>
                  <a href="https://www.linkedin.com/in/%E8%89%AF%E6%AC%A1-%E6%9D%BE%E5%B2%A1-87bb9851/" target="_blank" rel="noopener">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/></svg>
                    <span>LinkedIn</span>
                  </a>
                </li>
                <li>
                  <a href="https://note.com/ryouji_matsuoka" target="_blank" rel="noopener">
                    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><rect x="1" y="1" width="22" height="22" rx="6" fill="currentColor"/><path d="M7.4 16.6V8.9h2.28v1.05c.5-.79 1.35-1.24 2.42-1.24 1.86 0 2.94 1.16 2.94 3.13v4.76h-2.35v-4.31c0-1.06-.5-1.63-1.42-1.63-.94 0-1.52.63-1.52 1.7v4.24z" fill="#fff"/></svg>
                    <span>note</span>
                  </a>
                </li>
              </ul>
            </div>

            <div class="profile-card">
              <p class="card-label">Company</p>
              <p class="card-company">
                株式会社エージェントベスト<br />
                東京都港区六本木4-8-7 嶋田ビル5階<br />
                有料職業紹介事業 許可番号 13-ユ-316964
              </p>
              <a href="/contact/" class="card-link">お問い合わせ →</a>
            </div>
          </aside>
        </div>
      </div>
    </section>
    <div class="wrap">
      <ShareButtons title="松岡 良次｜株式会社エージェントベスト 代表" label="このページをシェア" />
    </div>
  </main>

  <footer class="site-footer">
    <div class="wrap footer-inner">
      <div class="footer-brand">
        <img class="footer-logo" src="/logo.png" alt="エージェントベスト" width="508" height="120" />
        <p class="footer-tag">ミドル・ハイクラスのための転職エージェント</p>
      </div>
      <p class="footer-meta">
        株式会社エージェントベスト　許可番号 13-ユ-316964<br />
        東京都港区六本木4-8-7　嶋田ビル5階
      </p>
      <FooterSites />
    </div>
    <div class="wrap footer-base">
      <small>&copy; {new Date().getFullYear()} Agent Best Inc.</small>
    </div>
  </footer>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />
</Layout>

<style>
  .footer-logo {
    display: block;
    height: 42px;
    width: auto;
  }
  .profile {
    padding: clamp(48px, 8vw, 96px) 0 clamp(56px, 9vw, 104px);
  }
  .profile-name {
    font-size: clamp(1.9rem, 4.5vw, 2.6rem);
    margin: 14px 0 6px;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0 16px;
  }
  .profile-name-en {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    color: var(--slate-mute);
  }
  .profile-role {
    color: var(--slate);
    font-size: 0.95rem;
    margin-bottom: clamp(32px, 5vw, 56px);
  }

  .profile-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: clamp(32px, 5vw, 64px);
    align-items: start;
  }

  .profile-lead {
    font-size: 1.05rem;
    line-height: 2;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--hairline);
  }
  .profile-body h2 {
    font-size: 1.15rem;
    margin: 40px 0 14px;
    padding-left: 14px;
    border-left: 3px solid var(--teal);
  }
  .profile-body p + p { margin-top: 1em; }
  .profile-body a {
    color: var(--teal);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .profile-list {
    margin: 0;
    padding-left: 1.2em;
    color: var(--slate);
  }
  .profile-list li { margin-bottom: 0.4em; }

  .profile-side {
    display: flex;
    flex-direction: column;
    gap: 16px;
    position: sticky;
    top: 24px;
  }
  .profile-card {
    border: 1px solid var(--hairline);
    border-radius: 12px;
    background: #fff;
    padding: 20px;
  }
  .card-label {
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    color: var(--slate-mute);
    margin-bottom: 12px;
  }
  .profile-card .btn { width: 100%; justify-content: center; }
  .card-note {
    font-size: 0.8rem;
    line-height: 1.8;
    color: var(--slate);
    margin-top: 12px;
  }
  .card-company {
    font-size: 0.82rem;
    line-height: 1.9;
    color: var(--slate);
  }
  .card-link {
    display: inline-block;
    margin-top: 12px;
    font-size: 0.85rem;
    color: var(--teal);
  }
  .card-link:hover { text-decoration: underline; }

  .sns-list { list-style: none; margin: 0; padding: 0; }
  .sns-list li + li { margin-top: 10px; }
  .sns-list a {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.88rem;
    color: var(--slate);
    transition: color 0.15s;
  }
  .sns-list a:hover { color: var(--teal); }

  @media (max-width: 860px) {
    .profile-grid { grid-template-columns: 1fr; }
    .profile-side { position: static; }
  }
</style>
