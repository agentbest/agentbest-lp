---
// src/pages/media/hub/[cat].astro
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('media');
  const groups = new Map();
  for (const p of posts) {
    const key = p.data.jobType ?? p.data.industry;
    if (!groups.has(key)) groups.set(key, []);
    groups.get(key).push(p);
  }
  function commonPrefix(arr) {
    if (arr.length === 1) return arr[0];
    let pre = arr[0];
    for (const s of arr) {
      while (!s.startsWith(pre)) pre = pre.slice(0, -1);
    }
    return pre.replace(/-$/, '');
  }
  return [...groups.entries()].map(([name, items]) => ({
    params: { cat: commonPrefix(items.map((i) => i.slug)) },
    props: { name, items, category: items[0].data.category },
  }));
}

const { name, items, category } = Astro.props;
const sorted = items.sort((a, b) => a.data.theme.localeCompare(b.data.theme, 'ja'));
const title = `${name}の転職情報まとめ｜年収・キャリア・面接対策`;
const description = `${name}の転職・キャリアに関する記事一覧です。年収相場やキャリアパスから選考対策まで、実務目線で解説します。`;
---

<Layout title={title} description={description}>
  <section class="hub">
    <p class="breadcrumb"><a href="/media">キャリアメディア</a> / {category === '職種' ? '職種別' : '業界別'}</p>
    <h1>{name}の転職情報</h1>
    <p class="hub-lead">
      {name}に関する転職・キャリア記事の一覧です。検討フェーズに応じてご活用ください。
    </p>

    <h2>すべての記事（{sorted.length}本）</h2>
    <ul class="hub-list">
      {sorted.map((p) => (
        <li>
          <a href={`/media/${p.slug}`}>{p.data.title}</a>
          <span class="theme-tag">{p.data.theme}</span>
        </li>
      ))}
    </ul>

    <aside class="cta">
      <h2>{name}のキャリアを相談する</h2>
      <p>エージェントベストは、IT・スタートアップ・コンサル領域に特化した転職エージェントです。20〜30代のキャリア設計を、求人紹介の前段階からサポートします。</p>
      <a href="https://calendly.com/r_matsuoka?utm_source=media&utm_medium=hub" target="_blank" rel="noopener" class="cta-button">無料キャリア面談を予約する</a>
    </aside>
  </section>
</Layout>

<style>
  .hub { max-width: 760px; margin: 0 auto; padding: 32px 20px 64px; line-height: 1.9; color: #24292f; }
  .hub .breadcrumb { font-size: .85rem; color: #6b7684; }
  .hub .breadcrumb a { color: #6b7684; }
  .hub h1 { font-size: 1.6rem; margin: .4em 0; }
  .hub h2 { font-size: 1.25rem; margin: 2.2em 0 .8em; padding: .35em .8em; border-left: 5px solid #1c1c2e; background: #f6f8fa; border-radius: 4px; }
  .hub-lead { color: #454e59; }
  .hub-list { list-style: none; padding: 0; }
  .hub-list li { padding: .7em .2em; border-bottom: 1px solid #eceff2; }
  .hub-list a { color: #1c1c2e; text-decoration: none; font-weight: 600; }
  .hub-list a:hover { text-decoration: underline; }
  .theme-tag { display: inline-block; margin-left: .6em; font-size: .78rem; color: #6b7684; background: #f0f2f5; border-radius: 4px; padding: 2px 8px; }
  .cta { margin-top: 3rem; padding: 2rem 1.5rem; border-radius: 12px; background: #1c1c2e; color: #fff; text-align: center; }
  .cta h2 { background: none; border: none; color: #fff; padding: 0; margin: 0 0 .6em; }
  .cta p { color: #d5d9e0; }
  .cta-button { display: inline-block; margin-top: 1rem; padding: .8rem 2.4rem; background: #fff; color: #1c1c2e; border-radius: 8px; text-decoration: none; font-weight: 700; }
</style>
