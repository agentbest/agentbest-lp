---
// src/pages/media/hub/[cat]/[...page].astro … ハブ（職種・業界・企業領域）の記事一覧
//
// 1ページ目のURLは /media/hub/{cat}/ のまま（[...page] のレスト引数が空になる）。
// 2ページ目以降が /media/hub/{cat}/2/ になるので、既存URLは変わりません。
import { getCollection } from 'astro:content';
import Layout from '../../../../layouts/Layout.astro';
import Header from '../../../../components/Header.astro';
import MediaSearchBox from '../../../../components/MediaSearchBox.astro';
import ShareButtons from '../../../../components/ShareButtons.astro';
import { hubLabel, groupOf, CATEGORY_LABEL, KANA_ROWS, companyRow, companySortKey } from '../../../../lib/mediaTaxonomy';

export async function getStaticPaths({ paginate }) {
  const posts = await getCollection('media');

  const byHub = new Map();
  for (const p of posts) {
    if (!p.data.hub) {
      console.warn(`[media] hub が未設定の記事があります: ${p.slug}（一覧に出ません）`);
      continue;
    }
    if (!byHub.has(p.data.hub)) byHub.set(p.data.hub, []);
    byHub.get(p.data.hub).push(p);
  }

  return [...byHub.entries()].flatMap(([hub, items]) => {
    const category = items[0].data.category;
    const isCompany = category === '企業';
    // 企業ハブは「50音の行 → 社名の読み（slugのローマ字）」順。
    // 読み順だけで並べると英数字の社名が日本語名の間に挟まり、行の小見出しが交互に出てしまう。
    const rowIndex = (p) => KANA_ROWS.indexOf(companyRow(p.data.companyName ?? '', p.slug));
    const sorted = [...items].sort((a, b) =>
      isCompany
        ? rowIndex(a) - rowIndex(b) || companySortKey(a.slug).localeCompare(companySortKey(b.slug))
        : a.data.theme.localeCompare(b.data.theme, 'ja') || a.data.title.localeCompare(b.data.title, 'ja'));

    return paginate(sorted, {
      params: { cat: hub },
      props: { hub, category, total: items.length },
      pageSize: isCompany ? 60 : 40,
    });
  });
}

const { page } = Astro.props;
const { hub, category, total } = Astro.props;
const name = hubLabel(hub);
const group = groupOf(hub);
const isCompany = category === '企業';
const catLabel = CATEGORY_LABEL[category] ?? category;

// 企業一覧は50音の行ごとに小見出しを立てる（そのページに現れた行だけ）
const rows = [];
if (isCompany) {
  for (const p of page.data) {
    const r = companyRow(p.data.companyName ?? '', p.slug);
    if (!rows.length || rows[rows.length - 1].row !== r) rows.push({ row: r, items: [] });
    rows[rows.length - 1].items.push(p);
  }
}

// このサイトは末尾スラッシュあり（vercel.json の trailingSlash: true）。
// paginate が返すURLはスラッシュ無しなので、そのまま貼ると毎回308リダイレクトを踏む
const slash = (u?: string) => (u ? (u.endsWith('/') ? u : `${u}/`) : u);
const prevUrl = slash(page.url.prev);
const nextUrl = slash(page.url.next);

const pageSuffix = page.currentPage > 1 ? `（${page.currentPage}／${page.lastPage}ページ）` : '';
const title = isCompany
  ? `${name}の企業一覧｜評判・年収・選考対策${pageSuffix}`
  : `${name}の転職情報まとめ｜年収・キャリア・面接対策${pageSuffix}`;
const description = isCompany
  ? `${name}に分類される${total}社の評判・年収・働き方・選考対策の記事一覧です。数字は有価証券報告書などの一次情報をもとにしています。`
  : `${name}の転職・キャリアに関する記事${total}本の一覧です。年収相場やキャリアパスから選考対策まで、実務目線で解説します。`;
---

<Layout title={title} description={description}>
  <Header />
  <section class="hub">
    <nav class="breadcrumb" aria-label="パンくず">
      <a href="/media/">キャリアメディア</a>
      <span>/</span>
      <a href={`/media/#${category === '職種' ? 'job' : category === '業界' ? 'industry' : 'company'}`}>{catLabel}</a>
      {group && <><span>/</span><span>{group}</span></>}
    </nav>

    <h1>{isCompany ? `${name}の企業一覧` : `${name}の転職情報`}</h1>
    <p class="hub-lead">
      {isCompany
        ? `${name}に分類される${total}社の評判・年収・働き方・選考対策をまとめています。数字は有価証券報告書などの一次情報をもとにしています。`
        : `${name}に関する転職・キャリア記事${total}本の一覧です。検討フェーズに応じてご活用ください。`}
    </p>

    <MediaSearchBox placeholder={isCompany ? '企業名で検索' : '記事を検索'} />

    <h2>
      {isCompany ? '掲載企業' : 'すべての記事'}（{total}{isCompany ? '社' : '本'}）
      {page.lastPage > 1 && <span class="page-of">{page.currentPage}／{page.lastPage}ページ</span>}
    </h2>

    {isCompany ? (
      rows.map((r) => (
        <div class="kana-block">
          <h3 class="kana">{r.row}</h3>
          <ul class="art-list">
            {r.items.map((p) => (
              <li>
                <a href={`/media/${p.slug}/`}>
                  <img class="art-image" src={p.data.image ?? `/images/media/${p.slug}.png`} alt="" loading="lazy" decoding="async" width="1200" height="630" />
                  <span class="art-body">
                    <span class="art-title">{p.data.companyName}</span>
                    <span class="art-desc">{p.data.description}</span>
                    <span class="art-meta"><span class="theme">{p.data.theme}</span></span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    ) : (
      <ul class="art-list">
        {page.data.map((p) => (
          <li>
            <a href={`/media/${p.slug}/`}>
              <img class="art-image" src={p.data.image ?? `/images/media/${p.slug}.png`} alt="" loading="lazy" decoding="async" width="1200" height="630" />
              <span class="art-body">
                <span class="art-title">{p.data.title}</span>
                <span class="art-desc">{p.data.description}</span>
                <span class="art-meta"><span class="theme">{p.data.theme}</span></span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    )}

    {page.lastPage > 1 && (
      <nav class="pager" aria-label="ページ送り">
        {prevUrl ? <a href={prevUrl} rel="prev">← 前へ</a> : <span class="disabled">← 前へ</span>}
        <span class="pager-now">{page.currentPage} / {page.lastPage}</span>
        {nextUrl ? <a href={nextUrl} rel="next">次へ →</a> : <span class="disabled">次へ →</span>}
      </nav>
    )}

    <ShareButtons title={title} label="このページをシェア" />

    <aside class="cta">
      <h2>{name}のキャリアを相談する</h2>
      <p>エージェントベストは、IT・スタートアップ・コンサル領域に特化した転職エージェントです。20〜30代のキャリア設計を、求人紹介の前段階からサポートします。</p>
      <a href="https://calendly.com/r_matsuoka?utm_source=media&utm_medium=hub" target="_blank" rel="noopener" class="cta-button">無料キャリア面談を予約する</a>
    </aside>
  </section>
</Layout>

<style>
  .hub { max-width: 820px; margin: 0 auto; padding: 32px 20px 64px; line-height: 1.9; color: #24292f; }
  .breadcrumb { font-size: .85rem; color: #6b7684; display: flex; flex-wrap: wrap; gap: .4em; }
  .breadcrumb a { color: #6b7684; }
  .hub h1 { font-size: 1.6rem; margin: .4em 0; }
  .hub h2 { font-size: 1.25rem; margin: 2.2em 0 .8em; padding: .35em .8em; border-left: 5px solid #1c1c2e; background: #f6f8fa; border-radius: 4px; display: flex; justify-content: space-between; align-items: baseline; gap: .6em; }
  .page-of { font-size: .78rem; color: #6b7684; font-weight: 400; }
  .hub-lead { color: #454e59; }

  .kana-block { margin-top: 1.6em; }
  .kana { font-size: .9rem; margin: 0 0 .2em; padding: .2em .7em; display: inline-block;
    background: #1c1c2e; color: #fff; border-radius: 4px; letter-spacing: .04em; }

  .art-list { list-style: none; padding: 0; margin: .4em 0 0; }
  .art-list li { border-bottom: 1px solid #eceff2; }
  .art-list a { display: grid; grid-template-columns: 180px minmax(0, 1fr); gap: 1em; align-items: center; padding: 1em .2em; text-decoration: none; color: inherit; }
  .art-image { display: block; width: 100%; height: auto; aspect-ratio: 1200 / 630; object-fit: cover; border-radius: 9px; background: #f0f2f5; }
  .art-body { min-width: 0; }
  .art-list a:hover { background: #fafbfc; }
  .art-title { display: block; font-weight: 700; color: #1c1c2e; line-height: 1.6; }
  .art-list a:hover .art-title { text-decoration: underline; }
  .art-desc { display: block; margin-top: .25em; font-size: .87rem; color: #57606a; line-height: 1.75;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .art-meta { display: flex; gap: .5em; margin-top: .45em; }
  .theme { font-size: .74rem; background: #f0f2f5; color: #6b7684; border-radius: 4px; padding: 2px 8px; }

  .pager { display: flex; align-items: center; justify-content: center; gap: 1.2em; margin: 2.4em 0 0; font-size: .9rem; }
  .pager a { color: #1c1c2e; font-weight: 700; text-decoration: none; padding: .5em 1.2em; border: 1px solid #d8dde3; border-radius: 8px; }
  .pager a:hover { border-color: #1c1c2e; background: #fafbfc; }
  .pager .disabled { color: #b6bcc4; padding: .5em 1.2em; border: 1px solid #eceff2; border-radius: 8px; }
  .pager-now { color: #6b7684; }

  .cta { margin-top: 3rem; padding: 2rem 1.5rem; border-radius: 12px; background: #1c1c2e; color: #fff; text-align: center; }
  .cta h2 { background: none; border: none; color: #fff; padding: 0; margin: 0 0 .6em; display: block; }
  .cta p { color: #d5d9e0; }
  .cta-button { display: inline-block; margin-top: 1rem; padding: .8rem 2.4rem; background: #fff; color: #1c1c2e; border-radius: 8px; text-decoration: none; font-weight: 700; }

  @media (max-width: 600px) {
    .art-list a { grid-template-columns: 116px minmax(0, 1fr); gap: .75em; }
    .art-desc { -webkit-line-clamp: 1; }
  }
</style>
