---
// src/pages/media/search/index.astro … メディア内検索
// 検索インデックス（/media/search.json）はこのページからのみfetchする。
// 検索結果は毎回変わるので noindex。
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';

const title = '記事を検索｜キャリアメディア';
const description = 'エージェントベストのキャリアメディア内を、企業名・職種・業界で検索できます。';
---

<Layout title={title} description={description} noindex={true}>
  <Header />
  <section class="hub">
    <nav class="breadcrumb" aria-label="パンくず">
      <a href="/media/">キャリアメディア</a><span>/</span><span>検索</span>
    </nav>

    <h1>記事を検索</h1>

    <form class="media-search" role="search" id="f" action="/media/search/" method="get">
      <label class="sr-only" for="q">検索語</label>
      <input id="q" type="search" name="q" placeholder="企業名・職種・業界（例：アクセンチュア、SRE、SaaS）" autocomplete="off" />
      <button type="submit">検索</button>
    </form>

    <p class="status" id="status" role="status" aria-live="polite">検索語を入力してください。</p>
    <ul class="art-list" id="results"></ul>
    <p class="more" id="more" hidden></p>

    <p class="fallback">
      うまく見つからないときは、<a href="/media/companies/">企業名の50音インデックス</a>や
      <a href="/media/">職種・業界の一覧</a>からもたどれます。
    </p>
  </section>
</Layout>

<script>
  const input = document.getElementById('q');
  const statusEl = document.getElementById('status');
  const list = document.getElementById('results');
  const moreEl = document.getElementById('more');
  const LIMIT = 60;

  let index = null;
  let loading = null;

  function loadIndex() {
    if (index) return Promise.resolve(index);
    if (!loading) {
      loading = fetch('/media/search.json')
        .then((r) => { if (!r.ok) throw new Error(String(r.status)); return r.json(); })
        // インデックスは容量を削るため
        // [slug, title, desc, カテゴリ番号, ハブ番号, 企業名, タグ番号の配列] の配列で来る
        .then((raw) => {
          index = raw.i.map((a) => ({
            s: a[0], t: a[1], d: a[2], c: raw.c[a[3]], h: raw.h[a[4]], n: a[5],
            g: (a[6] || []).map((i) => raw.g[i]).join(' '),
          }));
          return index;
        });
    }
    return loading;
  }

  const norm = (s) =>
    (s || '')
      .toLowerCase()
      // 全角英数を半角に。「ＮＴＴ」「ＳＲＥ」で打たれても引っかかるようにする
      .replace(/[Ａ-Ｚａ-ｚ０-９]/g, (c) => String.fromCharCode(c.charCodeAt(0) - 0xfee0))
      // カタカナをひらがなに寄せて、ゆれを吸収する
      .replace(/[ァ-ヶ]/g, (c) => String.fromCharCode(c.charCodeAt(0) - 0x60))
      .replace(/[・･\s　‐-‒–—―ー_.,]/g, '');

  function score(item, terms) {
    const name = norm(item.n);
    const title = norm(item.t);
    const hub = norm(item.h);
    // タグ名。「外資系」「年収1000万円」のようにタイトルにも説明文にも出ない語を拾う
    const tags = norm(item.g);
    const body = norm(item.d) + item.s;
    let total = 0;
    for (const t of terms) {
      if (name && name.startsWith(t)) total += 100;
      else if (name && name.includes(t)) total += 60;
      else if (title.includes(t)) total += 30;
      else if (hub.includes(t)) total += 20;
      else if (tags.includes(t)) total += 14;
      else if (body.includes(t)) total += 8;
      else return -1; // 全語を含むものだけ出す
    }
    return total;
  }

  const esc = (s) => String(s).replace(/[&<>"']/g, (c) =>
    ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

  function render(q) {
    const terms = norm(q).split(/[,、]/).filter(Boolean);
    if (!terms.length) {
      statusEl.textContent = '検索語を入力してください。';
      list.innerHTML = '';
      moreEl.hidden = true;
      return;
    }
    const hits = [];
    for (const item of index) {
      const s = score(item, terms);
      if (s > 0) hits.push([s, item]);
    }
    hits.sort((a, b) => b[0] - a[0] || a[1].t.localeCompare(b[1].t, 'ja'));

    if (!hits.length) {
      statusEl.textContent = `「${q}」に一致する記事は見つかりませんでした。`;
      list.innerHTML = '';
      moreEl.hidden = true;
      return;
    }
    statusEl.textContent = `「${q}」の検索結果：${hits.length}件`;
    list.innerHTML = hits.slice(0, LIMIT).map(([, it]) => `
      <li><a href="/media/${it.s}/">
        <span class="art-title">${esc(it.n || it.t)}</span>
        ${it.n ? `<span class="art-sub">${esc(it.t)}</span>` : ''}
        <span class="art-desc">${esc(it.d)}</span>
        <span class="art-meta"><span class="tag">${esc(it.c)}</span><span class="theme">${esc(it.h)}</span></span>
      </a></li>`).join('');
    if (hits.length > LIMIT) {
      moreEl.hidden = false;
      moreEl.textContent = `上位${LIMIT}件を表示しています。絞り込むには語を足してください（例：「コンサル 年収」）。`;
    } else {
      moreEl.hidden = true;
    }
  }

  let timer;
  function run(q) {
    statusEl.textContent = '検索中…';
    loadIndex()
      .then(() => render(q))
      .catch(() => { statusEl.textContent = '検索データを読み込めませんでした。時間をおいて再度お試しください。'; });
  }

  input.addEventListener('input', () => {
    clearTimeout(timer);
    const q = input.value.trim();
    if (!q) { render(''); return; }
    timer = setTimeout(() => run(q), 150);
  });

  document.getElementById('f').addEventListener('submit', (e) => {
    e.preventDefault();
    run(input.value.trim());
  });

  // /media/search/?q=... で来たときはその場で検索する
  const q0 = new URLSearchParams(location.search).get('q');
  if (q0) { input.value = q0; run(q0.trim()); }
  input.focus();
</script>

<style>
  .hub { max-width: 820px; margin: 0 auto; padding: 32px 20px 64px; line-height: 1.9; color: #24292f; }
  .breadcrumb { font-size: .85rem; color: #6b7684; display: flex; gap: .4em; }
  .breadcrumb a { color: #6b7684; }
  .hub h1 { font-size: 1.6rem; margin: .4em 0 .6em; }

  .media-search { display: flex; gap: 8px; }
  .media-search input { flex: 1; min-width: 0; padding: .7em 1em; font-size: .95rem;
    border: 1px solid #d8dde3; border-radius: 8px; background: #fff; color: #24292f; }
  .media-search input:focus { outline: 2px solid #1c1c2e; outline-offset: -1px; border-color: #1c1c2e; }
  .media-search button { padding: .7em 1.6em; font-size: .95rem; font-weight: 700; cursor: pointer;
    border: none; border-radius: 8px; background: #1c1c2e; color: #fff; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }

  .status { margin: 1.4em 0 .2em; font-size: .9rem; color: #57606a; font-weight: 600; }
  .fallback { margin-top: 2.4em; font-size: .88rem; color: #6b7480; }

  /* 検索結果はJSでinnerHTMLに流し込むため、Astroのスコープ属性が付かない。
     ここだけ :global() にしないとスタイルが当たらず、素のテキストで並んでしまう。 */
  .art-list { list-style: none; padding: 0; }
  #results :global(li) { border-bottom: 1px solid #eceff2; }
  #results :global(a) { display: block; padding: .85em .2em; text-decoration: none; color: inherit; }
  #results :global(a:hover) { background: #fafbfc; }
  #results :global(.art-title) { display: block; font-weight: 700; color: #1c1c2e; line-height: 1.6; }
  #results :global(a:hover .art-title) { text-decoration: underline; }
  #results :global(.art-sub) { display: block; font-size: .85rem; color: #454e59; margin-top: .1em; }
  #results :global(.art-desc) { margin-top: .25em; font-size: .87rem; color: #57606a; line-height: 1.75;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  #results :global(.art-meta) { display: flex; gap: .5em; margin-top: .45em; }
  #results :global(.tag), #results :global(.theme) { font-size: .74rem; border-radius: 4px; padding: 2px 8px; }
  #results :global(.tag) { background: #1c1c2e; color: #fff; }
  #results :global(.theme) { background: #f0f2f5; color: #6b7684; }
  .more { font-size: .85rem; color: #6b7480; margin-top: 1em; }
</style>
