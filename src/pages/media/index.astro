---
// src/pages/media/index.astro … メディアトップ
// カテゴリは src/lib/mediaTaxonomy.ts が決める（記事のfrontmatterから推測しない）
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import MediaSearchBox from '../../components/MediaSearchBox.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import LineCta from '../../components/LineCta.astro';
import { getMediaGroups } from '../../lib/mediaTaxonomy';
import { getTagGroups } from '../../lib/mediaTags';

const posts = await getCollection('media');
// M&Aニュース（適時開示の自動まとめ）。記事とは別コレクション
const news = await getCollection('news');
const newsLatest = news.length
  ? news.reduce((d, p) => (p.data.pubDate > d ? p.data.pubDate : d), new Date(0))
  : null;
const fmtDate = (d) => `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
const { jobGroups, industryGroups, companyHubs } = getMediaGroups(posts);
// タグはハブと直交する横断の分類。定義は src/lib/mediaTags.ts
const { groups: tagGroups } = getTagGroups(posts);
const tagTotal = tagGroups.reduce((n, g) => n + g.tags.length, 0);

const total = posts.length;
const companyTotal = companyHubs.reduce((n, c) => n + c.count, 0);

// 新着。pubDateが同日で並ぶので、同点はタイトル順にして毎回のビルドで並びが揺れないようにする
const latest = [...posts]
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
    || a.data.title.localeCompare(b.data.title, 'ja'))
  .slice(0, 8);

const title = 'キャリアメディア｜IT・SaaS・コンサル・M&A領域の転職情報';
const description =
  `IT・SaaS・コンサル・M&A領域の転職情報を${total}本の記事で解説。職種別・業界別の解説から、企業${companyTotal}社の評判・年収・選考対策まで、一次情報をもとにまとめています。`;
---

<Layout title={title} description={description}>
  <Header />
  <section class="hub">
    <h1>キャリアメディア</h1>
    <p class="hub-lead">
      IT・SaaS・コンサル・M&A領域の転職・キャリア情報を、<strong>{total.toLocaleString()}本</strong>の記事で解説しています。
      年収相場やキャリアパスから、企業ごとの評判・選考対策まで。数字は有価証券報告書などの一次情報をもとにしています。
    </p>

    <MediaSearchBox />

    <nav class="jump" aria-label="カテゴリ">
      <a href="#tag">タグから探す</a>
      <a href="#job">職種から探す</a>
      <a href="#industry">業界から探す</a>
      <a href="#company">企業から探す</a>
      <a href="#latest">新着記事</a>
      <a class="jump-alt" href="/media/ma-news/">M&Aニュース</a>
    </nav>

    <!-- ===== タグ ===== -->
    <h2 id="tag">タグから探す</h2>
    <p class="hub-note">
      職種・業界・企業をまたいで、テーマから探せます。「面接対策」「年収1000万円」「東証プライム上場」のように、
      いま知りたいことがはっきりしている場合はこちらが早いです（{tagTotal}タグ）。
    </p>
    {tagGroups.map((g) => (
      <div class="group">
        <h3>{g.name}<span class="group-count">{g.tags.length}タグ</span></h3>
        <p class="tag-note">{g.note}</p>
        <ul class="tag-cloud">
          {g.tags.map((t) => (
            <li>
              <a href={`/media/tag/${t.slug}/`} title={t.note}>
                {t.label}<span class="count">{t.count}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}

    <!-- ===== 職種 ===== -->
    <h2 id="job">職種から探す</h2>
    <p class="hub-note">職種ごとに、仕事内容・年収相場・キャリアパス・選考対策をまとめています。</p>
    {jobGroups.map((g) => (
      <div class="group">
        <h3>{g.name}<span class="group-count">{g.items.length}職種</span></h3>
        <ul class="cat-grid">
          {g.items.map((it) => (
            <li><a href={`/media/hub/${it.hub}/`}>{it.name}<span class="count">{it.count}</span></a></li>
          ))}
        </ul>
      </div>
    ))}

    <!-- ===== 業界 ===== -->
    <h2 id="industry">業界から探す</h2>
    <p class="hub-note">業界の構造・市場動向・そこで求められる人材像から解説しています。</p>
    {industryGroups.map((g) => (
      <div class="group">
        <h3>{g.name}<span class="group-count">{g.items.length}業界</span></h3>
        <ul class="cat-grid">
          {g.items.map((it) => (
            <li><a href={`/media/hub/${it.hub}/`}>{it.name}<span class="count">{it.count}</span></a></li>
          ))}
        </ul>
      </div>
    ))}

    <!-- ===== 企業 ===== -->
    <h2 id="company">企業から探す</h2>
    <p class="hub-note">
      企業ごとの評判・年収・働き方・選考対策を、<strong>{companyTotal}社</strong>ぶん掲載しています。
      社名が決まっているなら<a href="/media/companies/">企業名の50音インデックス</a>が早いです。
    </p>
    <ul class="cat-grid wide">
      {companyHubs.map((c) => (
        <li>
          <a href={`/media/hub/${c.hub}/`}>
            <span class="c-name">{c.name}<span class="count">{c.count}社</span></span>
            <span class="c-note">{c.note}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="more"><a href="/media/companies/">企業名から探す（50音順・{companyTotal}社）→</a></p>

    <!-- ===== 新着 ===== -->
    <h2 id="latest">新着記事</h2>
    <ul class="art-list">
      {latest.map((p) => (
        <li>
          <a href={`/media/${p.slug}/`}>
            <img class="art-image" src={p.data.image ?? `/images/media/${p.slug}.png`} alt="" loading="lazy" decoding="async" width="1200" height="630" />
            <span class="art-body">
              <span class="art-title">{p.data.title}</span>
              <span class="art-desc">{p.data.description}</span>
              <span class="art-meta">
                <span class="tag">{p.data.category}</span>
                <span class="theme">{p.data.theme}</span>
              </span>
            </span>
          </a>
        </li>
      ))}
    </ul>

    <!-- ===== M&Aニュース ===== -->
    <!-- 適時開示の自動まとめ。記事とは毛色が違うので、カテゴリと並べず末尾に導線1本だけ置く -->
    {news.length > 0 && (
      <p class="news-link">
        <a href="/media/ma-news/">
          <span class="nl-label">M&Aニュース</span>
          <span class="nl-note">
            上場企業の適時開示から日次で自動更新（{news.length.toLocaleString()}件{newsLatest && ` ／ 最終更新 ${fmtDate(newsLatest)}`}）
          </span>
          <span class="nl-arrow">→</span>
        </a>
      </p>
    )}

    <ShareButtons title={title} label="このページをシェア" />

    <aside class="cta">
      <h2>キャリアの選択肢を、プロと整理しませんか</h2>
      <p>エージェントベストは、IT・スタートアップ・コンサル領域に特化した転職エージェントです。</p>
      <div class="cta-actions">
        <a href="https://calendly.com/r_matsuoka?utm_source=media&utm_medium=top" target="_blank" rel="noopener" class="cta-button">無料キャリア面談を予約する</a>
        <LineCta placement="media-top" variant="button" label="LINEで相談する" />
      </div>
      <p class="cta-sub">面談の前に、まずLINEで質問だけでも大丈夫です。</p>
    </aside>
  </section>
</Layout>

<style>
  .hub { max-width: 900px; margin: 0 auto; padding: 32px 20px 64px; line-height: 1.9; color: #24292f; }
  .hub h1 { font-size: 1.7rem; margin: .4em 0; }
  .hub h2 { font-size: 1.3rem; margin: 2.6em 0 .6em; padding: .35em .8em; border-left: 5px solid #1c1c2e; background: #f6f8fa; border-radius: 4px; scroll-margin-top: 80px; }
  .hub h3 { font-size: 1rem; margin: 1.6em 0 .5em; color: #1c1c2e; display: flex; align-items: baseline; gap: .6em; }
  .hub h3::before { content: ''; width: 3px; height: 1em; background: #4a5568; border-radius: 2px; }
  .group-count { font-size: .75rem; color: #6b7684; font-weight: 400; }
  .hub-lead { color: #454e59; }
  .hub-note { margin: -.2em 0 .8em; color: #6b7480; font-size: .92rem; }

  .jump { display: flex; flex-wrap: wrap; gap: 8px; margin: 1.4em 0 0; }
  .jump a { font-size: .85rem; padding: .35em 1em; border: 1px solid #d8dde3; border-radius: 999px; color: #384049; text-decoration: none; background: #fff; }
  .jump a:hover { border-color: #1c1c2e; }
  /* M&Aニュースは記事カテゴリではないので、同じ並びでも見た目で区別する */
  .jump a.jump-alt { border-style: dashed; color: #6b7684; }

  .tag-note { margin: -.2em 0 .6em; color: #6b7480; font-size: .85rem; }
  .tag-cloud { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 7px; }
  .tag-cloud a {
    display: inline-flex; align-items: baseline; gap: .45em;
    padding: .38em .95em; border: 1px solid #d8dde3; border-radius: 999px;
    background: #fff; color: #24292f; text-decoration: none; font-size: .88rem; font-weight: 600;
  }
  .tag-cloud a:hover { border-color: #1c1c2e; background: #1c1c2e; color: #fff; }
  .tag-cloud a:hover .count { color: #b9bfc9; }

  .cat-grid { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 8px; }
  .cat-grid li a {
    display: flex; justify-content: space-between; align-items: center; gap: .5em;
    padding: .7em .9em; border: 1px solid #e2e6ea; border-radius: 8px;
    color: #1c1c2e; text-decoration: none; font-weight: 600; background: #fff; font-size: .92rem;
  }
  .cat-grid li a:hover { border-color: #1c1c2e; background: #fafbfc; }
  .cat-grid.wide { grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); }
  .cat-grid.wide li a { flex-direction: column; align-items: flex-start; gap: .2em; }
  .c-name { display: flex; justify-content: space-between; width: 100%; align-items: baseline; }
  .c-note { font-size: .78rem; color: #6b7684; font-weight: 400; }
  .count { font-size: .78rem; color: #6b7684; font-weight: 400; }
  .more { margin: 1em 0 0; }
  .more a { font-weight: 600; color: #1c1c2e; text-decoration: none; }
  .more a:hover { text-decoration: underline; }

  .art-list { list-style: none; padding: 0; }
  .art-list li { border-bottom: 1px solid #eceff2; }
  .art-list a { display: grid; grid-template-columns: 180px minmax(0, 1fr); gap: 1em; align-items: center; padding: 1em .2em; text-decoration: none; color: inherit; }
  .art-image { display: block; width: 100%; height: auto; aspect-ratio: 1200 / 630; object-fit: cover; border-radius: 9px; background: #f0f2f5; }
  .art-body { min-width: 0; }
  .art-list a:hover { background: #fafbfc; }
  .art-title { display: block; font-weight: 700; color: #1c1c2e; line-height: 1.6; }
  .art-list a:hover .art-title { text-decoration: underline; }
  .art-desc { display: block; margin-top: .25em; font-size: .87rem; color: #57606a; line-height: 1.75;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .art-meta { display: flex; gap: .5em; margin-top: .45em; }
  .tag, .theme { font-size: .74rem; border-radius: 4px; padding: 2px 8px; }
  .tag { background: #1c1c2e; color: #fff; }
  .theme { background: #f0f2f5; color: #6b7684; }

  .cta { margin-top: 3rem; padding: 2rem 1.5rem; border-radius: 12px; background: #1c1c2e; color: #fff; text-align: center; }
  .cta h2 { background: none; border: none; color: #fff; padding: 0; margin: 0 0 .6em; }
  .cta p { color: #d5d9e0; }
  /* 面談予約（重）とLINE（軽）を並べる。迷った人が軽い方に流れる想定。 */
  .cta-actions { display: flex; flex-wrap: wrap; gap: .8rem; justify-content: center; align-items: center; margin-top: 1rem; }
  .cta-sub { margin: .9rem 0 0; font-size: .8rem; color: #a9b1bd; }
  @media (max-width: 480px) { .cta-actions { flex-direction: column; align-items: stretch; } .cta-actions .cta-button { text-align: center; } }
  .cta-button { display: inline-block; padding: .8rem 2.4rem; background: #fff; color: #1c1c2e; border-radius: 8px; text-decoration: none; font-weight: 700; }

  @media (max-width: 600px) {
    .cat-grid { grid-template-columns: 1fr 1fr; }
    .cat-grid.wide { grid-template-columns: 1fr; }
    .cat-grid li a { font-size: .85rem; padding: .6em .7em; }
    .art-list a { grid-template-columns: 116px minmax(0, 1fr); gap: .75em; }
    .art-desc { -webkit-line-clamp: 1; }
  }
</style>

<style is:global>
  /* M&Aニュースの導線。記事とは別コンテンツなので、末尾に控えめな1行だけ */
  .news-link { margin: 28px 0 0; }
  .news-link a {
    display: flex; align-items: baseline; gap: .7em; flex-wrap: wrap;
    padding: .85em 1.1em; border: 1px solid #e2e6ea; border-radius: 10px;
    background: #fafbfc; color: inherit; text-decoration: none;
  }
  .news-link a:hover { border-color: #1c1c2e; background: #fff; }
  .nl-label { font-weight: 700; color: #1c1c2e; font-size: .95rem; }
  .nl-note { font-size: .82rem; color: #6b7684; }
  .nl-arrow { margin-left: auto; color: #6b7684; }
</style>
