---
// src/pages/media/it-consultant/index.astro
// 職種ハブページ：ITコンサルタント
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

const posts = (await getCollection('media'))
  .filter((p) => p.data.jobType === 'ITコンサルタント')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const title = 'ITコンサルタントの転職情報まとめ｜年収・キャリアパス・面接対策';
const description = 'ITコンサルタントへの転職を検討する方向けの総合ガイド。年収相場・キャリアパス・志望動機・面接対策・未経験からのルートまで、実務目線で解説します。';
---

<Layout title={title} description={description}>
  <section class="hub">
    <p class="breadcrumb"><a href="/media">キャリアメディア</a> / 職種別ガイド</p>
    <h1>ITコンサルタントの転職情報</h1>
    <p class="hub-lead">
      ITコンサルタントの転職・キャリアに関する記事の一覧です。年収相場やキャリアパスといった全体像から、志望動機・職務経歴書・面接対策といった選考実務まで、検討フェーズに応じてご活用ください。
    </p>

    <h2>まず読みたい記事</h2>
    <ul class="hub-primary">
      <li><a href="/media/it-consultant-career-guide">ITコンサルタントの転職完全ガイド</a></li>
      <li><a href="/media/it-consultant-salary">年収相場【2026年版】</a></li>
      <li><a href="/media/it-consultant-career-path">キャリアパス｜30代でどこまで行けるか</a></li>
    </ul>

    <h2>すべての記事</h2>
    <ul class="hub-list">
      {posts.map((p) => (
        <li>
          <a href={`/media/${p.slug}`}>{p.data.title}</a>
          <span class="theme-tag">{p.data.theme}</span>
        </li>
      ))}
    </ul>

    <aside class="cta">
      <h2>ITコンサル領域の求人を見る</h2>
      <p>エージェントベストが扱うコンサルティング領域の求人一覧はこちらから。</p>
      <a href="/jobs?category=consultant&utm_source=media&utm_medium=hub" class="cta-button">求人一覧を見る</a>
    </aside>
  </section>
</Layout>


<style>
  .hub { max-width: 760px; margin: 0 auto; padding: 32px 20px 64px; line-height: 1.9; color: #24292f; }
  .hub .breadcrumb { font-size: .85rem; color: #6b7684; }
  .hub h1 { font-size: 1.6rem; margin: .4em 0; }
  .hub h2 { font-size: 1.25rem; margin: 2.2em 0 .8em; padding: .35em .8em; border-left: 5px solid #1c1c2e; background: #f6f8fa; border-radius: 4px; }
  .hub-lead { color: #454e59; }
  .hub-primary, .hub-list { list-style: none; padding: 0; }
  .hub-primary li, .hub-list li { padding: .7em .2em; border-bottom: 1px solid #eceff2; }
  .hub a { color: #1c1c2e; text-decoration: none; font-weight: 600; }
  .hub a:hover { text-decoration: underline; }
  .theme-tag { display: inline-block; margin-left: .6em; font-size: .78rem; color: #6b7684; background: #f0f2f5; border-radius: 4px; padding: 2px 8px; }
  .hub .cta { margin-top: 3rem; padding: 2rem 1.5rem; border-radius: 12px; background: #1c1c2e; color: #fff; text-align: center; }
  .hub .cta h2 { background: none; border: none; color: #fff; padding: 0; margin: 0 0 .6em; }
  .hub .cta p { color: #d5d9e0; }
  .hub .cta-button { display: inline-block; margin-top: 1rem; padding: .8rem 2.4rem; background: #fff; color: #1c1c2e; border-radius: 8px; text-decoration: none; font-weight: 700; }
</style>

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description: description,
})} />
