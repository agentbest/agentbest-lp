---
// src/pages/media/tag/[tag]/[...page].astro … タグごとの記事一覧
//
// ハブ一覧（/media/hub/...）と同じページング方式。
// 1ページ目のURLは /media/tag/{tag}/ のままで、2ページ目以降が /media/tag/{tag}/2/ になります。
//
// ハブが「1記事＝1ハブ」の縦の分類なのに対して、タグは横断です。
// たとえば /media/tag/interview/ には職種記事・業界記事・企業記事が混ざって並びます。
// そのぶん一覧では「どのカテゴリの記事か」が分かるようにカテゴリのラベルを出しています。
import { getCollection } from 'astro:content';
import Layout from '../../../../layouts/Layout.astro';
import Header from '../../../../components/Header.astro';
import MediaSearchBox from '../../../../components/MediaSearchBox.astro';
import ShareButtons from '../../../../components/ShareButtons.astro';
import LineCta from '../../../../components/LineCta.astro';
import { hubLabel, CATEGORY_LABEL } from '../../../../lib/mediaTaxonomy';
import { getTagGroups, tagSlugsOf, TAG_BY_SLUG } from '../../../../lib/mediaTags';

export async function getStaticPaths({ paginate }) {
  const posts = await getCollection('media');
  // live（＝MIN_TAG_POSTS 本以上あるタグ）だけを対象にする。
  // トップの一覧と同じ関数から取っているので、「載っているのに404」は起きない。
  const { groups } = getTagGroups(posts);

  const byTag = new Map<string, any[]>();
  for (const p of posts) {
    for (const s of tagSlugsOf(p)) {
      if (!byTag.has(s)) byTag.set(s, []);
      byTag.get(s)!.push(p);
    }
  }

  return groups.flatMap((g) =>
    g.tags.flatMap((t) => {
      const items = byTag.get(t.slug) ?? [];
      // カテゴリ（職種→業界→企業）でまとめてから、そのなかは記事名順。
      // 日付順にすると同じ日に量産した記事が固まって、一覧の頭が単調になる
      const catOrder = { 職種: 0, 業界: 1, 企業: 2 };
      const sorted = [...items].sort(
        (a, b) =>
          (catOrder[a.data.category] ?? 9) - (catOrder[b.data.category] ?? 9) ||
          a.data.title.localeCompare(b.data.title, 'ja'),
      );
      return paginate(sorted, {
        params: { tag: t.slug },
        props: { tagSlug: t.slug, total: items.length },
        pageSize: 40,
      });
    }),
  );
}

const { page, tagSlug, total } = Astro.props;
const tag = TAG_BY_SLUG.get(tagSlug)!;

// このサイトは末尾スラッシュあり（vercel.json の trailingSlash: true）。
// paginate が返すURLはスラッシュ無しなので、そのまま貼ると毎回308リダイレクトを踏む
const slash = (u?: string) => (u ? (u.endsWith('/') ? u : `${u}/`) : u);
const prevUrl = slash(page.url.prev);
const nextUrl = slash(page.url.next);

const pageSuffix = page.currentPage > 1 ? `（${page.currentPage}／${page.lastPage}ページ）` : '';
const title = `「${tag.label}」の記事一覧｜キャリアメディア${pageSuffix}`;
const description =
  `${tag.label}に関する記事${total}本の一覧です。${tag.note ? `${tag.note}。` : ''}職種・業界・企業をまたいで、同じテーマの記事をまとめています。`;
---

<Layout title={title} description={description}>
  <Header />
  <section class="hub">
    <nav class="breadcrumb" aria-label="パンくず">
      <a href="/media/">キャリアメディア</a>
      <span>/</span>
      <a href="/media/#tag">タグ</a>
      <span>/</span>
      <span>{tag.group}</span>
    </nav>

    <h1>{tag.label}</h1>
    <p class="hub-lead">
      「{tag.label}」のタグが付いた記事{total}本の一覧です。{tag.note && `${tag.note}。`}
      タグは職種・業界・企業をまたぐので、同じテーマの記事をカテゴリ横断で読めます。
    </p>

    <MediaSearchBox />

    <h2>
      すべての記事（{total}本）
      {page.lastPage > 1 && <span class="page-of">{page.currentPage}／{page.lastPage}ページ</span>}
    </h2>

    <ul class="art-list">
      {page.data.map((p) => (
        <li>
          <a href={`/media/${p.slug}/`}>
            <img class="art-image" src={p.data.image ?? `/images/media/${p.slug}.png`} alt="" loading="lazy" decoding="async" width="1200" height="630" />
            <span class="art-body">
              <span class="art-title">{p.data.title}</span>
              <span class="art-desc">{p.data.description}</span>
              <span class="art-meta">
                <span class="cat">{CATEGORY_LABEL[p.data.category] ?? p.data.category}</span>
                <span class="theme">{p.data.companyName ?? hubLabel(p.data.hub ?? '')}</span>
              </span>
            </span>
          </a>
        </li>
      ))}
    </ul>

    {page.lastPage > 1 && (
      <nav class="pager" aria-label="ページ送り">
        {prevUrl ? <a href={prevUrl} rel="prev">← 前へ</a> : <span class="disabled">← 前へ</span>}
        <span class="pager-now">{page.currentPage} / {page.lastPage}</span>
        {nextUrl ? <a href={nextUrl} rel="next">次へ →</a> : <span class="disabled">次へ →</span>}
      </nav>
    )}

    <p class="more"><a href="/media/#tag">ほかのタグから探す →</a></p>

    <ShareButtons title={title} label="このページをシェア" />

    <aside class="cta">
      <h2>キャリアの選択肢を、プロと整理しませんか</h2>
      <p>エージェントベストは、IT・スタートアップ・コンサル領域に特化した転職エージェントです。20〜30代のキャリア設計を、求人紹介の前段階からサポートします。</p>
      <div class="cta-actions">
        <a href="https://calendly.com/r_matsuoka?utm_source=media&utm_medium=tag" target="_blank" rel="noopener" class="cta-button">無料キャリア面談を予約する</a>
        <LineCta placement="media-tag" variant="button" label="LINEで相談する" />
      </div>
      <p class="cta-sub">面談の前に、まずLINEで質問だけでも大丈夫です。</p>
    </aside>
  </section>
</Layout>

<style>
  .hub { max-width: 820px; margin: 0 auto; padding: 32px 20px 64px; line-height: 1.9; color: #24292f; }
  .breadcrumb { font-size: .85rem; color: #6b7684; display: flex; flex-wrap: wrap; gap: .4em; }
  .breadcrumb a { color: #6b7684; }
  .hub h1 { font-size: 1.6rem; margin: .4em 0; }
  .hub h2 { font-size: 1.25rem; margin: 2.2em 0 .8em; padding: .35em .8em; border-left: 5px solid #1c1c2e; background: #f6f8fa; border-radius: 4px; display: flex; justify-content: space-between; align-items: baseline; gap: .6em; }
  .page-of { font-size: .78rem; color: #6b7684; font-weight: 400; }
  .hub-lead { color: #454e59; }

  .art-list { list-style: none; padding: 0; margin: .4em 0 0; }
  .art-list li { border-bottom: 1px solid #eceff2; }
  .art-list a { display: grid; grid-template-columns: 180px minmax(0, 1fr); gap: 1em; align-items: center; padding: 1em .2em; text-decoration: none; color: inherit; }
  .art-image { display: block; width: 100%; height: auto; aspect-ratio: 1200 / 630; object-fit: cover; border-radius: 9px; background: #f0f2f5; }
  .art-body { min-width: 0; }
  .art-list a:hover { background: #fafbfc; }
  .art-title { display: block; font-weight: 700; color: #1c1c2e; line-height: 1.6; }
  .art-list a:hover .art-title { text-decoration: underline; }
  .art-desc { display: block; margin-top: .25em; font-size: .87rem; color: #57606a; line-height: 1.75;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .art-meta { display: flex; gap: .5em; margin-top: .45em; }
  .cat, .theme { font-size: .74rem; border-radius: 4px; padding: 2px 8px; }
  .cat { background: #1c1c2e; color: #fff; }
  .theme { background: #f0f2f5; color: #6b7684; }

  .pager { display: flex; align-items: center; justify-content: center; gap: 1.2em; margin: 2.4em 0 0; font-size: .9rem; }
  .pager a { color: #1c1c2e; font-weight: 700; text-decoration: none; padding: .5em 1.2em; border: 1px solid #d8dde3; border-radius: 8px; }
  .pager a:hover { border-color: #1c1c2e; background: #fafbfc; }
  .pager .disabled { color: #b6bcc4; padding: .5em 1.2em; border: 1px solid #eceff2; border-radius: 8px; }
  .pager-now { color: #6b7684; }

  .more { margin: 1.6em 0 0; }
  .more a { font-weight: 600; color: #1c1c2e; text-decoration: none; }
  .more a:hover { text-decoration: underline; }

  .cta { margin-top: 3rem; padding: 2rem 1.5rem; border-radius: 12px; background: #1c1c2e; color: #fff; text-align: center; }
  .cta h2 { background: none; border: none; color: #fff; padding: 0; margin: 0 0 .6em; display: block; }
  .cta p { color: #d5d9e0; }
  /* 面談予約（重）とLINE（軽）を並べる。迷った人が軽い方に流れる想定。 */
  .cta-actions { display: flex; flex-wrap: wrap; gap: .8rem; justify-content: center; align-items: center; margin-top: 1rem; }
  .cta-sub { margin: .9rem 0 0; font-size: .8rem; color: #a9b1bd; }
  @media (max-width: 480px) { .cta-actions { flex-direction: column; align-items: stretch; } .cta-actions .cta-button { text-align: center; } }
  .cta-button { display: inline-block; padding: .8rem 2.4rem; background: #fff; color: #1c1c2e; border-radius: 8px; text-decoration: none; font-weight: 700; }

  @media (max-width: 600px) {
    .art-list a { grid-template-columns: 116px minmax(0, 1fr); gap: .75em; }
    .art-desc { -webkit-line-clamp: 1; }
  }
</style>
