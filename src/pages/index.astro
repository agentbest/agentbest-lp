---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ShareButtons from '../components/ShareButtons.astro';
import { getArticleCount } from '../lib/mediaCount';
import { jobsUrl, SHINSOTSU_URL } from '../lib/jobsLink';
import { FAQS, faqSchema } from '../lib/faq';

import FooterSites from '../components/FooterSites.astro';

// 記事本数は手打ちにしない（古い数字が残るため）。定義は src/lib/mediaCount.ts
const article = await getArticleCount();
const domains = [
  { en: 'IT', jp: 'パッケージベンダー・SIer・Web系事業会社' },
  { en: 'Startup', jp: 'AI・SaaS・HR Tech' },
  { en: 'M&A', jp: 'アドバイザリー・仲介・FAS' },
  { en: 'Consulting', jp: '戦略・IT・業務コンサル' },
];

const strengths = [
  {
    no: '01',
    title: '領域を、絞る。',
    body: '広く扱うほど、一社一社への理解は薄くなります。エージェントベストは専門領域を絞り込むことで、企業の中身を深く理解し、提案の精度を高めています。',
  },
  {
    no: '02',
    title: '一人が、一貫して。',
    body: '入口のご相談から、求人提案、選考、意思決定まで。担当が途中で変わることはありません。あなたの判断材料を最もよく知る一人が、最後まで伴走します。',
  },
  {
    no: '03',
    title: '若手ハイクラスに、専念する。',
    body: '20代・30代のキャリア判断に必要なのは、求人の量ではなく、市場価値を引き上げる確かな選択肢です。次の10年を決める一手だけを、お渡しします。',
  },
  {
    no: '04',
    title: '隠れた優良企業を、見極める。',
    body: '広く知られた企業だけが、最適な選択肢とは限りません。領域を深く理解しているからこそ、まだ表に出ていない企業まで見極め、名前ではなく中身で確かな一社をご紹介できます。',
  },
];

/* === 転職支援事例：以下はサンプルです。実際の匿名化事例に差し替えてください === */
const cases = [
  {
    age: '20代前半',
    from: '大手メーカー（営業）',
    to: 'M&Aアドバイザリー',
    role: '第二新卒 → アソシエイト',
    point: '若いうちに勝負する',
    body: '年次で役割が決まる環境から、案件の成果がそのまま評価になる場所へ。第二新卒での挑戦を選びました。',
  },
  {
    age: '30代前半',
    from: '大手SIer（PM）',
    to: 'SaaSスタートアップ',
    role: 'PM → プロダクトマネージャー',
    point: '働き方を変える',
    body: '決まった要件を守り切るPMから、何を作るかを決めるPMへ。年収ではなく、決められる範囲と進め方の速さを基準に選びました。',
  },
  {
    age: '30代前半',
    from: '大手事業会社（エンジニア）',
    to: 'M&A仲介',
    role: 'エンジニア → コンサルタント',
    point: '個人の力を試す',
    body: '会社の看板で動く仕事から、自分の名前で案件を任される仕事へ。個人の実力がどこまで通用するかを確かめる転職です。',
  },
  {
    age: '20代後半',
    from: '小売（販売職）',
    to: '人材紹介会社',
    role: '販売職 → キャリアアドバイザー',
    point: '職種を変える',
    body: '店頭で人に向き合ってきた経験を、そのままキャリア支援へ。年収の上げ幅よりも、長く続けたい仕事に移ることを優先しました。',
  },
];

const process = [
  { no: '01', title: 'ご相談・キャリア整理', body: '現状と志向を伺い、市場のなかでの立ち位置と選択肢を一緒に整理します。' },
  { no: '02', title: '領域を絞った求人提案', body: '専門領域の理解にもとづき、合致度の高い求人だけを厳選してご提案します。' },
  { no: '03', title: '応募・選考の伴走', body: '推薦・日程調整・面接対策・条件交渉まで、選考の各段階を支援します。' },
  { no: '04', title: '意思決定・入社後フォロー', body: '複数オファーの比較から入社後の立ち上がりまで、判断を伴走します。' },
];

// 構造化データ（Organization / WebSite / FAQPage）
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://www.agent-best.net/#organization',
  name: '株式会社エージェントベスト',
  alternateName: 'AGENT BEST',
  url: 'https://www.agent-best.net/',
  logo: 'https://www.agent-best.net/logo.png',
  description:
    'IT・スタートアップ・M&A・コンサル領域に特化した転職エージェント。20代・30代のハイクラス層に向けて、10年先から逆算した転職支援を行っています。',
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'JP',
    addressRegion: '東京都',
    addressLocality: '港区',
    streetAddress: '六本木4-8-7 嶋田ビル5階',
  },
  founder: {
    '@type': 'Person',
    name: '松岡 良次',
    url: 'https://www.agent-best.net/profile/',
  },
  knowsAbout: ['転職支援', 'IT業界', 'スタートアップ', 'コンサルティング業界', 'M&A業界', '採用支援'],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': 'https://www.agent-best.net/#website',
  url: 'https://www.agent-best.net/',
  name: '株式会社エージェントベスト',
  inLanguage: 'ja',
  publisher: { '@id': 'https://www.agent-best.net/#organization' },
};

// よくある質問。文面は src/lib/faq.ts が原本（/consultation と共有）
const faqStructuredData = faqSchema('https://www.agent-best.net/');
---

<Layout image="/ogp/home.png">
  <a id="top"></a>
  <Header />

  <main>
    <!-- ============ HERO ============ -->
    <section class="hero">
      <div class="hero-media" aria-hidden="true">
        <video
          class="hero-video"
          poster="/video/hero-poster.jpg"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
        >
          <source src="/video/hero-sp.mp4" type="video/mp4" media="(max-width: 700px)" />
          <source src="/video/hero.mp4" type="video/mp4" />
        </video>
        <div class="hero-scrim"></div>
      </div>
      <span class="hero-vlabel vertical" aria-hidden="true">20s &ndash; 30s High-Class Career</span>
      <div class="wrap hero-inner">
        <div class="hero-lede">
          <h1 class="hero-title">
            領域を絞った、<br />確かな提案。
          </h1>
          <p class="hero-sub">20代・30代のハイクラスキャリアに、戦略を。</p>
          <p class="hero-body">
            経験を積み始めた、いま。次の一社で、その先の10年が決まります。<br />
            扱う領域を絞り込むからこそ、一社一社を深く理解し、
            あなたの市場価値を最も引き上げる選択肢だけをお渡しします。
          </p>

          <div class="hero-index" aria-label="専門領域">
            <span class="hero-index-label">Focused on</span>
            <ul>
              {domains.map((d) => (<li><span class="idx-en">{d.en}</span></li>))}
            </ul>
            <span class="hero-index-foot">4 領域に専念</span>
          </div>

          <div class="hero-actions">
            <a href="/consultation/" class="btn btn--on-dark">
              転職相談をはじめる <span class="arrow" aria-hidden="true">→</span>
            </a>
            <a href="#domains" class="btn btn--ghost-on-dark">専門領域を見る</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ MISSION（縦書きシグネチャー） ============ -->
    <section class="mission" aria-labelledby="mission-h">
      <div class="wrap mission-grid">
        <div class="mission-side" aria-hidden="true">
          <span class="mission-vlabel vertical">MISSION</span>
        </div>
        <div class="mission-body reveal">
          <h2 id="mission-h" class="mission-text">
            日本に、<br />磁力を生む。
          </h2>
          <p class="mission-lead">
            いま、日本には磁力が足りない。
            経済は伸び悩み、世界の中での存在感は年々小さくなっている。
            国の力が弱まれば、人も、金も、面白いものも、この国を素通りしていく。
          </p>
          <p class="mission-lead">
            出ていくだけではない。
            この国で育った優秀な人が、日本にいながら、その力を海外の企業のために使っている。
            選ばれなかったのは、日本のほうだ。力の向かう先は、舞台の魅力で決まる。
          </p>
          <!-- 3段落目以降は畳む。トップの平均滞在は1分弱で、ミッション7段落を
               読み切る人はほとんどいない。全文は /company/ にもある。
               ⚠ JSでの出し分けにするとクローラに読まれないので details で畳む。 -->
          <details class="mission-more">
            <summary class="mission-more-btn">
              <span class="mission-more-open">ミッションの全文を読む</span>
              <span class="mission-more-close">閉じる</span>
              <span class="mission-more-caret" aria-hidden="true">↓</span>
            </summary>
            <div class="mission-more-body">
              <p class="mission-lead">
                魅力のある国には、人が集まる。
                だから私たちは、この国に磁力を生む。
              </p>
              <p class="mission-lead">
                磁力は、ひとつのもので生まれない。
                経済、技術、文化、暮らし。その全部が重なって、人を引きつける力になる。
                世界のどこででも活躍できる人が、それでもこの国を選ぶことがある。
                理由は条件ではない。この国でなければならない、と思わせる何かだ。
              </p>
              <p class="mission-lead">はじまりは、人だ。</p>
              <p class="mission-lead">
                どんな産業も、最初のひとりから動きだす。
                私たちが支援するのは、人のグロースであり、企業のグロースであり、その先にある国のグロースだ。
                成長する産業と、そこで勝負しようとする企業に、必要な人が届く線を引き続ける。
              </p>
              <p class="mission-lead">
                磁力は、経済だけでは生まれない。だから私たちは、その外側にも出ていく。
              </p>
              <p class="mission-lead">
                この国が育ててきた表現も、感性も、世界を惹きつける力になる。
                働く理由も、住む理由も、憧れる理由も、この国にある。
                日本にしかないものを、日本の強さに変える。
              </p>
            </div>
          </details>
          <p class="mission-sign">
            一人ずつ、一社ずつ。磁力は、その積み重ねでしか生まれない。
          </p>
        </div>
      </div>
    </section>

    <!-- ============ DOMAINS ============ -->
    <section id="domains" class="section domains spine">
      <div class="wrap">
        <header class="sec-head reveal">
          <span class="eyebrow">Domains</span>
          <h2>専門領域</h2>
          <p class="sec-desc">
            すべての業界を扱うことはしません。深く理解できる領域に、専念しています。
          </p>
        </header>
        <ul class="domain-grid reveal">
          {domains.map((d, i) => (
            <li class="domain-card">
              <span class="domain-no">{String(i + 1).padStart(2, '0')}</span>
              <span class="domain-en">{d.en}</span>
              <span class="domain-jp">{d.jp}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ============ JOBS 求人を探す ============
         求人サイトへの導線はヘッダーのドロップダウンだけで、本文からは1本も
         繋がっていなかった。「求人を見る」は相談フォームより手前に踏める
         唯一の低摩擦の入口なので、専門領域のすぐ下に置いている。 -->
    <section id="jobs" class="section jobs">
      <div class="wrap">
        <header class="sec-head sec-head--center reveal">
          <span class="eyebrow">Jobs</span>
          <h2>求人を探す</h2>
          <p class="sec-desc">
            相談の前に、まずどんな求人があるかだけ見ていただいても構いません。掲載しているのは、私たちが事業と組織を直接確かめた企業だけです。
          </p>
        </header>
        <ul class="job-grid reveal">
          <li class="job-card">
            <span class="job-card-label">キャリア採用</span>
            <h3 class="job-card-title">中途採用の求人</h3>
            <p class="job-card-body">
              IT・スタートアップ・M&amp;A・コンサルの4領域から、職種・年収・働き方で絞り込めます。会員登録なしでそのまま閲覧できます。
            </p>
            <a
              class="job-card-link"
              href={jobsUrl({ medium: 'top-jobs' })}
              target="_blank"
              rel="noopener"
            >求人を見る <span class="arrow" aria-hidden="true">→</span></a>
          </li>
          <li class="job-card">
            <span class="job-card-label">就活・長期インターン</span>
            <h3 class="job-card-title">新卒・インターンの求人</h3>
            <p class="job-card-body">
              学生の方はこちら。新卒採用と長期インターンの募集を、同じ4領域からまとめています。
            </p>
            <a
              class="job-card-link"
              href={`${SHINSOTSU_URL}?utm_source=corporate&utm_medium=top-jobs`}
              target="_blank"
              rel="noopener"
            >新卒の求人を見る <span class="arrow" aria-hidden="true">→</span></a>
          </li>
        </ul>
      </div>
    </section>

    <!-- ============ HIDDEN GEMS 隠れた優良企業 ============ -->
    <section class="section gems">
      <div class="wrap gems-grid">
        <div class="gems-side" aria-hidden="true">
          <span class="gems-vlabel vertical">Hidden Gems</span>
        </div>
        <div class="gems-body reveal">
          <h2 class="gems-title">
            まだ知られていない、<br />
            確かな一社を。
          </h2>
          <p class="gems-lead">
            キャリアの早い段階だからこそ、本当に必要なのは求人の数ではなく、10年先から逆算した、確かな一手です。けれど求人サイトや総合型エージェントに並ぶのは、すでに名前の知られた企業が中心です。知名度は、その企業が自分に合うかどうかとは別の話。名前を知らないという理由だけで検討に値する一社が視界の外にあるなら、それは選ぶ前に選択肢が欠けている状態です。
          </p>
          <p class="gems-lead">
            だから私たちは、領域を絞ります。扱う世界を狭くするほど、一社の解像度は上がり、差し出せる提案は確かになる。経営者や事業の実態まで踏み込んで理解しているからこそ、名前ではなく中身で確かな一社を見極められます。表には出てきにくい、これから伸びる優良企業を、根拠とともにご紹介します。
          </p>
          <p class="gems-lead">
            私たちが扱うのは、コンサルティング、M&amp;A、スタートアップ、IT。いま憧れが集まっている領域です。人が仕事を選ぶとき、条件と同じくらい、その仕事に惹かれるかどうかが効きます。憧れられる仕事はあるのに、その受け皿となる会社が知られていない。私たちが埋めたいのは、この隙間です。力のある人がそこで伸びていけば、その積み重ねが日本の磁力になっていきます。
          </p>
          <p class="gems-sign">
            最初のキャリア戦略は、人生の意思決定。<br />
            その重みに見合う精度で、向き合います。
          </p>
        </div>
      </div>
    </section>

    <!-- ============ AUDIENCE ============ -->
    <section id="audience" class="section audience">
      <div class="wrap audience-grid">
        <div class="audience-head reveal">
          <span class="eyebrow">For</span>
          <h2>対象となる方</h2>
        </div>
        <div class="audience-body reveal" data-delay="1">
          <p class="audience-headline">20代・30代で、<br />すでに走り始めている方へ。</p>
          <p class="audience-lead">ここ数年で、確かな手応えをつかんだ。次は、その経験を「戦略的な一手」に変えるとき。一段上のキャリアを見据える方の伴走者でありたいと考えています。</p>
          <ul class="audience-list">
            <li>自分の時間を懸ける環境に、まだ出会えていない方</li>
            <li>組織の名ではなく、自らの力量が問われる場に立ちたい方</li>
            <li>結果を出しながら、いまの環境を持て余している方</li>
            <li>目先の一社ではなく、10年先から逆算して選びたい方</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ============ STRENGTHS ============ -->
    <section id="strengths" class="section strengths spine">
      <div class="wrap">
        <header class="sec-head reveal">
          <span class="eyebrow">Why Agent Best</span>
          <h2>選ばれる理由</h2>
        </header>
        <div class="strength-rows">
          {strengths.map((s) => (
            <article class="strength-row reveal">
              <span class="strength-no">{s.no}</span>
              <div class="strength-text">
                <h3>{s.title}</h3>
                <p>{s.body}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ CASES 転職支援事例（※サンプル。実データに差し替え） ============ -->
    <section class="section cases">
      <div class="wrap">
        <header class="sec-head sec-head--center reveal">
          <span class="eyebrow">Cases</span>
          <h2>転職支援事例</h2>
          <p class="sec-desc">年収の上げ幅だけでなく、役割や働き方そのものを変えた例です。</p>
        </header>
        <ul class="case-grid">
          {cases.map((c) => (
            <li class="case-card reveal">
              <span class="case-age">{c.age}</span>
              <div class="case-move">
                <span class="case-from">{c.from}</span>
                <span class="case-arrow" aria-hidden="true">→</span>
                <span class="case-to">{c.to}</span>
              </div>
              <p class="case-role">{c.role}</p>
              <div class="case-point">
                <span class="case-point-label">{c.point}</span>
                <p class="case-point-body">{c.body}</p>
              </div>
            </li>
          ))}
        </ul>
        <p class="case-note">※ 掲載事例は個人が特定されないよう一部を加工しています。</p>
      </div>
    </section>

    <!-- ============ PROCESS ============ -->
    <section id="process" class="section process">
      <div class="wrap">
        <header class="sec-head sec-head--center reveal">
          <span class="eyebrow">Process</span>
          <h2>支援の流れ</h2>
          <p class="sec-desc">ご相談から入社後まで、ひとつながりで伴走します。</p>
        </header>
        <ol class="process-track reveal">
          {process.map((p) => (
            <li class="process-step">
              <span class="process-no">{p.no}</span>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ============ FAQ ============
         文面は src/lib/faq.ts が原本。/consultation と共有している。 -->
    <section id="faq" class="section faq spine">
      <div class="wrap">
        <header class="sec-head sec-head--center reveal">
          <span class="eyebrow">FAQ</span>
          <h2>よくあるご質問</h2>
          <p class="sec-desc">ご相談の前に、よくいただく質問をまとめています。</p>
        </header>
        <ul class="faq-list reveal">
          {FAQS.map((f) => (
            <li class="faq-item">
              <details>
                <summary>
                  <span class="faq-q">{f.q}</span>
                  <span class="faq-mark" aria-hidden="true"></span>
                </summary>
                <p class="faq-a">{f.a}</p>
              </details>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ============ CTA ============ -->
    <section id="contact" class="cta">
      <div class="wrap cta-inner reveal">
        <span class="eyebrow eyebrow--on-dark">Contact</span>
        <h2 class="cta-title">確かな一社を、一緒に。</h2>
        <p class="cta-body">
          まずはお気軽にご相談ください。現職中・情報収集の段階でも構いません。<br />
          キャリアの選択肢を、領域のプロと一緒に整理しましょう。
        </p>
        <div class="cta-actions">
          <a href="/consultation/" class="btn btn--on-dark">
            相談フォームへ <span class="arrow" aria-hidden="true">→</span>
          </a>
          <a href="https://calendly.com/r_matsuoka" target="_blank" rel="noopener" class="cta-alt-link">
            先に日程を決めたい方はこちら
          </a>
        </div>
        <p class="cta-note">オンラインで30分ほど。応募したい求人が決まっていなくても構いません。</p>
