---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ShareButtons from '../components/ShareButtons.astro';

import FooterSites from '../components/FooterSites.astro';
const domains = [
  { en: 'IT', jp: 'ソフトウェア・インフラ・SI' },
  { en: 'Startup', jp: 'SaaS・自社プロダクト企業' },
  { en: 'M&A', jp: 'アドバイザリー・仲介' },
  { en: 'Consulting', jp: '戦略・IT・業務コンサル' },
];

const strengths = [
  {
    no: '01',
    title: '領域を、絞る。',
    body: '広く扱うほど、一社一社への理解は薄くなります。エージェントベストは専門領域を絞り込むことで、企業の中身を深く理解し、提案の精度を高めています。',
  },
  {
    no: '02',
    title: '一人が、一貫して。',
    body: '入口のご相談から、求人提案、選考、意思決定まで。担当が途中で変わることはありません。あなたの判断材料を最もよく知る一人が、最後まで伴走します。',
  },
  {
    no: '03',
    title: '若手ハイクラスに、専念する。',
    body: '20代・30代のキャリア判断に必要なのは、求人の量ではなく、市場価値を引き上げる確かな選択肢です。次の10年を決める一手だけを、お渡しします。',
  },
  {
    no: '04',
    title: '隠れた優良企業を、見極める。',
    body: '広く知られた企業だけが、最適な選択肢とは限りません。領域を深く理解しているからこそ、まだ表に出ていない優良スタートアップまで見極め、名前ではなく中身で確かな一社をご紹介できます。',
  },
];

/* === 転職支援事例：以下はサンプルです。実際の匿名化事例に差し替えてください === */
const cases = [
  { age: '20代後半', from: '大手SIer', to: 'SaaSスタートアップ', role: 'エンジニア → テックリード', salary: '750万', up: '＋150万' },
  { age: '30代前半', from: '事業会社（企画）', to: 'SaaS企業', role: '企画 → プロダクトマネージャー', salary: '800万', up: '＋200万' },
  { age: '30代前半', from: 'コンサルファーム', to: 'M&Aアドバイザリー', role: 'アナリスト → アソシエイト', salary: '900万', up: '＋250万' },
  { age: '20代後半', from: '受託開発', to: '自社プロダクト企業', role: 'エンジニア → エンジニア', salary: '600万', up: '＋120万' },
];

const process = [
  { no: '01', title: 'ご相談・キャリア整理', body: '現状と志向を伺い、市場のなかでの立ち位置と選択肢を一緒に整理します。' },
  { no: '02', title: '領域を絞った求人提案', body: '専門領域の理解にもとづき、合致度の高い求人だけを厳選してご提案します。' },
  { no: '03', title: '応募・選考の伴走', body: '推薦・日程調整・面接対策・条件交渉まで、選考の各段階を支援します。' },
  { no: '04', title: '意思決定・入社後フォロー', body: '複数オファーの比較から入社後の立ち上がりまで、判断を伴走します。' },
];

const company = [
  { k: '会社名', v: '株式会社エージェントベスト' },
  { k: '代表者', v: '代表取締役　松岡 良次' },
  { k: '所在地', v: '東京都港区六本木4-8-7　嶋田ビル5階' },
  { k: '事業内容', v: '有料職業紹介事業／採用支援（RPO）' },
  { k: '許可番号', v: '13-ユ-316964' },
];

// 構造化データ（Organization / WebSite）
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://www.agent-best.net/#organization',
  name: '株式会社エージェントベスト',
  alternateName: 'AGENT BEST',
  url: 'https://www.agent-best.net/',
  logo: 'https://www.agent-best.net/favicon.svg',
  description:
    'IT・スタートアップ・M&A・コンサル領域に特化した転職エージェント。20代・30代のハイクラス層に向けて、10年先から逆算した転職支援を行っています。',
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'JP',
    addressRegion: '東京都',
    addressLocality: '港区',
    streetAddress: '六本木4-8-7 嶋田ビル5階',
  },
  founder: {
    '@type': 'Person',
    name: '松岡 良次',
    url: 'https://www.agent-best.net/profile/',
  },
  knowsAbout: ['転職支援', 'IT業界', 'スタートアップ', 'コンサルティング業界', 'M&A業界', '採用支援'],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': 'https://www.agent-best.net/#website',
  url: 'https://www.agent-best.net/',
  name: '株式会社エージェントベスト',
  inLanguage: 'ja',
  publisher: { '@id': 'https://www.agent-best.net/#organization' },
};
---

<Layout>
  <a id="top"></a>
  <Header />

  <main>
    <!-- ============ HERO ============ -->
    <section class="hero">
      <div class="hero-media" aria-hidden="true">
        <video
          class="hero-video"
          poster="/video/hero-poster.jpg"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
        >
          <source src="/video/hero-sp.mp4" type="video/mp4" media="(max-width: 700px)" />
          <source src="/video/hero.mp4" type="video/mp4" />
        </video>
        <div class="hero-scrim"></div>
      </div>
      <span class="hero-vlabel vertical" aria-hidden="true">20s &ndash; 30s High-Class Career</span>
      <div class="wrap hero-inner">
        <div class="hero-lede">
          <span class="eyebrow">Recruiting Agency</span>
          <h1 class="hero-title">
            領域を絞った、<br />確かな提案。
          </h1>
          <p class="hero-sub">20代・30代のハイクラスキャリアに、戦略を。</p>
          <p class="hero-body">
            経験を積み始めた、いま。次の一社で、その先の10年が決まります。<br />
            扱う領域を絞り込むからこそ、一社一社を深く理解し、
            あなたの市場価値を最も引き上げる選択肢だけをお渡しします。
          </p>

          <div class="hero-index" aria-label="専門領域">
            <span class="hero-index-label">Focused on</span>
            <ul>
              {domains.map((d) => (<li><span class="idx-en">{d.en}</span></li>))}
            </ul>
            <span class="hero-index-foot">4 領域に専念</span>
          </div>

          <div class="hero-actions">
            <a href="/consultation/" class="btn btn--on-dark">
              転職相談をはじめる <span class="arrow" aria-hidden="true">→</span>
            </a>
            <a href="#domains" class="btn btn--ghost-on-dark">専門領域を見る</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ VISION（縦書きシグネチャー） ============ -->
    <section class="vision" aria-labelledby="vision-h">
      <div class="wrap vision-grid">
        <div class="vision-side" aria-hidden="true">
          <span class="vision-vlabel vertical">VISION</span>
        </div>
        <div class="vision-body reveal">
          <h2 id="vision-h" class="vision-text">
            最適な一社は、<br />
            選択肢の多さの先にはない。
          </h2>
          <p class="vision-lead">
            キャリアの早い段階だからこそ、本当に必要なのは
            求人の数ではなく、10年先から逆算した、確かな一手です。
          </p>
          <p class="vision-lead">
            だから私たちは、領域を絞ります。扱う世界を狭くするほど、
            一社の解像度は上がり、差し出せる提案は確かになる。
          </p>
          <p class="vision-sign">
            最初のキャリア戦略は、人生の意思決定。<br />
            その重みに見合う精度で、向き合います。
          </p>
        </div>
      </div>
    </section>

    <!-- ============ DOMAINS ============ -->
    <section id="domains" class="section domains spine">
      <div class="wrap">
        <header class="sec-head reveal">
          <span class="eyebrow">Domains</span>
          <h2>専門領域</h2>
          <p class="sec-desc">
            すべての業界を扱うことはしません。深く理解できる領域に、専念しています。
          </p>
        </header>
        <ul class="domain-grid reveal">
          {domains.map((d, i) => (
            <li class="domain-card">
              <span class="domain-no">{String(i + 1).padStart(2, '0')}</span>
              <span class="domain-en">{d.en}</span>
              <span class="domain-jp">{d.jp}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ============ HIDDEN GEMS 隠れた優良企業 ============ -->
    <section class="section gems">
      <div class="wrap gems-grid">
        <div class="gems-side" aria-hidden="true">
          <span class="gems-vlabel vertical">Hidden Gems</span>
        </div>
        <div class="gems-body reveal">
          <h2 class="gems-title">
            まだ知られていない、<br />
            確かな一社を。
          </h2>
          <p class="gems-lead">
            求人サイトや総合型エージェントに並ぶのは、すでに名前の知られた企業が中心です。けれど20代・30代の市場価値を大きく引き上げるのは、まだ広く知られていない優良スタートアップとの出会いであることも少なくありません。
          </p>
          <p class="gems-lead">
            領域を絞り、経営者や事業の実態まで踏み込んで理解しているからこそ、名前ではなく中身で確かな一社を見極められます。表には出てきにくい、これから伸びる優良企業を、根拠とともにご紹介します。
          </p>
        </div>
      </div>
    </section>

    <!-- ============ AUDIENCE ============ -->
    <section id="audience" class="section audience">
      <div class="wrap audience-grid">
        <div class="audience-head reveal">
          <span class="eyebrow">For</span>
          <h2>対象となる方</h2>
        </div>
        <div class="audience-body reveal" data-delay="1">
          <p class="audience-headline">20代・30代で、<br />すでに走り始めている方へ。</p>
          <p class="audience-lead">ここ数年で、確かな手応えをつかんだ。次は、その経験を「戦略的な一手」に変えるとき。一段上のキャリアを見据える方の伴走者でありたいと考えています。</p>
          <ul class="audience-list">
            <li>専門領域で結果を出し、次の成長角度を上げたい方</li>
            <li>求人の多さより、提案の確かさを求める方</li>
            <li>目先ではなく、10年先から逆算してキャリアを選びたい方</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ============ STRENGTHS ============ -->
    <section id="strengths" class="section strengths spine">
      <div class="wrap">
        <header class="sec-head reveal">
          <span class="eyebrow">Why Agent Best</span>
          <h2>選ばれる理由</h2>
        </header>
        <div class="strength-rows">
          {strengths.map((s) => (
            <article class="strength-row reveal">
              <span class="strength-no">{s.no}</span>
              <div class="strength-text">
                <h3>{s.title}</h3>
                <p>{s.body}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ CASES 転職支援事例（※サンプル。実データに差し替え） ============ -->
    <section class="section cases">
      <div class="wrap">
        <header class="sec-head sec-head--center reveal">
          <span class="eyebrow">Cases</span>
          <h2>転職支援事例</h2>
          <p class="sec-desc">領域を絞った提案が、確かな意思決定につながった例です。</p>
        </header>
        <ul class="case-grid">
          {cases.map((c) => (
            <li class="case-card reveal">
              <span class="case-age">{c.age}</span>
              <div class="case-move">
                <span class="case-from">{c.from}</span>
                <span class="case-arrow" aria-hidden="true">→</span>
                <span class="case-to">{c.to}</span>
              </div>
              <p class="case-role">{c.role}</p>
              <div class="case-salary">
                <span class="case-sal-num">{c.salary}</span>
                <span class="case-sal-up">{c.up}</span>
              </div>
            </li>
          ))}
        </ul>
        <p class="case-note">※ 掲載事例は個人が特定されないよう一部を加工しています。</p>
      </div>
    </section>

    <!-- ============ PROCESS ============ -->
    <section id="process" class="section process">
      <div class="wrap">
        <header class="sec-head sec-head--center reveal">
          <span class="eyebrow">Process</span>
          <h2>支援の流れ</h2>
          <p class="sec-desc">ご相談から入社後まで、ひとつながりで伴走します。</p>
        </header>
        <ol class="process-track reveal">
          {process.map((p) => (
            <li class="process-step">
              <span class="process-no">{p.no}</span>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ============ CTA ============ -->
    <section id="contact" class="cta">
      <div class="wrap cta-inner reveal">
        <span class="eyebrow eyebrow--on-dark">Contact</span>
        <h2 class="cta-title">確かな一社を、一緒に。</h2>
        <p class="cta-body">
          まずはお気軽にご相談ください。現職中・情報収集の段階でも構いません。<br />
          キャリアの選択肢を、領域のプロと一緒に整理しましょう。
        </p>
        <div class="cta-actions">
          <a href="/consultation/" class="btn btn--on-dark">
            相談フォームへ <span class="arrow" aria-hidden="true">→</span>
          </a>
          <a href="https://calendly.com/r_matsuoka" target="_blank" rel="noopener" class="cta-alt-link">
            先に日程を決めたい方はこちら
          </a>
        </div>
        <p class="cta-note">オンラインで30分ほど。応募したい求人が決まっていなくても構いません。</p>
        <p class="cta-sub">採用・サービスに関する企業の方は <a href="/contact/">お問い合わせフォーム</a> から。</p>
      </div>
    </section>

    <!-- ============ COMPANY ============ -->
    <section id="company" class="section company spine">
      <div class="wrap company-grid">
        <header class="sec-head reveal">
          <span class="eyebrow">Company</span>
          <h2>会社概要</h2>
        </header>
        <div class="reveal" data-delay="1">
          <dl class="company-table">
            {company.map((row) => (
              <div class="company-row">
                <dt>{row.k}</dt>
                <dd>{row.v}</dd>
              </div>
            ))}
          </dl>
          <a href="/company/" class="company-more">
            ミッション・行動指針・代表メッセージ <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ============ MEDIA BANNER ============ -->
    <section class="section media-banner spine">
      <div class="wrap">
        <a href="/media/" class="media-banner-card reveal">
          <div class="media-banner-text">
            <span class="eyebrow">Career Media</span>
            <p class="media-banner-title">転職ノウハウを1,400記事以上公開中</p>
            <p class="media-banner-desc">職種別の年収相場・キャリアパス・選考対策を、代表・松岡が監修。IT・スタートアップ・コンサル領域の情報を体系的にまとめています。</p>
          </div>
          <span class="media-banner-link">記事を見る <span class="arrow" aria-hidden="true">→</span></span>
        </a>
      </div>
    </section>
    <div class="wrap">
      <ShareButtons
        title="株式会社エージェントベスト｜20代・30代ハイクラスのための転職エージェント"
        label="このページをシェア"
      />
    </div>
  </main>

  <!-- ============ FOOTER ============ -->
  <footer class="site-footer">
    <div class="wrap footer-inner">
      <div class="footer-brand">
        <span class="brand-mark" aria-hidden="true"></span>
        <span class="footer-name">AGENT&nbsp;BEST</span>
        <p class="footer-tag">20代・30代ハイクラスのための転職エージェント</p>
      </div>
      <p class="footer-meta">
        株式会社エージェントベスト　許可番号 13-ユ-316964<br />
        東京都港区六本木4-8-7　嶋田ビル5階
      </p>
      <nav class="footer-links" aria-label="キャリアメディア">
        <p class="footer-links-title"><a href="/media/">キャリアメディア</a></p>
        <div class="footer-links-cols">
          <ul>
            <li><a href="/media/hub/it-consultant/">ITコンサルの転職</a></li>
            <li><a href="/media/hub/saas-sales/">SaaS営業の転職</a></li>
            <li><a href="/media/hub/product-manager/">PdMの転職</a></li>
            <li><a href="/media/hub/backend-engineer/">エンジニアの転職</a></li>
          </ul>
          <ul>
            <li><a href="/media/hub/ai-industry/">生成AI業界研究</a></li>
            <li><a href="/media/hub/ma-industry/">M&A仲介業界研究</a></li>
            <li><a href="/media/hub/saas-industry/">SaaS業界研究</a></li>
            <li><a href="/media/">すべての記事</a></li>
          </ul>
        </div>
      </nav>
      <FooterSites />
    </div>
    <div class="wrap footer-base">
      <small>© {new Date().getFullYear()} Agent Best Inc.</small>
      <a href="/contact/" class="footer-contact-link">採用ご担当者さまはこちら</a>
    </div>
  </footer>

  <script>
    const els = document.querySelectorAll('.reveal');
    const mq = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (mq.matches || !('IntersectionObserver' in window)) {
      els.forEach((el) => el.classList.add('is-in'));
    } else {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
      els.forEach((el) => io.observe(el));
    }
  </script>

  <style>
    /* ---------- HERO ----------
       全面に動画を敷き、暗いスクリム越しに白いコピーを左寄せ・縦中央で載せる */
    .hero {
      position: relative;
      min-height: clamp(560px, 82vh, 860px);
      display: flex;
      align-items: center;
      overflow: hidden;
      color: var(--paper);
    }
    .hero-media { position: absolute; inset: 0; z-index: 0; overflow: hidden; }
    .hero-video {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 62% center; /* 人物を右に置き、左のコピー側を空ける */
    }
    /* インクネイビーのスクリム。左を濃くして本文の可読性を確保する */
    .hero-scrim {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(100deg,
          rgba(12, 19, 29, 0.86) 0%,
          rgba(12, 19, 29, 0.72) 38%,
          rgba(12, 19, 29, 0.5) 70%,
          rgba(12, 19, 29, 0.42) 100%),
        linear-gradient(to bottom,
          rgba(12, 19, 29, 0.5) 0%,
          rgba(12, 19, 29, 0.12) 34%,
          rgba(12, 19, 29, 0.12) 70%,
          rgba(12, 19, 29, 0.55) 100%);
    }
    .hero-vlabel {
      position: absolute;
      z-index: 1;
      top: clamp(40px, 8vw, 96px);
      right: clamp(10px, 2vw, 28px);
      font-size: 0.66rem;
      letter-spacing: 0.34em;
      color: rgba(255, 255, 255, 0.62);
      text-transform: uppercase;
    }
    .hero-inner { position: relative; z-index: 1; width: 100%; padding-block: clamp(72px, 10vw, 120px); }
    .hero-lede { max-width: 40rem; }
    .hero .eyebrow { color: rgba(255, 255, 255, 0.68); }
    .hero-title {
      font-size: clamp(2.7rem, 7vw, 4.8rem);
      font-weight: 700;
      line-height: 1.3;
      letter-spacing: 0.04em;
      margin-top: 1.3rem;
      text-shadow: 0 2px 24px rgba(8, 13, 20, 0.35);
    }
    .hero-sub {
      font-family: var(--font-display);
      font-size: clamp(1.05rem, 2.4vw, 1.4rem);
      color: rgba(255, 255, 255, 0.92);
      margin-top: 1.5rem;
      letter-spacing: 0.06em;
    }
    .hero-body {
      color: rgba(255, 255, 255, 0.8);
      margin-top: 1.9rem;
      max-width: 34em;
      font-size: 0.98rem;
    }
    .hero-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 2.4rem; }
    .btn--ghost-on-dark {
      background: transparent;
      color: var(--paper);
      border-color: rgba(255, 255, 255, 0.5);
    }
    .btn--ghost-on-dark:hover { background: var(--paper); color: var(--ink); border-color: var(--paper); }

    /* 専門領域は hired 型の数値バッジと同じ位置＝コピーとCTAのあいだに横一列で置く */
    .hero-index {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 12px 18px;
      margin-top: 2.4rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--hairline-on-dark);
    }
    .hero-index-label {
      font-size: 0.7rem; letter-spacing: 0.2em; text-transform: uppercase;
      color: rgba(255, 255, 255, 0.55);
    }
    .hero-index ul {
      list-style: none; margin: 0; padding: 0;
      display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 14px;
    }
    .hero-index li { display: flex; align-items: baseline; gap: 6px 14px; }
    .hero-index li + li::before {
      content: ""; width: 3px; height: 3px; border-radius: 50%;
      background: rgba(255, 255, 255, 0.4); transform: translateY(-4px);
    }
    .idx-en {
      font-family: var(--font-display); font-weight: 600; font-size: 1.02rem;
      letter-spacing: 0.05em; color: var(--paper);
    }
    .hero-index-foot { font-size: 0.78rem; letter-spacing: 0.08em; color: rgba(255, 255, 255, 0.62); }

    @media (max-width: 700px) {
      .hero { min-height: 520px; }
      .hero-vlabel { display: none; }
      /* スマホは映像を弱め、可読性を優先 */
      .hero-scrim { background: rgba(12, 19, 29, 0.72); }
    }

    /* ---------- VISION ---------- */
    .vision {
      background: var(--ink);
      color: var(--paper);
      padding-block: clamp(84px, 13vw, 168px);
    }
    .vision-grid {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: clamp(28px, 6vw, 80px);
      align-items: start;
    }
    .vision-side { display: flex; justify-content: center; padding-top: 0.4rem; }
    .vision-vlabel {
      font-family: var(--font-display);
      font-weight: 500;
      font-size: clamp(1rem, 2vw, 1.3rem);
      letter-spacing: 0.5em;
      color: #B7D9CF;
    }
    .vision-text {
      font-family: var(--font-display);
      font-weight: 500;
      font-size: clamp(1.7rem, 4.6vw, 3.2rem);
      line-height: 1.7;
      letter-spacing: 0.04em;
    }
    .vision-lead {
      color: #C7CCD4;
      margin-top: clamp(1.6rem, 3vw, 2.4rem);
      max-width: 38em;
      line-height: 2.1;
      font-weight: 300;
    }
    .vision-lead + .vision-lead { margin-top: 1.1rem; }
    .vision-sign {
      font-family: var(--font-display);
      color: #B7D9CF;
      margin-top: clamp(2rem, 4vw, 3rem);
      font-size: clamp(1.05rem, 2vw, 1.35rem);
      line-height: 1.9;
      letter-spacing: 0.04em;
    }

    /* ---------- shared section head ---------- */
    .sec-head { margin-bottom: clamp(40px, 6vw, 72px); }
    .sec-head h2 { font-size: clamp(1.7rem, 4vw, 2.5rem); margin-top: 1rem; letter-spacing: 0.04em; }
    .sec-desc { color: var(--slate); margin-top: 1rem; max-width: 36em; }
    .sec-head--center { text-align: center; }
    .sec-head--center .eyebrow { justify-content: center; }
    .sec-head--center .sec-desc { margin-inline: auto; }

    /* ---------- DOMAINS ---------- */
    .domain-grid {
      list-style: none; margin: 0; padding: 0; display: grid;
      grid-template-columns: repeat(1, 1fr);
      border-top: 1px solid var(--hairline); border-left: 1px solid var(--hairline);
    }
    @media (min-width: 600px) { .domain-grid { grid-template-columns: repeat(2, 1fr); } }
    .domain-card {
      position: relative;
      padding: clamp(26px, 3vw, 40px) clamp(22px, 2.4vw, 32px) clamp(30px, 3.4vw, 46px);
      border-right: 1px solid var(--hairline); border-bottom: 1px solid var(--hairline);
      transition: background .4s ease; overflow: hidden;
    }
    .domain-card::after {
      content: ""; position: absolute; left: 0; bottom: 0; width: 100%; height: 2px;
      background: var(--teal); transform: scaleX(0); transform-origin: left; transition: transform .4s ease;
    }
    .domain-card:hover { background: var(--paper-deep); }
    .domain-card:hover::after { transform: scaleX(1); }
    .domain-no { font-size: 0.72rem; letter-spacing: 0.16em; color: var(--slate-mute); }
    .domain-en {
      display: block; font-family: var(--font-display); font-weight: 700;
      font-size: clamp(1.5rem, 3vw, 2rem); margin-top: 1.4rem; letter-spacing: 0.03em;
    }
    .domain-jp { display: block; margin-top: 0.7rem; color: var(--slate); font-size: 0.88rem; }

    /* ---------- HIDDEN GEMS ---------- */
    .gems { border-bottom: 1px solid var(--hairline); }
    .gems-grid { display: grid; grid-template-columns: auto 1fr; gap: clamp(28px, 6vw, 80px); align-items: start; }
    .gems-side { display: flex; justify-content: center; padding-top: 0.3rem; }
    .gems-vlabel {
      font-family: var(--font-display); font-weight: 500;
      font-size: clamp(1rem, 2vw, 1.3rem); letter-spacing: 0.5em; color: var(--teal);
    }
    .gems-title {
      font-family: var(--font-display); font-weight: 500;
      font-size: clamp(1.7rem, 4.6vw, 3rem); line-height: 1.7; letter-spacing: 0.04em; color: var(--ink);
    }
    .gems-lead { color: var(--slate); margin-top: clamp(1.6rem, 3vw, 2.2rem); max-width: 40em; line-height: 2.05; }
    .gems-lead + .gems-lead { margin-top: 1.1rem; }

    /* ---------- AUDIENCE ---------- */
    .audience-grid { display: grid; gap: clamp(36px, 5vw, 64px); }
    @media (min-width: 860px) { .audience-grid { grid-template-columns: 0.7fr 1.3fr; align-items: start; } }
    .audience-headline {
      font-family: var(--font-display);
      font-weight: 600;
      font-size: clamp(1.5rem, 3.6vw, 2.3rem);
      line-height: 1.7;
      letter-spacing: 0.04em;
      color: var(--ink);
    }
    .audience-lead { color: var(--slate); font-size: 0.98rem; margin-top: 1.4rem; max-width: 32em; line-height: 1.95; }
    .audience-list { list-style: none; margin: 1.8rem 0 0; padding: 0; }
    .audience-list li { position: relative; padding: 0.9rem 0 0.9rem 1.6em; border-top: 1px solid var(--hairline); color: var(--slate); }
    .audience-list li::before {
      content: ""; position: absolute; left: 0; top: 1.45rem; width: 8px; height: 8px;
      border: 1.5px solid var(--teal); transform: rotate(45deg);
    }

    /* ---------- STRENGTHS ---------- */
    .strength-rows { display: grid; gap: 0; }
    .strength-row {
      display: grid; grid-template-columns: auto 1fr; gap: clamp(20px, 4vw, 56px);
      padding-block: clamp(32px, 4vw, 52px); border-top: 1px solid var(--hairline); align-items: start;
    }
    .strength-row:last-child { border-bottom: 1px solid var(--hairline); }
    .strength-no { font-family: var(--font-display); font-size: clamp(1.1rem, 2vw, 1.4rem); color: var(--teal); letter-spacing: 0.08em; padding-top: 0.2em; }
    .strength-text h3 { font-size: clamp(1.3rem, 2.6vw, 1.7rem); letter-spacing: 0.04em; }
    .strength-text p { margin-top: 1rem; color: var(--slate); max-width: 40em; }

    /* ---------- CASES ---------- */
    .cases { background: var(--paper-deep); }
    .case-grid {
      list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(16px, 2vw, 22px);
      grid-template-columns: 1fr;
    }
    @media (min-width: 680px) { .case-grid { grid-template-columns: 1fr 1fr; } }
    .case-card {
      background: var(--paper); border: 1px solid var(--hairline);
      padding: clamp(24px, 3vw, 34px); display: flex; flex-direction: column; gap: 0.9rem;
      transition: border-color .35s ease, transform .35s ease;
    }
    .case-card:hover { border-color: var(--teal); transform: translateY(-2px); }
    .case-age {
      align-self: flex-start; font-size: 0.74rem; letter-spacing: 0.12em; color: var(--teal);
      border: 1px solid var(--teal); border-radius: 999px; padding: 0.2em 0.9em;
    }
    .case-move { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5em; font-family: var(--font-display); font-size: clamp(1.05rem, 2.2vw, 1.3rem); letter-spacing: 0.02em; }
    .case-arrow { color: var(--teal); }
    .case-to { color: var(--ink); }
    .case-from { color: var(--slate); }
    .case-role { color: var(--slate); font-size: 0.86rem; }
    .case-salary { display: flex; align-items: baseline; gap: 0.8em; margin-top: auto; padding-top: 0.8rem; border-top: 1px solid var(--hairline); }
    .case-sal-num { font-family: var(--font-display); font-weight: 700; font-size: 1.5rem; }
    .case-sal-up { color: var(--teal); font-weight: 700; font-size: 0.95rem; letter-spacing: 0.04em; }
    .case-note { margin-top: clamp(24px, 3vw, 36px); font-size: 0.76rem; color: var(--slate-mute); text-align: center; }

    /* ---------- PROCESS ---------- */
    .process-track {
      list-style: none; margin: 0; padding: 0; display: grid; gap: 1px;
      grid-template-columns: 1fr; background: var(--hairline); border: 1px solid var(--hairline);
    }
    @media (min-width: 720px) { .process-track { grid-template-columns: repeat(2, 1fr); } }
    @media (min-width: 1000px) { .process-track { grid-template-columns: repeat(4, 1fr); } }
    .process-step { background: var(--paper); padding: clamp(26px, 3vw, 38px) clamp(22px, 2.4vw, 30px) clamp(34px, 4vw, 50px); }
    .process-no { font-family: var(--font-display); font-weight: 700; font-size: 1.5rem; color: var(--teal); }
    .process-step h3 { font-size: 1.08rem; margin-top: 1.2rem; line-height: 1.5; letter-spacing: 0.03em; }
    .process-step p { margin-top: 0.9rem; color: var(--slate); font-size: 0.88rem; }

    /* ---------- CTA ---------- */
    .cta { background: var(--ink); color: var(--paper); padding-block: clamp(80px, 12vw, 140px); }
    .eyebrow--on-dark { color: #B7D9CF; }
    .eyebrow--on-dark::before { background: #B7D9CF; }
    .cta-inner { text-align: center; }
    .cta-title { font-size: clamp(2rem, 5vw, 3.3rem); margin-top: 1.2rem; letter-spacing: 0.05em; }
    .cta-body { color: #C7CCD4; margin-top: 1.7rem; max-width: 38em; margin-inline: auto; line-height: 2; }
    .cta-actions {
      margin-top: 2.8rem;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: clamp(16px, 2.4vw, 30px);
    }
    .cta-alt-link {
      font-size: 0.82rem;
      color: #C7CCD4;
      border-bottom: 1px solid rgba(255,255,255,0.28);
      padding-bottom: 2px;
      transition: color .2s ease, border-color .2s ease;
    }
    .cta-alt-link:hover { color: #B7D9CF; border-bottom-color: #B7D9CF; }
    .cta-note { margin-top: 1.8rem; font-size: 0.74rem; color: var(--slate-mute); }

    /* ---------- COMPANY ---------- */
    .company-grid { display: grid; gap: clamp(36px, 5vw, 64px); }
    @media (min-width: 860px) { .company-grid { grid-template-columns: 0.6fr 1.4fr; align-items: start; } }
    .company-table { margin: 0; }
    .company-row { display: grid; grid-template-columns: 1fr; gap: 0.2rem; padding-block: 1.1rem; border-top: 1px solid var(--hairline); }
    @media (min-width: 560px) { .company-row { grid-template-columns: 9rem 1fr; gap: 1.5rem; } }
    .company-row:last-child { border-bottom: 1px solid var(--hairline); }
    .company-row dt { font-size: 0.84rem; font-weight: 700; color: var(--slate); letter-spacing: 0.04em; }
    .company-row dd { margin: 0; color: var(--ink); font-size: 0.95rem; }
    .company-more { display: inline-block; margin-top: 1.4rem; font-size: 0.88rem; color: var(--teal); }
    .company-more:hover { text-decoration: underline; text-underline-offset: 3px; }
    .company-more .arrow { display: inline-block; transition: transform .25s ease; }
    .company-more:hover .arrow { transform: translateX(4px); }

    /* ---------- FOOTER ---------- */
    .media-banner { padding-block: 0 clamp(48px, 7vw, 80px); }
    .media-banner-card {
      display: flex; align-items: center; justify-content: space-between; gap: clamp(20px, 4vw, 48px);
      padding: clamp(24px, 4vw, 40px); border: 1px solid var(--hairline);
      transition: border-color .25s ease, background .25s ease;
    }
    .media-banner-card:hover { border-color: var(--teal); }
    .media-banner-title { font-family: var(--font-display); font-weight: 700; font-size: clamp(1.05rem, 2vw, 1.3rem); color: var(--ink); margin: 0.5rem 0 0.4rem; }
    .media-banner-desc { font-size: 0.88rem; color: var(--slate); margin: 0; max-width: 46em; }
    .media-banner-link { white-space: nowrap; font-size: 0.88rem; font-weight: 500; color: var(--teal); }
    @media (max-width: 640px) {
      .media-banner-card { flex-direction: column; align-items: flex-start; }
    }
    .site-footer { background: var(--ink); color: var(--paper); padding-top: clamp(48px, 7vw, 80px); border-top: 1px solid var(--hairline-on-dark); }
    .footer-inner { display: grid; gap: clamp(28px, 5vw, 48px); padding-bottom: clamp(40px, 6vw, 64px); }
    @media (min-width: 720px) { .footer-inner { grid-template-columns: 1fr 1fr; align-items: end; } }
    .footer-brand { display: flex; flex-direction: column; gap: 0.4rem; }
    .footer-links { grid-column: 1 / -1; }
    .footer-links-title { font-size: 0.84rem; font-weight: 700; letter-spacing: 0.04em; margin: 0 0 0.6rem; }
    .footer-links-title a { color: var(--paper); }
    .footer-links-cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(180px, 100%), 1fr)); gap: 0.4rem 2rem; max-width: 480px; }
    .footer-links-cols ul { list-style: none; margin: 0; padding: 0; }
    .footer-links-cols li { padding: 0.24rem 0; }
    .footer-links-cols a { font-size: 0.8rem; color: color-mix(in srgb, var(--paper) 72%, transparent); transition: color .2s ease; }
    .footer-links-cols a:hover { color: var(--paper); }
    .footer-brand .brand-mark { width: 14px; height: 14px; border: 1.5px solid #B7D9CF; position: relative; }
    .footer-brand .brand-mark::after { content: ""; position: absolute; inset: 3px; background: #B7D9CF; }
    .footer-name { font-family: var(--font-display); font-weight: 700; letter-spacing: 0.16em; font-size: 1.1rem; margin-top: 0.4rem; }
    .footer-tag { color: #AEB6C2; font-size: 0.84rem; }
    .footer-meta { color: #AEB6C2; font-size: 0.82rem; line-height: 1.9; }
    @media (min-width: 720px) { .footer-meta { text-align: right; } }
    .footer-base { border-top: 1px solid var(--hairline-on-dark); padding-block: 1.6rem; display: flex; flex-wrap: wrap; gap: 0.8rem 1.6rem; align-items: center; justify-content: space-between; }
    .footer-base small { color: var(--slate-mute); letter-spacing: 0.06em; }
    .footer-contact-link { font-size: 0.78rem; color: #AEB6C2; border-bottom: 1px solid transparent; transition: color .2s ease, border-color .2s ease; }
    .footer-contact-link:hover { color: #B7D9CF; border-bottom-color: #B7D9CF; }
  </style>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(organizationSchema)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(websiteSchema)} />
</Layout>
