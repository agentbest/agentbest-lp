---
// src/pages/cases/pattern/[slug].astro … 転職パターンごとの事例一覧（40ページ）。
// /cases/ の中で最も情報量が多い階層。1パターン＝1つの問いに答えるページとして作る。
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import ShareButtons from '../../../components/ShareButtons.astro';
import { PATTERNS, PATTERN_BY_SLUG, casesOfPattern, DISCLAIMER } from '../../../lib/cases';

export function getStaticPaths() {
  return PATTERNS.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const pattern = PATTERN_BY_SLUG.get(slug)!;
const cases = casesOfPattern(slug);

/** この25件の中での内訳。市場全体の統計ではないので、見出しでもそう書く */
const tally = (pick: (c: (typeof cases)[number]) => string | string[]) => {
  const m = new Map<string, number>();
  for (const c of cases) {
    const v = pick(c);
    for (const k of Array.isArray(v) ? v : [v]) m.set(k, (m.get(k) ?? 0) + 1);
  }
  return [...m.entries()].sort((a, b) => b[1] - a[1]);
};
const barrierTally = tally((c) => c.barrier).slice(0, 4);
const breakTally = tally((c) => c.breaks).slice(0, 4);

const incomes = cases.map((c) => c.delta);
const upCount = incomes.filter((d) => d > 40).length;
const flatCount = incomes.filter((d) => d >= -40 && d <= 40).length;
const downCount = incomes.filter((d) => d < -40).length;

const related = PATTERNS.filter((p) => p.area === pattern.area && p.slug !== slug).slice(0, 6);

const title = `${pattern.label}の転職事例${cases.length}件｜転職事例集`;
const description =
  `${pattern.question} この移動の事例を${cases.length}件掲載しています。` +
  '転職前後の職種、年収がどう動いたか、選考でネックになった点とその進め方までをまとめました。';

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [{
    '@type': 'Question',
    name: pattern.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: `${pattern.lead} この移動の事例を${cases.length}件掲載しています。` +
        `選考でネックになりやすいのは「${barrierTally.map(([k]) => k).slice(0, 3).join('」「')}」。`,
    },
  }],
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://www.agent-best.net/' },
    { '@type': 'ListItem', position: 2, name: '転職事例集', item: 'https://www.agent-best.net/cases/' },
    { '@type': 'ListItem', position: 3, name: pattern.label, item: `https://www.agent-best.net/cases/pattern/${slug}/` },
  ],
};
---

<Layout title={title} description={description}>
  <Header />
  <section class="wrap">
    <nav class="breadcrumb" aria-label="パンくず">
      <a href="/">ホーム</a><span>/</span><a href="/cases/">転職事例集</a><span>/</span><span>{pattern.areaLabel}</span>
    </nav>

    <p class="eyebrow">{pattern.areaLabel}</p>
    <h1>{pattern.label}</h1>
    <p class="lead">{pattern.lead}</p>

    <div class="qa">
      <p class="q">{pattern.question}</p>
      <p class="a">
        この移動の事例を<strong>{cases.length}件</strong>掲載しています。
        この{cases.length}件の中で選考の論点になっていたのは、
        {barrierTally.map(([k], i) => (<><b>「{k}」</b>{i < barrierTally.length - 1 ? '、' : ''}</>))}。
        年収は<b>上がったケースが{upCount}件</b>、横ばいが{flatCount}件、下がったケースが{downCount}件です。
      </p>
      <p class="a-note">※ 市場全体の統計ではなく、この事例集に収録した{cases.length}件の内訳です。</p>
    </div>

    <div class="cols">
      <div class="col">
        <h2>このパターンでよくある壁</h2>
        <ul class="tally">
          {barrierTally.map(([k, n]) => (<li><span class="t-label">{k}</span><span class="t-n">{n}件</span></li>))}
        </ul>
      </div>
      <div class="col">
        <h2>効いた進め方</h2>
        <ul class="tally">
          {breakTally.map(([k, n]) => (<li><span class="t-label">{k}</span><span class="t-n">{n}件</span></li>))}
        </ul>
      </div>
    </div>

    <h2 id="cases">事例{cases.length}件</h2>
    <p class="note">{DISCLAIMER}</p>

    <ol class="case-list">
      {cases.map((c, i) => (
        <li>
          <a href={`/cases/${c.id}/`}>
            <span class="c-no">CASE {String(i + 1).padStart(2, '0')}</span>
            <span class="c-title">{c.title}</span>
            <span class="c-sub">{c.subtitle}</span>
            <span class="c-summary">{c.summary}</span>
            <span class="c-meta">
              <span class="chip chip-mute">{c.ageBand}</span>
              <span class="chip chip-mute">{c.incomeBand}</span>
              <span class="chip chip-mute">{c.motive}</span>
            </span>
          </a>
        </li>
      ))}
    </ol>

    {related.length > 0 && (
      <>
        <h2>近いパターン</h2>
        <ul class="rel">
          {related.map((p) => (
            <li><a href={`/cases/pattern/${p.slug}/`}>{p.label}<span class="rel-n">{p.count}件</span></a></li>
          ))}
        </ul>
      </>
    )}

    <div class="cta">
      <h2>このパターンで動くか迷っているとき</h2>
      <p>
        同じ移動でも、年齢・時期・応募先のフェーズで進み方は変わります。
        いまの経歴でどこまで通るのかを確かめたい方は、キャリア相談をご利用ください。求人が決まっていない段階でも構いません。
      </p>
      <a class="cta-btn" href="/consultation/">キャリア相談について見る →</a>
      <p class="cta-sub">
        この領域の解説記事は <a href="/media/">キャリアメディア</a>、
        事例の絞り込みは <a href="/cases/search/">事例をしぼり込む</a> から。
      </p>
    </div>

    <ShareButtons title={title} label="この事例集をシェア" />
  </section>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)} />
</Layout>

<style>
  .wrap { max-width: 880px; margin: 0 auto; padding: 32px 20px 72px; line-height: 1.9; color: #24292f; }
  .breadcrumb { font-size: .85rem; color: #6b7684; display: flex; gap: .4em; flex-wrap: wrap; }
  .breadcrumb a { color: #6b7684; }
  .breadcrumb a:hover { text-decoration: underline; }
  .eyebrow { font-size: .76rem; letter-spacing: .12em; color: #1e5f56; font-weight: 700; margin: 1.4em 0 .2em; }
  h1 { font-size: 1.75rem; margin: 0 0 .5em; line-height: 1.45; }
  .lead { font-size: .97rem; color: #333c47; margin: 0 0 1.6em; }

  .qa { border: 1px solid #e3e7ec; border-left: 3px solid #1e5f56; border-radius: 8px; padding: 1.1em 1.3em; margin: 0 0 2em; background: #fff; }
  .q { font-weight: 700; color: #1c1c2e; margin: 0 0 .5em; font-size: .97rem; }
  .a { font-size: .92rem; color: #333c47; margin: 0; }
  .a b { color: #1c1c2e; }
  .a-note { font-size: .78rem; color: #8a93a2; margin: .7em 0 0; }

  .cols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; margin: 0 0 2.4em; }
  h2 { font-size: 1.15rem; margin: 1.8em 0 .6em; }
  .col h2 { margin-top: 0; font-size: 1rem; }
  .tally { list-style: none; padding: 0; margin: 0; }
  .tally li { display: flex; justify-content: space-between; gap: 1em; padding: .5em 0; border-bottom: 1px solid #eceff2; font-size: .87rem; }
  .t-label { color: #333c47; }
  .t-n { color: #8a93a2; font-size: .8rem; white-space: nowrap; }

  .note {
    font-size: .8rem; line-height: 1.85; color: #5c6675;
    background: #f6f7f9; border: 1px solid #e6e9ed; border-radius: 8px; padding: .85em 1.05em; margin: 0 0 1.6em;
  }

  .case-list { list-style: none; padding: 0; margin: 0; counter-reset: none; }
  .case-list li { border-bottom: 1px solid #eceff2; }
  .case-list a { display: block; padding: 1.1em .2em; }
  .case-list a:hover { background: #fafbfc; }
  .c-no { display: block; font-size: .72rem; letter-spacing: .1em; color: #8a93a2; font-weight: 700; }
  .c-title { display: block; font-weight: 700; color: #1c1c2e; line-height: 1.6; margin-top: .15em; }
  .case-list a:hover .c-title { text-decoration: underline; }
  .c-sub { display: block; font-size: .85rem; color: #1e5f56; font-weight: 700; margin-top: .15em; }
  .c-summary { display: block; font-size: .87rem; color: #57606a; margin-top: .3em; }
  .c-meta { display: flex; flex-wrap: wrap; gap: .4em; margin-top: .5em; }
  .chip { font-size: .72rem; border-radius: 4px; padding: 2px 8px; background: #1c1c2e; color: #fff; }
  .chip-mute { background: #f0f2f5; color: #6b7684; }

  .rel { list-style: none; padding: 0; margin: 0 0 1em; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
  .rel a { display: flex; justify-content: space-between; gap: .8em; align-items: baseline; padding: .7em .9em; border: 1px solid #e3e7ec; border-radius: 8px; font-size: .87rem; background: #fff; }
  .rel a:hover { border-color: #1c1c2e; }
  .rel-n { font-size: .74rem; color: #8a93a2; white-space: nowrap; }

  .cta { margin: 2.6em 0 0; padding: 1.6em 1.6em 1.8em; background: #f6f7f9; border-radius: 12px; }
  .cta h2 { margin-top: 0; font-size: 1.05rem; }
  .cta p { font-size: .9rem; color: #454e59; margin: 0 0 1em; }
  .cta-btn { display: inline-block; padding: .75em 1.6em; border-radius: 8px; background: #1e5f56; color: #fff; font-weight: 700; font-size: .92rem; }
  .cta-btn:hover { background: #16453f; }
  .cta-sub { font-size: .84rem; color: #6b7480; margin: 1.2em 0 0; }
  .cta-sub a { color: #1e5f56; text-decoration: underline; }

  @media (max-width: 720px) {
    .cols, .rel { grid-template-columns: 1fr; }
    h1 { font-size: 1.4rem; }
  }
</style>
