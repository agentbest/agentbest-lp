---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ShareButtons from '../components/ShareButtons.astro';

import FooterSites from '../components/FooterSites.astro';
import { getArticleCount } from '../lib/mediaCount';

// 記事本数は手打ちにしない（古い数字が残るため）。定義は src/lib/mediaCount.ts
const article = await getArticleCount();
/* 旧サイトから引き継いだ4つの行動指針。表記（英文の大文字／和文の見出し）は旧サイトのまま */
const values = [
  {
    en: 'BE HONEST',
    jp: '誠実であれ',
    body: 'どんな時も、正直であること。数字のために人を裏切る文化ではなく、信頼こそが価値になると信じています。',
  },
  {
    en: 'ACT WITH DRIVE',
    jp: '心を燃やして挑む',
    body: 'やらされ仕事ではなく、自分ごととして熱く取り組もう。情熱を持って向き合えば、成果も楽しさもついてくる。',
  },
  {
    en: 'PLAY THE GAME',
    jp: 'ピンチを、ゲームに変える',
    body: '数字や課題を“遊び心”で楽しめば、思考は前向きになる。苦境さえもチャンスに変える「ゲーム感覚」で、打席に立ち続けよう。',
  },
  {
    en: 'THINK FAST, STAY WELL',
    jp: 'スピードを重んじ、心を守る',
    body: '完璧を求めすぎず、まずは動こう。追い詰める文化ではなく、健やかに働けるチームであることが、長期的な成果につながります。',
  },
];

const business = [
  {
    no: '01',
    title: '人材紹介事業',
    lead: 'IT・スタートアップ・M&A・コンサルティングの4領域に絞った、有料職業紹介。',
    body: '20代・30代のハイクラス層を対象に、入口のキャリア相談から求人提案、選考、意思決定まで一人の担当が一貫して伴走します。領域を絞ることで、選考の実態や入社後に起きることまで踏み込んだ情報をお渡しできます。',
    href: '/#domains',
    linkLabel: '専門領域を見る',
  },
  {
    no: '02',
    title: '採用支援事業（RPO・スカウト代行）',
    lead: '採用企業向けに、ダイレクトリクルーティングの実務を代行。',
    body: 'スカウト媒体の運用設計、候補者のスクリーニング、スカウト文面の作成・送信までを引き受けます。生成AIを組み込んだ運用で、母集団形成のスピードと量を両立させています。',
    href: '/contact/',
    linkLabel: '採用のご相談',
  },
  {
    no: '03',
    title: 'メディア事業',
    lead: 'キャリアメディアと求人サイトの自社運営。',
    body: `職種・業界・企業ごとの転職情報を体系的にまとめたキャリアメディア（${article.label}本以上）と、求人検索サイトを運営しています。記事はすべて代表の松岡が監修しています。`,
    href: '/media/',
    linkLabel: 'キャリアメディアを見る',
  },
];

const company = [
  { k: '会社名', v: '株式会社エージェントベスト' },
  { k: '代表者', v: '代表取締役　松岡 良次' },
  { k: '所在地', v: '東京都港区六本木4-8-7　嶋田ビル5階' },
  { k: '事業内容', v: '有料職業紹介事業／採用支援（RPO・スカウト代行）／キャリアメディア運営' },
  { k: '許可番号', v: '有料職業紹介事業　13-ユ-316964' },
];

const title = '会社情報｜株式会社エージェントベスト';
const description =
  '株式会社エージェントベストの会社情報。「日本に磁力を生む」というミッション、4つの行動指針、代表メッセージ、事業内容、会社概要を掲載しています。';

// 構造化データ（AboutPage / Organization）
const aboutSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  '@id': 'https://www.agent-best.net/company/#aboutpage',
  url: 'https://www.agent-best.net/company/',
  name: title,
  description,
  inLanguage: 'ja',
  isPartOf: { '@id': 'https://www.agent-best.net/#website' },
  about: { '@id': 'https://www.agent-best.net/#organization' },
};

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://www.agent-best.net/#organization',
  name: '株式会社エージェントベスト',
  alternateName: 'AGENT BEST',
  url: 'https://www.agent-best.net/',
  logo: 'https://www.agent-best.net/logo.png',
  slogan: '日本に磁力を生む',
  description:
    'IT・スタートアップ・M&A・コンサル領域に特化した転職エージェント。人材紹介・採用支援（RPO）・キャリアメディア運営を行っています。',
  numberOfEmployees: { '@type': 'QuantitativeValue', value: 5 },
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'JP',
    addressRegion: '東京都',
    addressLocality: '港区',
    streetAddress: '六本木4-8-7 嶋田ビル5階',
  },
  founder: {
    '@type': 'Person',
    name: '松岡 良次',
    url: 'https://www.agent-best.net/profile/',
  },
};
---

<Layout title={title} description={description} image="/ogp/company.png">
  <Header />

  <main>
    <!-- ============ HERO ============ -->
    <section class="c-hero">
      <div class="wrap">
        <span class="eyebrow">Company</span>
        <h1 class="c-hero-title">会社情報</h1>
        <p class="c-hero-lead">
          株式会社エージェントベストは、IT・スタートアップ・M&amp;A・コンサルティングの4領域に絞った
          転職エージェントです。人材紹介を軸に、企業の採用支援とキャリアメディアの運営を行っています。
        </p>
        <nav class="c-hero-index" aria-label="このページの内容">
          <a href="#mission">ミッション</a>
          <a href="#values">行動指針</a>
          <a href="#message">代表メッセージ</a>
          <a href="#business">事業内容</a>
          <a href="#outline">会社概要</a>
        </nav>
      </div>
    </section>

    <!-- ============ MISSION ============ -->
    <section id="mission" class="c-mission" aria-labelledby="mission-h">
      <div class="wrap c-mission-grid">
        <div class="c-mission-side" aria-hidden="true">
          <span class="c-mission-vlabel vertical">MISSION</span>
        </div>
        <div class="c-mission-body reveal">
          <h2 id="mission-h" class="c-mission-text">
            日本に、<br />磁力を生む。
          </h2>
          <p class="c-mission-lead">
            いま、日本には磁力が足りない。
            経済は伸び悩み、世界の中での存在感は年々小さくなっている。
            国の力が弱まれば、人も、金も、面白いものも、この国を素通りしていく。
          </p>
          <p class="c-mission-lead">
            出ていくだけではない。
            この国で育った優秀な人が、日本にいながら、その力を海外の企業のために使っている。
            選ばれなかったのは、日本のほうだ。力の向かう先は、舞台の魅力で決まる。
          </p>
          <p class="c-mission-lead">
            魅力のある国には、人が集まる。
            だから私たちは、この国に磁力を生む。
          </p>
          <p class="c-mission-lead">
            磁力は、ひとつのもので生まれない。
            経済、技術、文化、暮らし。その全部が重なって、人を引きつける力になる。
            世界のどこででも活躍できる人が、それでもこの国を選ぶことがある。
            理由は条件ではない。この国でなければならない、と思わせる何かだ。
          </p>
          <p class="c-mission-lead">はじまりは、人だ。</p>
          <p class="c-mission-lead">
            どんな産業も、最初のひとりから動きだす。
            私たちが支援するのは、人のグロースであり、企業のグロースであり、その先にある国のグロースだ。
            成長する産業と、そこで勝負しようとする企業に、必要な人が届く線を引き続ける。
          </p>
          <p class="c-mission-lead">
            磁力は、経済だけでは生まれない。だから私たちは、その外側にも出ていく。
          </p>
          <p class="c-mission-lead">
            この国が育ててきた表現も、感性も、世界を惹きつける力になる。
            働く理由も、住む理由も、憧れる理由も、この国にある。
            日本にしかないものを、日本の強さに変える。
          </p>
          <p class="c-mission-sign">
            一人ずつ、一社ずつ。磁力は、その積み重ねでしか生まれない。
          </p>
        </div>
      </div>
    </section>

    <!-- ============ VISION ============ -->
    <section id="vision" class="section c-vision">
      <div class="wrap c-two">
        <header class="c-head reveal">
          <span class="eyebrow">Vision</span>
          <h2>目指す姿</h2>
        </header>
        <div class="c-two-body reveal" data-delay="1">
          <p class="c-vision-headline">
            働くことにも、生きることにも、<br />開放感を。
          </p>
          <p class="c-text">
            何かを得るために、何かを捨てる。そういう時代は、少しずつ過去のものになりつつあります。
            働き方の選択肢は確実に増えていて、昔ながらの枠組みが残る場所はまだ多いけれど、方向は変わってきました。
          </p>
          <p class="c-text">
            選択肢があるということは、自分で選べるということです。
            逆に、選べるという実感がないまま働き続けると、人は受け身になっていく。
            開放感は、会社の規模や種類では決まりません。自分で選んだかどうかで決まります。
          </p>
          <p class="c-text">
            そして、主体性を持って働けるようになると、人は持っている力を出せるようになります。
            自分の才能を活かせないまま働き続けることは、人にとって不幸なことだと考えています。
            一人ひとりが持っているものを出しきれる。その状態が増えた分だけ、この国は豊かになる。
          </p>
          <p class="c-text">
            私たちがやっているのは、その選択肢を一つひとつ、具体的な形で差し出すことです。
            10年後、自分で選んで働いている人が当たり前になっているように。
            その積み重ねが、日本の磁力になっていきます。
          </p>
        </div>
      </div>
    </section>

    <!-- ============ VALUES ============ -->
    <section id="values" class="section c-values spine">
      <div class="wrap">
        <header class="c-head reveal">
          <span class="eyebrow">Values</span>
          <h2>4つの行動指針</h2>
          <p class="c-desc">エージェントベストで働く全員が、判断に迷ったときに立ち返る基準です。</p>
        </header>
        <ul class="c-values-grid reveal" data-delay="1">
          {values.map((v, i) => (
            <li class="c-value-card">
              <span class="c-value-no">{String(i + 1).padStart(2, '0')}</span>
              <p class="c-value-en">{v.en}</p>
              <p class="c-value-jp">{v.jp}</p>
              <p class="c-value-body">{v.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ============ 代表メッセージ ============ -->
    <section id="message" class="section c-message">
      <div class="wrap c-two">
        <header class="c-head reveal">
          <span class="eyebrow">Message</span>
          <h2>代表メッセージ</h2>
        </header>
        <div class="c-two-body reveal" data-delay="1">
          <p class="c-message-headline">
            次の一社で、<br />その先の10年が決まる。
          </p>
          <p class="c-text">
            大手人材会社とスタートアップの人材企業で、IT・スタートアップ・メガベンチャーの採用支援に携わってきました。
            そのなかで一貫して感じてきたのは、転職の成否を分けるのは求人の数ではなく、
            意思決定の手前でどれだけ確かな材料を持てるか、ということです。
          </p>
          <p class="c-text">
            エージェントベストが領域を絞っているのは、そのためです。扱う世界を狭くするほど、
            一社の解像度は上がる。選考で何が見られるのか、入社後に何が起きるのか、どういう人が活躍しているのか。
            そこまで踏み込んで話せて初めて、キャリアの相談相手として意味があると考えています。
          </p>
          <p class="c-text">
            そして、その一件ずつの積み重ねの先に見ているのが、「日本に磁力を生む」というミッションです。
            力のある人が、力を発揮できる企業に集まる。その流れを一本ずつ確かに通していくことが、
            結果として日本全体の引力になると信じています。
          </p>
          <p class="c-text">
            転職の意思が固まっていない段階でのご相談も歓迎しています。
            10年先から逆算したときに、いま選ぶべき一社はどれか。その問いに、一緒に向き合わせてください。
          </p>
          <div class="c-sign">
            <span class="c-sign-role">株式会社エージェントベスト　代表取締役</span>
            <span class="c-sign-name">松岡 良次</span>
            <a href="/profile/" class="c-sign-link">代表プロフィールを見る <span class="arrow" aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ 事業内容 ============ -->
    <section id="business" class="section c-business spine">
      <div class="wrap">
        <header class="c-head reveal">
          <span class="eyebrow">Business</span>
          <h2>事業内容</h2>
          <p class="c-desc">人材紹介を軸に、採用する側とメディアの3本で事業を組み立てています。</p>
        </header>
        <ul class="c-business-list">
          {business.map((b, i) => (
            <li class="c-business-item reveal" data-delay={String(Math.min(i + 1, 3))}>
              <span class="c-business-no">{b.no}</span>
              <div class="c-business-body">
                <h3 class="c-business-title">{b.title}</h3>
                <p class="c-business-lead">{b.lead}</p>
                <p class="c-business-text">{b.body}</p>
                <a href={b.href} class="c-business-link">{b.linkLabel} <span class="arrow" aria-hidden="true">→</span></a>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ============ 会社概要 ============ -->
    <section id="outline" class="section c-outline">
      <div class="wrap c-two">
        <header class="c-head reveal">
          <span class="eyebrow">Outline</span>
          <h2>会社概要</h2>
        </header>
        <dl class="c-table reveal" data-delay="1">
          {company.map((row) => (
            <div class="c-row">
              <dt>{row.k}</dt>
              <dd>{row.v}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- ============ CTA ============ -->
    <section class="c-cta">
      <div class="wrap c-cta-inner reveal">
        <span class="eyebrow eyebrow--on-dark">Contact</span>
        <h2 class="c-cta-title">まずは、話すところから。</h2>
        <p class="c-cta-body">
          転職のご相談も、採用のご相談も、同じ窓口でお受けしています。<br />
          現職中・情報収集の段階でも構いません。
        </p>
        <div class="c-cta-actions">
          <a href="/consultation/" class="btn btn--on-dark">
            転職の相談をする <span class="arrow" aria-hidden="true">→</span>
          </a>
          <a href="/contact/" class="c-cta-alt">採用ご担当者さまはこちら</a>
        </div>
      </div>
    </section>

    <div class="wrap">
      <ShareButtons title={title} label="このページをシェア" />
    </div>
  </main>

  <!-- ============ FOOTER ============ -->
  <footer class="site-footer">
    <div class="wrap footer-inner">
      <div class="footer-brand">
        <img class="footer-logo" src="/logo-white.png" alt="エージェントベスト" width="508" height="120" />
        <p class="footer-tag">20代・30代ハイクラスのための転職エージェント</p>
      </div>
      <p class="footer-meta">
        株式会社エージェントベスト　許可番号 13-ユ-316964<br />
        東京都港区六本木4-8-7　嶋田ビル5階
      </p>
      <nav class="footer-links" aria-label="サイト内リンク">
        <p class="footer-links-title"><a href="/">トップページ</a></p>
        <div class="footer-links-cols">
          <ul>
            <li><a href="/company/">会社情報</a></li>
            <li><a href="/profile/">代表プロフィール</a></li>
            <li><a href="/media/">キャリアメディア</a></li>
          </ul>
          <ul>
            <li><a href="/consultation/">キャリア相談</a></li>
            <li><a href="/contact/">お問い合わせ</a></li>
            <li><a href="https://jobs.agent-best.net/" target="_blank" rel="noopener">求人を探す</a></li>
          </ul>
        </div>
      </nav>
      <FooterSites />
    </div>
    <div class="wrap footer-base">
      <small>&copy; {new Date().getFullYear()} Agent Best Inc.</small>
      <a href="/contact/" class="footer-contact-link">採用ご担当者さまはこちら</a>
    </div>
  </footer>

  <script>
    const els = document.querySelectorAll('.reveal');
    const mq = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (mq.matches || !('IntersectionObserver' in window)) {
      els.forEach((el) => el.classList.add('is-in'));
    } else {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
      els.forEach((el) => io.observe(el));
    }
  </script>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(aboutSchema)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(organizationSchema)} />
</Layout>

<style>
  /* ---------- 共通 ---------- */
  .c-head h2 {
    font-size: clamp(1.6rem, 3.4vw, 2.2rem);
    margin-top: 0.9rem;
  }
  .c-desc {
    color: var(--slate);
    font-size: 0.95rem;
    margin-top: 1rem;
    max-width: 34em;
  }
  .c-text {
    color: var(--slate);
    line-height: 2.1;
  }
  .c-text + .c-text { margin-top: 1.4em; }

  /* 見出し左・本文右の2カラム（index の sec-head と同じ骨格） */
  .c-two {
    display: grid;
    grid-template-columns: minmax(0, 0.68fr) minmax(0, 1.32fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: start;
  }
  @media (max-width: 860px) {
    .c-two { grid-template-columns: 1fr; }
  }

  /* ---------- HERO ---------- */
  .c-hero {
    padding: clamp(48px, 8vw, 96px) 0 clamp(40px, 6vw, 72px);
    border-bottom: 1px solid var(--hairline);
  }
  .c-hero-title {
    font-size: clamp(2.1rem, 5.4vw, 3.2rem);
    margin: 1rem 0 0;
    letter-spacing: 0.04em;
  }
  .c-hero-lead {
    color: var(--slate);
    margin-top: 1.6rem;
    max-width: 40em;
    font-size: 0.98rem;
  }
  .c-hero-index {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    margin-top: 2.4rem;
  }
  .c-hero-index a {
    font-size: 0.82rem;
    color: var(--slate);
    border-bottom: 1px solid var(--hairline);
    padding-bottom: 3px;
    transition: color .2s ease, border-color .2s ease;
  }
  .c-hero-index a:hover { color: var(--teal); border-bottom-color: var(--teal); }

  /* ---------- MISSION ---------- */
  .c-mission {
    background: var(--ink);
    color: var(--paper);
    padding-block: clamp(84px, 13vw, 168px);
  }
  .c-mission-grid {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(28px, 6vw, 80px);
    align-items: start;
  }
  .c-mission-side { display: flex; justify-content: center; padding-top: 0.4rem; }
  .c-mission-vlabel {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1rem, 2vw, 1.3rem);
    letter-spacing: 0.5em;
    color: #B7D9CF;
  }
  .c-mission-text {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.9rem, 5.4vw, 3.6rem);
    line-height: 1.6;
    letter-spacing: 0.05em;
  }
  .c-mission-lead {
    color: #C7CCD4;
    margin-top: clamp(1.6rem, 3vw, 2.4rem);
    max-width: 38em;
    line-height: 2.1;
  }
  .c-mission-sign {
    margin-top: clamp(2rem, 4vw, 3rem);
    padding-top: 1.6rem;
    border-top: 1px solid var(--hairline-on-dark);
    font-family: var(--font-display);
    font-size: clamp(1rem, 2.2vw, 1.25rem);
    letter-spacing: 0.04em;
    color: #E7E4DC;
  }

  /* ---------- VISION ---------- */
  .c-vision { background: var(--paper-deep); }
  .c-vision-headline {
    font-family: var(--font-display);
