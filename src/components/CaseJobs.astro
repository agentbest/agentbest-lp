---
/* 転職事例（/cases/<id>/）に出す「転職先の募集中の求人」カード（2026-11-18）。
   それまで事例ページから求人サイトへの導線は、末尾の「〇〇の求人一覧 →」の文字リンク1本だけだった。
   求人サイトが毎朝作る https://jobs.agent-best.net/data/group-jobs/<職種の大分類slug>.json を閲覧時に読み、
   事例の番号でずらして4件出す（同じパターンの25件が全部同じ4件にならないように）。作っているのは jobsite の media-jobs.js。
     { l: 大分類名, n: 掲載件数, j: [[求人ID, 企業名, 職種名, 年収, 勤務地, ロゴ, サイト], ...最大24件] }
   ファイルが無い・読めないときは何も出さない。クリックは jobs_click（placement=cases-jobs）。
   ⚠ 事例はモデルケース。「この事例の人が入った会社」と読める書き方にしない（見出しは「転職先の職種の求人」）。 */
import { JOBS_URL, jobsGroupUrl } from '../lib/jobsLink';

interface Props {
  /** 求人サイトの職種の大分類slug（jobsGroupOfCaseArea の結果） */
  group: string;
  label: string;
  caseId: string | number;
}
const { group, label, caseId } = Astro.props;
const allHref = jobsGroupUrl(group, { medium: 'cases-jobs', campaign: String(caseId) });
---

<section class="case-jobs" data-case-jobs hidden
  data-src={`${JOBS_URL}data/group-jobs/${group}.json`} data-base={JOBS_URL} data-case={String(caseId)}>
  <h2>{label}の募集中の求人</h2>
  <p class="case-jobs-lead">この事例と同じ転職先の職種で、いま募集が出ている求人です。</p>
  <ul class="case-jobs-list"></ul>
  <p class="case-jobs-all"><a href={allHref} target="_blank" rel="noopener" data-jobs-cta="cases-jobs-all">{label}の求人<span data-case-jobs-n></span>をすべて見る →</a></p>
</section>

<script is:inline>
  (function () {
    var box = document.querySelector('[data-case-jobs]');
    if (!box || !window.fetch) return;
    var d = box.dataset;
    var esc = function (s) {
      return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    };
    fetch(d.src).then(function (r) { return r.ok ? r.json() : null; }).then(function (data) {
      if (!data || !data.j || !data.j.length) return;
      var n = data.j.length, per = Math.min(4, n);
      var start = ((parseInt(String(d.case).replace(/[^0-9]/g, ''), 10) || 0) * per) % n;
      var pick = [];
      for (var i = 0; i < per; i++) pick.push(data.j[(start + i) % n]);
      var utm = '?utm_source=corporate&utm_medium=cases-jobs&utm_campaign=' + encodeURIComponent(d.case);
      box.querySelector('.case-jobs-list').innerHTML = pick.map(function (j) {
        var base = j[6] === 's' ? 'https://skill.agent-best.net/' : d.base;
        var logo = j[5]
          ? '<img class="cj-logo" src="' + esc(base + j[5]) + '" alt="" width="36" height="36" loading="lazy" onerror="this.remove()">'
          : '';
        return '<li><a href="' + esc(base + 'job/' + encodeURIComponent(j[0]) + '/' + utm) + '" target="_blank" rel="noopener" data-jobs-cta="cases-jobs">'
          + logo
          + '<span class="cj-body"><span class="cj-co">' + esc(j[1]) + '</span>'
          + '<span class="cj-name">' + esc(j[2]) + '</span>'
          + '<span class="cj-meta"><b>' + esc(j[3]) + '</b>' + (j[4] ? '・' + esc(j[4]) : '') + '</span></span></a></li>';
      }).join('');
      if (data.n) box.querySelector('[data-case-jobs-n]').textContent = '（' + Number(data.n).toLocaleString('ja-JP') + '件）';
      box.hidden = false;
    }).catch(function () {});
  })();
</script>

<style>
  .case-jobs { margin: 2.2em 0; padding: 18px 18px 14px; background: #f3f8f7; border: 1px solid #d3e4e1; border-radius: 10px; }
  .case-jobs h2 { margin: 0 0 4px; font-size: 1.05rem; }
  .case-jobs-lead { margin: 0 0 12px; font-size: .85rem; color: #5b6573; }
  .case-jobs-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .case-jobs-list :global(li) { margin: 0; padding: 0; }
  .case-jobs-list :global(a) {
    display: flex; gap: 12px; align-items: flex-start; padding: 12px 14px;
    background: #fff; border: 1px solid #d8dee6; border-radius: 8px;
    color: inherit; text-decoration: none; transition: border-color .15s, box-shadow .15s;
  }
  .case-jobs-list :global(a:hover) { border-color: #1e5f56; box-shadow: 0 2px 8px rgba(11, 42, 74, .08); }
  .case-jobs-list :global(.cj-logo) { flex: none; width: 36px; height: 36px; object-fit: contain; border-radius: 6px; background: #fff; border: 1px solid #eef1f5; }
  .case-jobs-list :global(.cj-body) { display: grid; gap: 2px; min-width: 0; }
  .case-jobs-list :global(.cj-co) { font-size: .78rem; color: #5b6573; }
  .case-jobs-list :global(.cj-name) { font-weight: 700; font-size: .95rem; line-height: 1.5; color: #0b2a4a; overflow-wrap: anywhere; }
  .case-jobs-list :global(.cj-meta) { font-size: .82rem; color: #3d4652; }
  .case-jobs-list :global(.cj-meta b) { color: #c2410c; font-weight: 700; }
  .case-jobs-all { margin: 12px 0 0; font-size: .9rem; }
  .case-jobs-all a { color: #1e5f56; font-weight: 700; }
</style>
