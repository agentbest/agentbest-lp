---
/**
 * シェアボタン。記事の末尾に置く。
 *
 * 外部のSDK（Twitter widgets.js や Facebook SDK）は読み込まない。
 * あれは相手のサーバーに読者の閲覧履歴が渡るうえ表示も遅くなるので、
 * ただのリンクとして自前で持つ。見た目もサイト側で揃えられる。
 *
 * url は絶対URLを渡すこと（相対だとシェア先で解決できない）。
 */
export interface Props {
  /** 省略すると、そのページのcanonical（末尾スラッシュあり）を使う */
  url?: string;
  title: string;
  label?: string;
}
const { url: urlProp, title, label = 'この記事をシェア' } = Astro.props;

const canonicalPath = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const url = urlProp ?? new URL(canonicalPath, Astro.site).href;

const u = encodeURIComponent(url);
const t = encodeURIComponent(title);

const links = [
  {
    key: 'x',
    name: 'X',
    href: `https://x.com/intent/post?url=${u}&text=${t}`,
    icon: 'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z',
  },
  {
    key: 'facebook',
    name: 'Facebook',
    href: `https://www.facebook.com/sharer/sharer.php?u=${u}`,
    icon: 'M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047v-2.66c0-3.025 1.792-4.697 4.533-4.697 1.313 0 2.686.236 2.686.236v2.971H15.83c-1.491 0-1.956.93-1.956 1.886v2.264h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z',
  },
  {
    key: 'linkedin',
    name: 'LinkedIn',
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${u}`,
    icon: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z',
  },
];
---

<aside class="share" aria-label="シェア">
  <span class="share-label">{label}</span>
  <ul class="share-list">
    {links.map((l) => (
      <li>
        <a
          class={`share-btn share-btn--${l.key}`}
          href={l.href}
          target="_blank"
          rel="noopener noreferrer"
          data-share={l.key}
          aria-label={`${l.name}でシェア`}
          title={`${l.name}でシェア`}
        >
          <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={l.icon} /></svg>
        </a>
      </li>
    ))}
    <li>
      <a
        class="share-btn share-btn--hatena"
        href={`https://b.hatena.ne.jp/entry/panel/?url=${u}&btitle=${t}`}
        target="_blank"
        rel="noopener noreferrer"
        data-share="hatena"
        aria-label="はてなブックマークに追加"
        title="はてなブックマークに追加"
      >
        <span class="share-hb" aria-hidden="true">B!</span>
      </a>
    </li>
    <li>
      <button
        type="button"
        class="share-btn share-btn--copy"
        data-share="copy"
        data-share-url={url}
        aria-label="リンクをコピー"
        title="リンクをコピー"
      >
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" /><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" /></svg>
      </button>
    </li>
    <li class="share-native" hidden>
      <button
        type="button"
        class="share-btn share-btn--native"
        data-share="native"
        data-share-url={url}
        data-share-title={title}
        aria-label="その他の方法でシェア"
        title="その他の方法でシェア"
      >
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" /><path d="M8.59 13.51l6.83 3.98M15.41 6.51l-6.82 3.98" /></svg>
      </button>
    </li>
  </ul>
  <span class="share-done" role="status" aria-live="polite"></span>
</aside>

<style is:global>
  .share {
    display: flex; align-items: center; flex-wrap: wrap; gap: 10px 14px;
    margin: 2.6rem 0 0; padding: 16px 0 0; border-top: 1px solid #e6e9ec;
  }
  .share .share-label { font-size: .84rem; font-weight: 700; color: #6b7684; letter-spacing: .04em; }
  /* 記事本文の ul / li に負けないよう、.share を前置してセレクタを強くしている */
  .share .share-list { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; padding: 0; margin: 0; }
  .share .share-list li { margin: 0; }
  .share .share-btn {
    display: inline-flex; align-items: center; justify-content: center;
    width: 40px; height: 40px; padding: 0;
    border: 1px solid #d8dde3; border-radius: 999px;
    background: #fff; color: #384049; cursor: pointer;
    transition: background-color .15s, border-color .15s, color .15s;
  }
  .share .share-btn:hover { color: #fff; }
  .share .share-btn--x:hover { background: #000; border-color: #000; }
  .share .share-btn--facebook:hover { background: #1877F2; border-color: #1877F2; }
  .share .share-btn--linkedin:hover { background: #0A66C2; border-color: #0A66C2; }
  .share .share-btn--hatena:hover { background: #00A4DE; border-color: #00A4DE; }
  .share .share-btn--copy:hover, .share .share-btn--native:hover { background: #1c1c2e; border-color: #1c1c2e; }
  .share .share-btn:focus-visible { outline: 2px solid #1c1c2e; outline-offset: 2px; }
  .share .share-hb { font-weight: 800; font-size: .95rem; line-height: 1; letter-spacing: -.02em; }
  .share .share-done { font-size: .8rem; color: #1a7f5a; font-weight: 700; }
  @media (max-width: 480px) {
    .share { gap: 8px 10px; }
    .share .share-btn { width: 42px; height: 42px; }
  }
</style>

<script>
  /* コピーと端末の共有シートだけJSが要る。SNSへの導線はただのリンクなので
     JSが落ちても壊れない。ページ内に複数置いても動くよう委譲で拾う。 */
  (() => {
    if (window.__shareWired) return;
    window.__shareWired = true;

    if (typeof navigator !== 'undefined' && 'share' in navigator) {
      document.querySelectorAll('.share-native').forEach((li) => { li.hidden = false; });
    }

    const track = (method) => {
      if (typeof window.gtag === 'function') {
        window.gtag('event', 'share', { method, content_type: 'article' });
      }
    };

    const flash = (btn, text) => {
      const wrap = btn.closest('.share');
      const box = wrap && wrap.querySelector('.share-done');
      if (!box) return;
      box.textContent = text;
      window.setTimeout(() => { box.textContent = ''; }, 2200);
    };

    document.addEventListener('click', async (e) => {
      const el = e.target && e.target.closest ? e.target.closest('[data-share]') : null;
      if (!el) return;
      const kind = el.dataset.share;

      if (kind === 'copy') {
        e.preventDefault();
        const url = el.dataset.shareUrl || location.href;
        try {
          await navigator.clipboard.writeText(url);
          flash(el, 'コピーしました');
        } catch {
          /* 権限が下りない環境向けの保険 */
          const ta = document.createElement('textarea');
          ta.value = url; ta.setAttribute('readonly', '');
          ta.style.cssText = 'position:fixed;top:-1000px';
          document.body.appendChild(ta); ta.select();
          const ok = document.execCommand('copy');
          document.body.removeChild(ta);
          flash(el, ok ? 'コピーしました' : 'コピーできませんでした');
        }
        track('copy');
        return;
      }

      if (kind === 'native') {
        e.preventDefault();
        try {
          await navigator.share({ url: el.dataset.shareUrl || location.href, title: el.dataset.shareTitle || document.title });
          track('native');
        } catch { /* 共有シートを閉じただけ。何もしない */ }
        return;
      }

      track(kind);
    });
  })();
</script>
