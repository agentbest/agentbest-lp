---
/* LINE公式アカウントの友だち追加ボタン。
   置き場所を増やすときは placement に「どこのボタンか」が分かる文字列を渡す。
   GA4 のクリック計測は Layout.astro の委譲リスナーが data-line-cta を拾って送る。
   LINE 側では流入元が分からないので、この属性を空にすると効果測定ができなくなる。

   variant:
     badge  … LINE が配布している公式バッジ画像。フッターなど小さく置く場所向け。
     button … サイトの配色に合わせた横長ボタン。CTA の中で Calendly と並べる用。 */
interface Props {
  placement: string;
  variant?: 'badge' | 'button';
  label?: string;
  note?: string;
}
const { placement, variant = 'badge', label = 'LINEで相談する', note } = Astro.props;
const LINE_URL = 'https://lin.ee/RUrPtec';
---

{variant === 'badge' ? (
  <div class="line-cta">
    <p class="line-cta__lead">{label}</p>
    <a
      href={LINE_URL}
      target="_blank"
      rel="noopener noreferrer"
      data-line-cta={placement}
      class="line-cta__badge"
      aria-label="LINEで友だち追加する"
    >
      <img
        src="https://scdn.line-apps.com/n/line_add_friends/btn/ja.png"
        alt="友だち追加"
        width="116"
        height="36"
        loading="lazy"
        decoding="async"
      />
    </a>
    {note && <p class="line-cta__note">{note}</p>}
  </div>
) : (
  <a
    href={LINE_URL}
    target="_blank"
    rel="noopener noreferrer"
    data-line-cta={placement}
    class="line-btn"
  >
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
    </svg>
    <span>{label}</span>
  </a>
)}

<style>
  .line-cta { margin-top: 1.6rem; }
  .line-cta__lead {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    margin: 0 0 0.6rem;
    color: color-mix(in srgb, currentColor 82%, transparent);
  }
  .line-cta__badge {
    display: inline-block;
    line-height: 0;
    border-radius: 4px;
    transition: opacity 0.2s ease;
  }
  .line-cta__badge:hover { opacity: 0.82; }
  .line-cta__badge img { display: block; width: 116px; height: 36px; }
  .line-cta__note {
    font-size: 0.72rem;
    margin: 0.5rem 0 0;
    color: color-mix(in srgb, currentColor 60%, transparent);
  }

  .line-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.9rem 1.6rem;
    border-radius: 999px;
    background: #06c755;
    color: #fff;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }
  .line-btn:hover { background: #05b34c; transform: translateY(-1px); }
  .line-btn svg { flex: none; }
</style>
