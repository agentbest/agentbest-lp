---
const nav = [
  { label: '求人を探す', href: '/jobs' },
  { label: '専門領域', href: '/#domains' },
  { label: '対象となる方', href: '/#audience' },
  { label: '選ばれる理由', href: '/#strengths' },
  { label: '支援の流れ', href: '/#process' },
  { label: '会社概要', href: '/#company' },
];
const specialSites = {
  '求職者の方へ': [
    { label: 'PM特化 転職（PjM / PdM）', href: 'https://pm.agent-best.net/' },
    { label: 'エンジニア→コンサル転職', href: 'https://eng.agent-best.net/' },
    { label: '学生キャリア支援', href: 'https://student.agent-best.net/' },
  ],
  '採用ご担当者の方へ': [
    { label: 'OfferBox運用代行', href: 'https://scoutdaikou-offerbox.agent-best.net/' },
    { label: '長期インターン採用代行', href: 'https://infra.agent-best.net/' },
  ],
};
---
<header class="site-header">
  <div class="wrap header-inner">
    <a href="/" class="brand" aria-label="株式会社エージェントベスト">
      <span class="brand-mark" aria-hidden="true"></span>
      <span class="brand-name">AGENT&nbsp;BEST</span>
    </a>
    <nav class="nav" aria-label="メインナビゲーション">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      <div class="nav-dd">
        <button type="button" class="nav-dd-trigger" aria-haspopup="true">特化サイト<span class="dd-caret" aria-hidden="true">▾</span></button>
        <div class="nav-dd-menu">
          {Object.entries(specialSites).map(([group, items]) => (
            <div class="dd-group">
              <p class="dd-group-title">{group}</p>
              {items.map((it) => <a class="dd-link" href={it.href} target="_blank" rel="noopener">{it.label}</a>)}
            </div>
          ))}
        </div>
      </div>
    </nav>
    <div class="header-actions">
      <a href="/contact" class="header-sub-link">採用ご担当者さまはこちら</a>
      <a href="https://calendly.com/r_matsuoka" target="_blank" rel="noopener" class="btn header-cta">
        ご相談はこちら
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</header>
<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: saturate(140%) blur(10px);
    border-bottom: 1px solid var(--hairline);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65em;
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.16em;
    font-size: 0.98rem;
  }
  .brand-mark {
    width: 12px;
    height: 12px;
    border: 1.5px solid var(--teal);
    position: relative;
  }
  .brand-mark::after {
    content: "";
    position: absolute;
    inset: 3px;
    background: var(--teal);
  }
  .nav {
    display: flex;
    align-items: center;
    gap: clamp(16px, 2.4vw, 34px);
    font-size: 0.86rem;
    font-weight: 500;
    color: var(--slate);
  }
  .nav > a {
    position: relative;
    padding-block: 4px;
    transition: color .2s ease;
  }
  .nav > a::after {
    content: "";
    position: absolute;
    left: 0; bottom: 0;
    width: 0; height: 1px;
    background: var(--teal);
    transition: width .25s ease;
  }
  .nav > a:hover { color: var(--ink); }
  .nav > a:hover::after { width: 100%; }

  /* 特化サイト ドロップダウン */
  .nav-dd { position: relative; }
  .nav-dd-trigger {
    font: inherit;
    color: var(--slate);
    background: none;
    border: 0;
    cursor: pointer;
    padding-block: 4px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    transition: color .2s ease;
  }
  .nav-dd-trigger .dd-caret { font-size: 0.7em; transition: transform .2s ease; }
  .nav-dd:hover .nav-dd-trigger,
  .nav-dd:focus-within .nav-dd-trigger { color: var(--ink); }
  .nav-dd:hover .dd-caret,
  .nav-dd:focus-within .dd-caret { transform: rotate(180deg); }
  /* ホバーの隙間を埋める */
  .nav-dd::after {
    content: "";
    position: absolute;
    top: 100%; left: 0; right: 0;
    height: 14px;
  }
  .nav-dd-menu {
    position: absolute;
    top: calc(100% + 14px);
    right: 0;
    min-width: 258px;
    background: var(--paper);
    border: 1px solid var(--hairline);
    border-radius: 14px;
    box-shadow: 0 18px 44px -18px rgba(20, 30, 40, 0.32);
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity .18s ease, transform .18s ease, visibility .18s;
    z-index: 60;
  }
  .nav-dd:hover .nav-dd-menu,
  .nav-dd:focus-within .nav-dd-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .dd-group { display: flex; flex-direction: column; }
  .dd-group + .dd-group { border-top: 1px solid var(--hairline); padding-top: 12px; }
  .dd-group-title {
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--slate-mute);
    font-weight: 700;
    margin: 0 0 6px;
    padding: 0 10px;
  }
  .dd-link {
    display: block;
    padding: 8px 10px;
    border-radius: 9px;
    font-size: 0.84rem;
    color: var(--slate);
    white-space: nowrap;
    transition: background .15s ease, color .15s ease;
  }
  .dd-link::after { display: none; }
  .dd-link:hover {
    background: color-mix(in srgb, var(--teal) 10%, transparent);
    color: var(--ink);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: clamp(12px, 1.6vw, 22px);
  }
  .header-sub-link {
    font-size: 0.74rem;
    color: var(--slate-mute);
    letter-spacing: 0.02em;
    white-space: nowrap;
    transition: color .2s ease;
    border-bottom: 1px solid transparent;
    padding-bottom: 1px;
  }
  .header-sub-link:hover { color: var(--teal); border-bottom-color: var(--teal); }
  .header-cta {
    padding: 0.6em 1.2em;
    font-size: 0.82rem;
  }
  @media (max-width: 880px) {
    .nav { display: none; }
  }
  @media (max-width: 600px) {
    .header-sub-link { display: none; }
  }
  @media (max-width: 520px) {
    .header-cta .arrow { display: none; }
    .header-cta { padding: 0.6em 1em; }
  }
</style>
