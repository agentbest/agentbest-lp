---
const nav = [
  { label: '専門領域', href: '/#domains' },
  { label: '対象となる方', href: '/#audience' },
  { label: '選ばれる理由', href: '/#strengths' },
  { label: '支援の流れ', href: '/#process' },
  { label: '会社情報', href: '/company/' },
];
/* 求職者向けの特設LPはヘッダーから外し、フッター（FooterSites.astro）に集約した。 */
const jobSites = [
  { label: '中途採用の求人', note: 'キャリア採用', href: 'https://jobs.agent-best.net/' },
  { label: '新卒・インターンの求人', note: '就活・長期インターン', href: 'https://shinsotsu.agent-best.net/' },
];
/* メディアはキャリアメディアと転職事例集の2本立てなのでドロップダウンにしている。 */
const mediaSites = [
  { label: 'キャリアメディア', note: '転職・選考のノウハウ記事', href: '/media/' },
  { label: '転職事例集', note: '領域別のモデルケース', href: '/cases/' },
];
const employerSites = [
  { label: 'スカウト代行', href: 'https://scout.agent-best.net/' },
  { label: 'OfferBox運用代行', href: 'https://scoutdaikou-offerbox.agent-best.net/' },
  { label: 'Green運用代行', href: 'https://green.agent-best.net/' },
  { label: '長期インターン採用（Infra）', href: 'https://infra.agent-best.net/' },
];
---
<header class="site-header">
  <div class="wrap header-inner">
    <a href="/" class="brand" aria-label="株式会社エージェントベスト">
      <img class="brand-logo" src="/logo.png" alt="エージェントベスト" width="508" height="120" />
    </a>
    <nav class="nav" aria-label="メインナビゲーション">
      <div class="nav-dd">
        <button type="button" class="nav-dd-trigger" aria-haspopup="true">求人を探す<span class="dd-caret" aria-hidden="true">▾</span></button>
        <div class="nav-dd-menu nav-dd-menu-left">
          <div class="dd-group">
            {jobSites.map((it) => (
              <a class="dd-link dd-link-2line" href={it.href} target="_blank" rel="noopener">
                <span class="dd-link-label">{it.label}</span>
                <span class="dd-link-note">{it.note}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
      <div class="nav-dd">
        <button type="button" class="nav-dd-trigger" aria-haspopup="true">メディア<span class="dd-caret" aria-hidden="true">▾</span></button>
        <div class="nav-dd-menu nav-dd-menu-left">
          <div class="dd-group">
            {mediaSites.map((it) => (
              <a class="dd-link dd-link-2line" href={it.href}>
                <span class="dd-link-label">{it.label}</span>
                <span class="dd-link-note">{it.note}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <div class="header-actions">
      <div class="nav-dd sub-dd">
        <a href="/contact/" class="header-sub-link nav-dd-trigger" aria-haspopup="true">採用ご担当者さまはこちら<span class="dd-caret" aria-hidden="true">▾</span></a>
        <div class="nav-dd-menu">
          <div class="dd-group">
            <p class="dd-group-title">採用支援サービス</p>
            {employerSites.map((it) => <a class="dd-link" href={it.href} target="_blank" rel="noopener">{it.label}</a>)}
            <a class="dd-link dd-link-contact" href="/contact/">採用のご相談・お問い合わせ →</a>
          </div>
        </div>
      </div>
      <a href="/consultation/" class="btn header-cta">
        ご相談はこちら
        <span class="arrow" aria-hidden="true">→</span>
      </a>
      <button
        type="button"
        class="nav-toggle"
        id="navToggle"
        aria-label="メニューを開く"
        aria-expanded="false"
        aria-controls="mobileNav"
      >
        <span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>
      </button>
    </div>
  </div>

  <div class="mobile-nav" id="mobileNav">
    <div class="wrap mobile-nav-inner">
      <nav class="mnav" aria-label="モバイルメニュー">
        {nav.map((item) => <a class="mnav-link" href={item.href}>{item.label}</a>)}
      </nav>
      <p class="mnav-heading">メディア</p>
      {mediaSites.map((it) => (
        <a class="mgroup-link" href={it.href}>{it.label}</a>
      ))}
      <p class="mnav-heading">求人を探す</p>
      {jobSites.map((it) => (
        <a class="mgroup-link" href={it.href} target="_blank" rel="noopener">{it.label}</a>
      ))}
      <p class="mnav-heading">採用ご担当者の方へ</p>
      {employerSites.map((it) => (
        <a class="mgroup-link" href={it.href} target="_blank" rel="noopener">{it.label}</a>
      ))}
      <a class="mgroup-link" href="/contact/">採用のご相談・お問い合わせ</a>
      <div class="mobile-cta">
        <a href="/consultation/" class="btn mobile-cta-main">
          ご相談はこちら
          <span class="arrow" aria-hidden="true">→</span>
        </a>
        <a href="/contact/" class="mobile-cta-sub">採用ご担当者さまはこちら</a>
      </div>
    </div>
  </div>
</header>
<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: saturate(140%) blur(10px);
    border-bottom: 1px solid var(--hairline);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    /* ナビと右側のリンクが詰まって見えないよう最低限の間隔を確保する */
    gap: 18px;
    height: 72px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }
  /* ロゴは横1段（マーク＋エージェントベスト＋AGENT BEST）の画像。
     高さだけ指定し、幅はアスペクト比に任せる。 */
  .brand-logo {
    display: block;
    height: 38px;
    width: auto;
  }
  .nav {
    display: flex;
    align-items: center;
    /* メディアを足して項目が7つになったぶん、字間と文字サイズを詰めて1行に収めている */
    gap: clamp(10px, 1.3vw, 18px);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--slate);
  }
  .nav > a {
    position: relative;
    padding-block: 4px;
    /* 幅が足りないときに「求人を／探す」と語中で折り返してしまうのを防ぐ */
    white-space: nowrap;
    transition: color .2s ease;
  }
  .nav > a::after {
    content: "";
    position: absolute;
    left: 0; bottom: 0;
    width: 0; height: 1px;
    background: var(--teal);
    transition: width .25s ease;
  }
  .nav > a:hover { color: var(--ink); }
  .nav > a:hover::after { width: 100%; }

  /* 特化サイト ドロップダウン */
  .nav-dd { position: relative; }
  .nav-dd-trigger {
    white-space: nowrap;
    font: inherit;
    color: var(--slate);
    background: none;
    border: 0;
    cursor: pointer;
    padding-block: 4px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    transition: color .2s ease;
  }
  .nav-dd-trigger .dd-caret { font-size: 0.7em; transition: transform .2s ease; }
  .nav-dd:hover .nav-dd-trigger,
  .nav-dd:focus-within .nav-dd-trigger { color: var(--ink); }
  .nav-dd:hover .dd-caret,
  .nav-dd:focus-within .dd-caret { transform: rotate(180deg); }
  /* ホバーの隙間を埋める */
  .nav-dd::after {
    content: "";
    position: absolute;
    top: 100%; left: 0; right: 0;
    height: 14px;
  }
  .nav-dd-menu {
    position: absolute;
    top: calc(100% + 14px);
    right: 0;
    min-width: 258px;
    background: var(--paper);
    border: 1px solid var(--hairline);
    border-radius: 14px;
    box-shadow: 0 18px 44px -18px rgba(20, 30, 40, 0.32);
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity .18s ease, transform .18s ease, visibility .18s;
    z-index: 60;
  }
  .nav-dd:hover .nav-dd-menu,
  .nav-dd:focus-within .nav-dd-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .dd-group { display: flex; flex-direction: column; }
  .dd-group + .dd-group { border-top: 1px solid var(--hairline); padding-top: 12px; }
  .dd-group-title {
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--slate-mute);
    font-weight: 700;
    margin: 0 0 6px;
    padding: 0 10px;
  }
  .dd-link {
    display: block;
    padding: 8px 10px;
    border-radius: 9px;
    font-size: 0.84rem;
    color: var(--slate);
    white-space: nowrap;
    transition: background .15s ease, color .15s ease;
  }
  .dd-link::after { display: none; }
  .dd-link:hover {
    background: color-mix(in srgb, var(--teal) 10%, transparent);
    color: var(--ink);
  }
  /* 左端のメニューは左揃え（右揃えだと画面外にはみ出す） */
  .nav-dd-menu-left { left: 0; right: auto; }
  .dd-link-2line { display: flex; flex-direction: column; gap: 2px; padding-block: 9px; }
  .dd-link-note {
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: var(--slate-mute);
  }
  .dd-link-contact {
    margin-top: 6px;
    padding-top: 12px;
    border-top: 1px solid var(--hairline);
    border-radius: 0;
    color: var(--teal);
    font-weight: 600;
  }
  .dd-link-contact:hover { background: none; color: var(--teal); }

  /* 「採用ご担当者さまはこちら」のドロップダウン */
  .sub-dd { display: inline-flex; }
  .sub-dd .nav-dd-menu { min-width: 236px; }

  .header-actions {
    display: flex;
    align-items: center;
    gap: clamp(12px, 1.6vw, 22px);
  }
  /* flexの縮小でボタンが1文字幅まで潰れ、文字が縦積みになっていた */
  .header-cta { white-space: nowrap; flex-shrink: 0; }
  .header-sub-link { white-space: nowrap; }
  .header-sub-link {
    font-size: 0.74rem;
    color: var(--slate-mute);
    letter-spacing: 0.02em;
    white-space: nowrap;
    transition: color .2s ease;
    border-bottom: 1px solid transparent;
    padding-bottom: 1px;
  }
  .header-sub-link:hover { color: var(--teal); border-bottom-color: var(--teal); }
  .header-cta {
    padding: 0.6em 1.2em;
    font-size: 0.82rem;
  }

  /* --- ハンバーガーボタン（モバイルのみ） --- */
  .nav-toggle {
    display: none;
    width: 42px;
    height: 42px;
    margin-right: -8px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    color: var(--ink);
  }
  .nav-toggle .bars {
    display: block;
    position: relative;
    width: 22px;
    height: 14px;
    margin-inline: auto;
  }
  .nav-toggle .bars i {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: currentColor;
    border-radius: 2px;
    transition: transform .25s ease, opacity .2s ease;
  }
  .nav-toggle .bars i:nth-child(1) { top: 0; }
  .nav-toggle .bars i:nth-child(2) { top: 50%; transform: translateY(-50%); }
  .nav-toggle .bars i:nth-child(3) { bottom: 0; }
  .site-header.is-open .bars i:nth-child(1) { transform: translateY(6.25px) rotate(45deg); }
  .site-header.is-open .bars i:nth-child(2) { opacity: 0; }
  .site-header.is-open .bars i:nth-child(3) { transform: translateY(-6.25px) rotate(-45deg); }

  /* --- モバイルメニュー本体 --- */
  .mobile-nav { display: none; }

  @media (max-width: 1240px) {
    .nav { display: none; }
    .nav-toggle { display: block; }

    .mobile-nav {
      display: block;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      max-height: calc(100dvh - 64px);
      overflow-y: auto;
      overscroll-behavior: contain;
      background: var(--paper);
      border-bottom: 1px solid var(--hairline);
      box-shadow: 0 24px 40px -24px rgba(20, 30, 40, 0.28);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-10px);
      transition: opacity .22s ease, transform .22s ease, visibility .22s;
    }
    .site-header.is-open .mobile-nav {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }
    .mobile-nav-inner {
      padding-block: 8px 28px;
    }

    .mnav { display: block; }
    .mnav-link {
      display: block;
      padding: 15px 2px;
      font-size: 1rem;
      font-weight: 500;
      color: var(--ink);
      border-bottom: 1px solid var(--hairline);
    }

    .mnav-heading {
      margin: 24px 0 6px;
      padding: 0 2px;
      font-size: 0.66rem;
      font-weight: 700;
      letter-spacing: 0.16em;
      color: var(--slate-mute);
    }
    .mgroup-link {
      display: block;
      padding: 11px 14px;
      font-size: 0.88rem;
      color: var(--slate);
      border-radius: 8px;
      background: color-mix(in srgb, var(--paper-deep) 70%, transparent);
      margin-bottom: 6px;
    }

    .mobile-cta {
      margin-top: 26px;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 14px;
      text-align: center;
    }
    .mobile-cta-main { justify-content: center; }
    .mobile-cta-sub {
      font-size: 0.82rem;
      color: var(--slate);
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .header-inner { height: 64px; }
  }

  @media (max-width: 600px) {
    .sub-dd { display: none; }
  }
  @media (max-width: 520px) {
    .header-cta .arrow { display: none; }
    .header-cta { padding: 0.6em 1em; }
  }
  @media (max-width: 400px) {
    .brand { font-size: 0.86rem; letter-spacing: 0.12em; }
    .header-cta { font-size: 0.78rem; padding: 0.6em 0.9em; }
    .header-actions { gap: 10px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-nav, .nav-toggle .bars i { transition: none; }
  }
</style>

<style is:global>
  body.nav-open { overflow: hidden; }
</style>

<script>
  const header = document.querySelector('.site-header');
  const toggle = document.getElementById('navToggle');
  const panel = document.getElementById('mobileNav');

  if (header && toggle && panel) {
    const setOpen = (open) => {
      header.classList.toggle('is-open', open);
      document.body.classList.toggle('nav-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'メニューを閉じる' : 'メニューを開く');
    };

    toggle.addEventListener('click', () => {
      setOpen(!header.classList.contains('is-open'));
    });

    // リンクを踏んだら閉じる（同一ページ内アンカー対策）
    panel.addEventListener('click', (e) => {
      if (e.target instanceof Element && e.target.closest('a')) setOpen(false);
    });

    // メニュー外タップで閉じる
    document.addEventListener('click', (e) => {
      if (!header.classList.contains('is-open')) return;
      if (e.target instanceof Node && !header.contains(e.target)) setOpen(false);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });

    // PC幅に戻したら状態をリセット
    const mq = window.matchMedia('(min-width: 881px)');
    mq.addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>
