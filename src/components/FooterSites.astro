---
// 求人サイトはページ下部の「求人を探す」に集約する。
import LineCta from './LineCta.astro';
import { jobsUrl, skillUrl, SHINSOTSU_URL } from '../lib/jobsLink';

const jobSites = [
  { label: '中途・ハイクラスの求人', note: '中途の全求人・ハイクラス含む', href: jobsUrl({ medium: 'footer' }) },
  { label: '手に職をつける求人', note: '中途・未経験歓迎／資格取得支援', href: skillUrl({ medium: 'footer' }) },
  { label: '新卒・インターンの求人', note: '就活・長期インターン', href: `${SHINSOTSU_URL}?utm_source=corporate&utm_medium=footer` },
  { label: 'フリーランス案件', note: 'エンジニア・コンサルの業務委託', href: 'https://freelanceanken.com/?utm_source=corporate&utm_medium=footer' },
  { label: 'PM転職', note: 'PM・プロジェクトマネジメントの求人', href: 'https://jobs.agent-best.net/specialties/pm/' },
  { label: 'M&A転職', note: 'M&A業界の求人検索', href: 'https://www.matenshoku.com/' },
  { label: 'エンジニア転職', note: 'エンジニアの転職・求人一覧', href: 'https://jobs.agent-best.net/jobs/engineer/' },
  { label: 'IoT・組込みエンジニア', note: 'IoT・組込み分野の求人検索', href: 'https://www.kumikomitenshoku.com/' },
];

/* メディアはヘッダーから外した（2026-09-06）。フッターだけの導線なので全ページ共通のここに置く。 */
const mediaSites = [
  { label: '転職メディア', note: '職種・業界・企業ごとの転職情報', href: '/media/' },
  { label: '転職事例集', note: '「どこから、どこへ」で整理したモデルケース', href: '/cases/' },
];

const employerSites = {
  '採用ご担当者の方へ': [
    { label: '人材紹介（求人のご依頼）・サービス一覧', href: '/business/', internal: true },
    { label: 'スカウト代行', href: 'https://scout.agent-best.net/' },
    { label: 'OfferBox運用代行', href: 'https://offerboxapp.com/', child: true },
    { label: 'Green運用代行', href: 'https://green.agent-best.net/', child: true },
    { label: '求人広告代理店（求人媒体の比較・申込）', href: 'https://saiyo-media.agent-best.net/' },
    { label: '長期インターン採用（Infra）', href: 'https://infra.agent-best.net/', child: true },
    { label: '求人媒体の運用ノウハウ（記事）', href: 'https://saiyo-media.agent-best.net/media/' },
  ],
};
---

<nav id="jobs" class="footer-jobs" aria-label="求人を探す">
  <p class="footer-sites-title">求人を探す</p>
  <ul class="fj-list">
    {jobSites.map((it) => (
      <li>
        <a href={it.href} target="_blank" rel="noopener">
          <span class="fj-label">{it.label}</span>
          <span class="fj-note">{it.note}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<nav class="footer-jobs" aria-label="メディア">
  <p class="footer-sites-title">メディア</p>
  <ul class="fj-list">
    {mediaSites.map((it) => (
      <li>
        <a href={it.href}>
          <span class="fj-label">{it.label}</span>
          <span class="fj-note">{it.note}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<nav class="footer-sites" aria-label="採用支援サービス">
  <p class="footer-sites-title">採用支援サービス</p>
  <div class="footer-sites-cols">
    {Object.entries(employerSites).map(([group, items]) => (
      <div class="fs-group">
        <p class="fs-group-title">{group}</p>
        <ul>
          {items.map((it) => (
            <li class:list={[{ 'fs-child': it.child }]}><a href={it.href} {...(it.internal ? {} : { target: '_blank', rel: 'noopener' })}>{it.label}</a></li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</nav>

<div class="footer-line">
  <LineCta
    placement="corporate-footer"
    label="LINEで相談する"
    note="求人紹介・キャリア相談・選考対策まで、トークでそのままやり取りできます。"
  />
</div>

<style>
  #jobs { scroll-margin-top: 96px; }
  .footer-jobs { grid-column: 1 / -1; }
  .fj-list {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: 10px; grid-template-columns: repeat(1, 1fr);
  }
  @media (min-width: 700px) { .fj-list { grid-template-columns: repeat(2, 1fr); } }
  .fj-list a {
    display: block;
    padding: 14px 16px;
    border: 1px solid var(--hairline-on-dark);
    transition: border-color .3s ease, background .3s ease;
  }
  .fj-list a:hover { border-color: rgba(255,255,255,0.45); background: rgba(255,255,255,0.04); }
  .fj-label { display: block; font-size: 0.9rem; font-weight: 700; color: var(--paper); }
  .fj-note { display: block; font-size: 0.76rem; margin-top: 4px; opacity: 0.62; }

  .footer-sites { grid-column: 1 / -1; }
  .fs-group li.fs-child { padding-left: 1.1em; }
  .fs-child::before { content: '└'; margin-right: 0.4em; opacity: 0.45; }
  .footer-line { grid-column: 1 / -1; }
  .footer-sites-title {
    font-size: 0.84rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    margin: 0 0 0.9rem;
    color: var(--paper);
  }
  .footer-sites-cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr));
    gap: 1.4rem 2.4rem;
    max-width: 760px;
  }
  .fs-group-title {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--slate-mute);
    margin: 0 0 0.5rem;
  }
  .fs-group ul { list-style: none; margin: 0; padding: 0; }
  .fs-group li { padding: 0.24rem 0; }
  .fs-group a {
    font-size: 0.8rem;
    color: color-mix(in srgb, var(--paper) 72%, transparent);
    transition: color .2s ease;
  }
  .fs-group a:hover { color: var(--paper); }
</style>
