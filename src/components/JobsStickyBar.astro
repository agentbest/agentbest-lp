---
/* スマホで記事を読んでいる間だけ、画面下に「〇〇の求人一覧を見る」を出す追従バー（2026-11-18）。
   記事から求人サイトへのクリック率が1.5%で、求人カードが記事の末尾にしか無く読み切った人にしか見えていなかったため。
   - 幅767px以下だけ。本文を25%以上読んだら出し、末尾の転職ボックス（.tenshoku-box）が見えている間は引っ込める
   - ✕で閉じたらそのタブの間は出さない（sessionStorage）
   - 出ている間は相談チャットのボタン（.abchat）をバーの上へ逃がす（body.has-jobs-bar）
   クリックは Layout.astro の jobs_click（placement=media-article-sticky）で数える。 */
interface Props {
  /** 転職ボックスの1本目と同じリンク先（企業ページ or 職種一覧 or 求人トップ） */
  href: string;
  label: string;
  campaign: string;
}
const { href, label, campaign } = Astro.props;
// utm_medium を sticky に差し替える（転職ボックスのリンクと区別するため）
const stickyHref = href.replace(/utm_medium=[^&]*/, 'utm_medium=article-sticky');
---

<div class="jobs-bar" data-jobs-bar hidden>
  <a class="jobs-bar__link" href={stickyHref} target="_blank" rel="noopener" data-jobs-cta="media-article-sticky" data-campaign={campaign}>
    <span class="jobs-bar__label">{label}</span>
    <span class="jobs-bar__arrow" aria-hidden="true">→</span>
  </a>
  <button type="button" class="jobs-bar__close" aria-label="閉じる" data-jobs-bar-close>×</button>
</div>

<script is:inline>
  (function () {
    var bar = document.querySelector('[data-jobs-bar]');
    if (!bar || !window.matchMedia) return;
    var KEY = 'ab-jobs-bar-off';
    try { if (sessionStorage.getItem(KEY)) return; } catch (e) {}
    var mq = window.matchMedia('(max-width: 767px)');
    var art = document.querySelector('.media-article');
    var box = document.querySelector('.tenshoku-box');
    var boxVisible = false, off = false, ticking = false;
    var set = function (show) {
      bar.hidden = !show;
      document.body.classList.toggle('has-jobs-bar', show);
    };
    var update = function () {
      ticking = false;
      if (off || !mq.matches || !art) return set(false);
      var r = art.getBoundingClientRect();
      var read = (window.innerHeight - r.top) / Math.max(1, r.height);
      set(read > 0.25 && !boxVisible);
    };
    var onScroll = function () { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
    if (box && 'IntersectionObserver' in window) {
      new IntersectionObserver(function (es) { boxVisible = es[0].isIntersecting; update(); }).observe(box);
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    bar.querySelector('[data-jobs-bar-close]').addEventListener('click', function () {
      off = true; set(false);
      try { sessionStorage.setItem(KEY, '1'); } catch (e) {}
      if (window.gtag) window.gtag('event', 'jobs_bar_close', { page_path: location.pathname });
    });
    update();
  })();
</script>

<style is:global>
  .jobs-bar {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 890;
    display: flex; align-items: stretch; gap: 0;
    padding: 8px 8px calc(8px + env(safe-area-inset-bottom));
    background: rgba(255, 255, 255, .97); border-top: 1px solid #d8dee6;
    box-shadow: 0 -4px 16px rgba(11, 42, 74, .08);
  }
  .jobs-bar[hidden] { display: none; }
  .jobs-bar__link {
    flex: 1; min-width: 0; display: flex; align-items: center; justify-content: center; gap: 8px;
    padding: 12px 14px; border-radius: 8px; background: #0b2a4a; color: #fff;
    font-size: 14px; font-weight: 700; text-decoration: none; line-height: 1.3;
  }
  .jobs-bar__label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .jobs-bar__close {
    flex: none; width: 40px; margin-left: 4px; border: 0; background: none;
    color: #5b6573; font-size: 22px; line-height: 1; cursor: pointer;
  }
  /* バーが出ている間は相談チャットのボタンをバーの上へ */
  body.has-jobs-bar .abchat { bottom: calc(76px + env(safe-area-inset-bottom)); }
  @media (min-width: 768px) { .jobs-bar { display: none !important; } }
</style>
