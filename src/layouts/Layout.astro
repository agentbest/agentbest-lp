---
import '../styles/global.css';
export interface Props {
  title?: string;
  description?: string;
  /** true にするとそのページだけ検索結果から除外する（重複ページ用） */
  noindex?: boolean;
  /** SNSでシェアされたときのカード画像。記事はアイキャッチ（1200x630）をそのまま渡す */
  image?: string;
}
const {
  title = '株式会社エージェントベスト｜20代・30代ハイクラスのための転職エージェント',
  description = 'IT・スタートアップ・M&A・コンサル領域に特化。20代・30代でキャリアを積み始めたハイクラス層へ、領域を絞った確かな転職提案を。10年先から逆算する、戦略的な一社をご提案します。',
  noindex = false,
  image,
} = Astro.props;

// canonical URL。sitemap-0.xml の出力（末尾スラッシュあり）と表記を揃える
const canonicalPath = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonicalURL = new URL(canonicalPath, Astro.site);

// og:image は絶対URLでないと各社のクローラが拾えない
const ogImage = image ? new URL(image, Astro.site).href : undefined;
---
<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="株式会社エージェントベスト" />
    {ogImage && (
      <>
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta name="twitter:image" content={ogImage} />
      </>
    )}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@400;500;600;700;800&family=Noto+Sans+JP:wght@300;400;500;700&display=swap"
      rel="stylesheet"
    />
    <!-- Google Analytics 4 -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-1XXMP8Y1B4"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-1XXMP8Y1B4');
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>