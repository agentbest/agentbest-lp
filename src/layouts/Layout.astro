---
import '../styles/global.css';
export interface Props {
  title?: string;
  description?: string;
  /** true にするとそのページだけ検索結果から除外する（重複ページ用） */
  noindex?: boolean;
  /** SNSでシェアされたときのカード画像。記事はアイキャッチ（1200x630）をそのまま渡す */
  image?: string;
}
const {
  title = '株式会社エージェントベスト｜20代・30代ハイクラスのための転職エージェント',
  description = 'IT・スタートアップ・M&A・コンサル領域に特化。20代・30代でキャリアを積み始めたハイクラス層へ、領域を絞った確かな転職提案を。10年先から逆算する、戦略的な一社をご提案します。',
  noindex = false,
  image,
} = Astro.props;

// canonical URL。sitemap-0.xml の出力（末尾スラッシュあり）と表記を揃える
const canonicalPath = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonicalURL = new URL(canonicalPath, Astro.site);

// og:image は絶対URLでないと各社のクローラが拾えない
const ogImage = image ? new URL(image, Astro.site).href : undefined;
---
<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="株式会社エージェントベスト" />
    {ogImage && (
      <>
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta name="twitter:image" content={ogImage} />
      </>
    )}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@400;500;600;700;800&family=Noto+Sans+JP:wght@300;400;500;700&display=swap"
      rel="stylesheet"
    />
    <!-- Google Analytics 4 -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-1XXMP8Y1B4"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-1XXMP8Y1B4');
    </script>
  </head>
  <body>
    <slot />
    <!-- LINE友だち追加のクリックをGA4に送る。LINE側では流入元が分からないので、
         どのページのボタンから登録されたかはこのイベントでしか追えない。 -->
    <script is:inline>
      document.addEventListener('click', function (e) {
        var t = e.target;
        if (!t || !t.closest) return;

        var line = t.closest('[data-line-cta]');
        if (line && typeof window.gtag === 'function') {
          window.gtag('event', 'line_add_friend', {
            placement: line.getAttribute('data-line-cta'),
            page_path: location.pathname,
          });
        }

        /* 求人サイトは別ドメインなので、GA4では別セッション扱いになり、
           どのページから飛んだかがコーポレート側で分からなくなる。
           リンクのutmとは別に、クリック自体をこちら側でも数える。 */
        var job = t.closest('a[href*="jobs.agent-best.net"], a[href*="shinsotsu.agent-best.net"]');
        if (job && typeof window.gtag === 'function') {
          window.gtag('event', 'jobs_click', {
            placement: job.getAttribute('data-jobs-cta') || 'link',
            page_path: location.pathname,
          });
        }
      });
    </script>
  </body>
</html>